        padding: 10px;
        outline: none;
    }

    .ai-chat-input button {
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        background: #22c55e;
        color: white;
        font-weight: 800;
    }

    .ai-status {
        padding: 8px 10px;
        font-size: 12px;
        color: #334155;
        background: #eef2ff;
        border-top: 1px solid rgba(0,0,0,0.06);
    }
</style>
