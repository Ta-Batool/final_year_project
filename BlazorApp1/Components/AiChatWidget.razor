@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json

@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IJSRuntime JS

<div class="ai-chat-container">
    @if (isOpen)
    {
        <div class="ai-chat-window">
            <div class="ai-chat-header">
                <span>@HeaderTitle</span>

                <div class="ai-chat-header-actions">
                    <button class="mini-btn" title="Clear chat" @onclick="ClearChat">🧹</button>
                    <button class="mini-btn" title="Close" @onclick="Toggle">×</button>
                </div>
            </div>

            <div class="ai-chat-messages" @ref="messagesDiv">
                @foreach (var msg in messages)
                {
                    <div class="msg @(msg.IsUser ? "user" : "bot")">
                        @msg.Text
                    </div>
                }
            </div>

            <div class="ai-chat-input">
                <input @bind="currentInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="Type your question..." />

                <button @onclick="Send" disabled="@isSending">
                    @(isSending ? "..." : "Send")
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="ai-status">@statusMessage</div>
            }
        </div>
    }

    <button class="ai-chat-bubble" @onclick="Toggle" title="Chat with assistant">
        💬
    </button>
</div>

@code {
    // ✅ Keep your existing param so you don't break pages/layouts
    // It's now only used as fallback if role detection fails.
    [Parameter] public bool IsDoctor { get; set; } = false;

    // ✅ Add admin support (use in AdminLayout later if you want)
    [Parameter] public bool IsAdmin { get; set; } = false;

    private bool isOpen;
    private bool detectedDoctor = false;
    private bool roleDetected = false;

    private bool isSending = false;
    private string statusMessage = "";

    private string currentInput = string.Empty;
    private List<ChatMessage> messages = new();

    private ElementReference messagesDiv;

    private class ChatMessage
    {
        public bool IsUser { get; set; }
        public string Text { get; set; } = string.Empty;
    }

    private string EffectiveRole
        => IsAdmin ? "admin"
           : (roleDetected ? (detectedDoctor ? "doctor" : "patient")
                           : (IsDoctor ? "doctor" : "patient"));

    private string HeaderTitle
        => EffectiveRole == "admin" ? "Admin AI Tools"
           : EffectiveRole == "doctor" ? "Doctor AI Assistant"
           : "Health AI Assistant";

    private string StorageKey => $"ai_chat_{EffectiveRole}";

    protected override async Task OnInitializedAsync()
    {
        // 1) detect role (patient/doctor) from DB using email
        await DetectRoleAsync();

        // 2) load memory from localStorage
        await LoadMemoryAsync();
    }

    private async Task DetectRoleAsync()
    {
        if (IsAdmin)
        {
            roleDetected = true;
            detectedDoctor = false;
            return;
        }

        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (!(user.Identity?.IsAuthenticated ?? false))
                return;

            var email =
                user.FindFirst(ClaimTypes.Email)?.Value ??
                user.FindFirst("email")?.Value;

            email = email?.Trim().ToLowerInvariant();

            if (string.IsNullOrWhiteSpace(email))
                return;

            var client = await CService.GetClientByEmailAsync(email);
            var role = (client?.Role ?? "").Trim().ToLowerInvariant();

            detectedDoctor = role == "doctor";
            roleDetected = true;
        }
        catch
        {
            // keep fallback
        }
    }

    private void Toggle()
    {
        isOpen = !isOpen;

        if (isOpen)
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(50);
                await ScrollToBottomAsync();
            });
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(currentInput)) return;

        var text = currentInput.Trim();
        currentInput = string.Empty;

        messages.Add(new ChatMessage { IsUser = true, Text = text });
        await SaveMemoryAsync();
        await ScrollToBottomAsync();

        isSending = true;
        statusMessage = "";

        try
        {
            // ✅ Send context (last 10 messages) + role prompt
            var history = messages
                .TakeLast(10)
                .Select(m => new { isUser = m.IsUser, text = m.Text })
                .ToList();

            var payload = new
            {
                role = EffectiveRole,
                message = text,
                systemPrompt = BuildSystemPrompt(EffectiveRole),
                history = history
            };

            var response = await Http.PostAsJsonAsync("api/aichat/chat", payload);

            if (!response.IsSuccessStatusCode)
            {
                messages.Add(new ChatMessage
                {
                    IsUser = false,
                    Text = "Sorry, I couldn't reach the AI assistant right now."
                });
                await SaveMemoryAsync();
                await ScrollToBottomAsync();
                return;
            }

            var data = await response.Content.ReadFromJsonAsync<AiChatResponse>();

            messages.Add(new ChatMessage
            {
                IsUser = false,
                Text = data?.Reply ?? "(No response received.)"
            });

            await SaveMemoryAsync();
            await ScrollToBottomAsync();
        }
        catch
        {
            messages.Add(new ChatMessage
            {
                IsUser = false,
                Text = "An error occurred while contacting the AI assistant."
            });

            await SaveMemoryAsync();
            await ScrollToBottomAsync();
        }
        finally
        {
            isSending = false;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            _ = Send();
    }

    private string BuildSystemPrompt(string role)
    {
        if (role == "admin")
        {
            return
                "You are an Admin AI assistant for a healthcare portal. " +
                "Help with reviewing doctor verification, summarizing pending cases, " +
                "drafting approval/rejection notes, and giving safe operational guidance. " +
                "Do not invent data. Ask for missing fields if needed.";
        }

        if (role == "doctor")
        {
            return
                "You are a Doctor AI assistant inside a healthcare portal. " +
                "Help with patient note drafting, appointment summaries, follow-up message drafts, " +
                "and explaining lab values in simple terms. " +
                "Never give definitive diagnosis. Always suggest consulting a licensed physician for emergencies.";
        }

        // patient
        return
            "You are a Health AI assistant for a patient. " +
            "Explain health topics in simple language, help with reminders, symptom journaling, " +
            "and questions to ask a doctor. Do not provide emergency medical advice. " +
            "If symptoms are severe, advise seeking urgent care.";
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function(){
                    const el = document.querySelector('.ai-chat-messages');
                    if(el) el.scrollTop = el.scrollHeight;
                })();
            ");
        }
        catch { }
    }

    private async Task SaveMemoryAsync()
    {
        try
        {
            var json = JsonSerializer.Serialize(messages);
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, json);
        }
        catch { }
    }

    private async Task LoadMemoryAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", StorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var loaded = JsonSerializer.Deserialize<List<ChatMessage>>(json);
                if (loaded != null) messages = loaded;
            }
        }
        catch { }
    }

    private async Task ClearChat()
    {
        messages.Clear();
        await SaveMemoryAsync();
        statusMessage = "Chat cleared.";
    }

    private class AiChatResponse
    {
        public string Reply { get; set; } = string.Empty;
    }
}

<style>
    .ai-chat-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
