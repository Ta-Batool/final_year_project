@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject BlazorApp1.Service.AdminSession Session

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand" @onclick="@(() => Go("admin/dashboard"))">
            Admin Panel
        </div>

        <nav class="menu">
            <NavLink class="menu-link" href="admin/dashboard" Match="NavLinkMatch.All"
                     ActiveClass="active">
                Dashboard
            </NavLink>

            <NavLink class="menu-link" href="admin/doctors" ActiveClass="active">
                Pending Doctors
            </NavLink>

            <NavLink class="menu-link" href="admin/patients" ActiveClass="active">
                Patients
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout" @onclick="LogoutAsync">Logout</button>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="title">Admin Portal</div>
        </header>

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    private void Go(string path)
    {
        // ✅ BaseUri-safe navigation (works under /BlazorApp1)
        var url = new Uri(new Uri(Nav.BaseUri), path).ToString();
        Nav.NavigateTo(url);
    }

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Go("admin"); // back to admin login at /admin
    }
}

<style>
.admin-shell{
    display:flex;
    min-height:100vh;
    background:#f6f7fb;
}
.sidebar{
    width:260px;
    background:#111827;
    color:white;
    display:flex;
    flex-direction:column;
    padding:18px;
}
.brand{
    font-size:18px;
    font-weight:800;
    cursor:pointer;
    padding:12px 10px;
    border-radius:10px;
    background:rgba(255,255,255,0.06);
}
.menu{
    margin-top:18px;
    display:flex;
    flex-direction:column;
    gap:8px;
}
.menu-link{
    color:#e5e7eb;
    text-decoration:none;
    padding:10px 12px;
    border-radius:10px;
    transition:all .15s ease;
    display:block;
}
.menu-link:hover{
    background:rgba(255,255,255,0.08);
}
.menu-link.active{
    background:rgba(99,102,241,0.25);
    color:white;
}
.sidebar-footer{
    margin-top:auto;
    padding-top:14px;
}
.btn-logout{
    width:100%;
    border:none;
    border-radius:10px;
    padding:10px 12px;
    background:#ef4444;
    color:white;
    font-weight:700;
    cursor:pointer;
}
.main{
    flex:1;
    display:flex;
    flex-direction:column;
}
.topbar{
    height:64px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
    background:white;
    border-bottom:1px solid #e5e7eb;
}
.title{
    font-size:16px;
    font-weight:800;
    color:#111827;
}
.content{
    padding:18px 20px;
}
</style>
