@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand" @onclick="@(()=>Nav.NavigateTo("/admin/dashboard"))">
            Admin Panel
        </div>

        <nav class="menu">
            <a class="@LinkClass("/admin/dashboard")" href="/admin/dashboard">Dashboard</a>
            <a class="@LinkClass("/admin/doctors")" href="/admin/doctors">Pending Doctors</a>
            <a class="@LinkClass("/admin/patients")" href="/admin/patients">Patients</a>
        </nav>

        <div class="sidebar-footer">
            <button class="btn-logout" @onclick="Logout">Logout</button>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="title">Admin Portal</div>
        </header>

        <section class="content">
            @Body
        </section>
    </main>
</div>

@code {
    private string LinkClass(string path)
        => Nav.Uri.Contains(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private void Logout()
    {
        // if you have an admin logout route, use it
        Nav.NavigateTo("/admin/login", true);
    }
}

<style>
.admin-shell{
    display:flex;
    min-height:100vh;
    background:#f6f7fb;
}
.sidebar{
    width:260px;
    background:#111827;
    color:white;
    display:flex;
    flex-direction:column;
    padding:18px;
}
.brand{
    font-size:18px;
    font-weight:800;
    cursor:pointer;
    padding:12px 10px;
    border-radius:10px;
    background:rgba(255,255,255,0.06);
}
.menu{
    margin-top:18px;
    display:flex;
    flex-direction:column;
    gap:8px;
}
.menu a{
    color:#e5e7eb;
    text-decoration:none;
    padding:10px 12px;
    border-radius:10px;
    transition:all .15s ease;
}
.menu a:hover{
    background:rgba(255,255,255,0.08);
}
.menu a.active{
    background:rgba(99,102,241,0.25);
    color:white;
}
.sidebar-footer{
    margin-top:auto;
    padding-top:14px;
}
.btn-logout{
    width:100%;
    border:none;
    border-radius:10px;
    padding:10px 12px;
    background:#ef4444;
    color:white;
    font-weight:700;
    cursor:pointer;
}
.main{
    flex:1;
    display:flex;
    flex-direction:column;
}
.topbar{
    height:64px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
    background:white;
    border-bottom:1px solid #e5e7eb;
}
.title{
    font-size:16px;
    font-weight:800;
    color:#111827;
}
.content{
    padding:18px 20px;
}
</style>
