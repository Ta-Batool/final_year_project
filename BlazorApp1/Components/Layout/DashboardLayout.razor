@inherits LayoutComponentBase

@using System.Security.Claims
@using Model
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ICService CService
@inject IDService DService
@inject IJSRuntime JS

<div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="profile-section">
            <img src="@GetProfileImageUrl()" alt="Profile" class="profile-pic" />
            <div class="profile-name">@displayName</div>
            <div class="profile-sub">@specializationText</div>

            <button class="primary-btn" @onclick="GoToProfile">
                <i class="fas fa-user-edit"></i> Edit Profile
            </button>
        </div>

        <nav class="sidebar-nav">
            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/dashboard")'>
                <i class="fas fa-house"></i> Dashboard
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/appointments")'>
                <i class="fas fa-calendar-check"></i> Appointments
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/patients")'>
                <i class="fas fa-users"></i> Patients
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/messages")'>
                <i class="fas fa-comments"></i> Messages
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/availability")'>
                <i class="fas fa-clock"></i> Availability
            </button>
        </nav>

        <div class="bottom-section">
            <button class="icon-btn" title="Language" @onclick="ToggleLanguageMenu">
                <i class="fas fa-language"></i>
            </button>

            @if (showLangMenu)
            {
                <div class="language-menu">
                    <button @onclick="SetEnglish">English</button>
                    <button @onclick="SetUrdu">اردو</button>
                </div>
            }

            <button class="logout-btn" @onclick="Logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </div>
    </aside>

    <!-- Main -->
    <div class="main-content">
        <header class="top-navbar">
            <div class="title">
                <div class="title-main">@headerTitle</div>
                <div class="title-sub">Doctor Panel</div>
            </div>

            <div class="top-actions">
                <button class="top-icon" title="Notifications">
                    <i class="fas fa-bell"></i>
                </button>
                <button class="top-icon" title="Settings" @onclick="GoToProfile">
                    <i class="fas fa-gear"></i>
                </button>
            </div>
        </header>

        <div class="page-body">
            @if (isLoading)
            {
                <div class="state-box">Loading doctor profile…</div>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="state-box error">@errorMessage</div>
                @Body
            }
            else
            {
                @Body
            }
        </div>
    </div>
</div>

<!-- ✅ Chatbot available on doctor dashboard too -->
<AiChatWidget />

@code {
    private string displayName = "Doctor";
    private string specializationText = "";
    private string headerTitle = "Doctor Dashboard";
    private string? clientId;
    private Doctor? doctor;
    private bool showLangMenu = false;

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = auth.User;

            if (!user.Identity?.IsAuthenticated ?? true)
                return;

            var email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
            if (string.IsNullOrWhiteSpace(email)) return;

            email = email.Trim().ToLowerInvariant();

            var client = await CService.GetClientByEmailAsync(email);
            if (client == null) return;

            clientId = client.Id;

            // ✅ FIX: Normalize role (prevents flicker & mismatch)
            var role = (client.Role ?? "").Trim().ToLowerInvariant();
            if (role != "doctor")
            {
                errorMessage = "You are not registered as a doctor.";
                return;
            }

            doctor = await DService.GetDoctorByClientIdAsync(client.Id);

            if (doctor != null)
            {
                displayName = !string.IsNullOrWhiteSpace(doctor.Name)
                    ? $"Dr. {doctor.Name}"
                    : "Doctor";

                specializationText = doctor.Specialization ?? "";
            }

            if (!string.IsNullOrEmpty(client.Id))
                await JS.InvokeVoidAsync("localStorage.setItem", "doctorId", client.Id);

            if (!string.IsNullOrWhiteSpace(doctor?.Id))
                await JS.InvokeVoidAsync("localStorage.setItem", "doctorMongoId", doctor!.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load doctor info: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetProfileImageUrl()
    {
        if (doctor != null && !string.IsNullOrWhiteSpace(doctor.ProfileImageUrl))
            return doctor.ProfileImageUrl;

        return "https://via.placeholder.com/80";
    }

    private void GoToProfile()
    {
        if (!string.IsNullOrEmpty(clientId))
            Navigation.NavigateTo($"/profile/{clientId}");
        else
            Navigation.NavigateTo("/profile");
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }

    private void ToggleLanguageMenu() => showLangMenu = !showLangMenu;

    async Task SetEnglish() => await ChangeLanguage("en");
    async Task SetUrdu() => await ChangeLanguage("ur");

    async Task ChangeLanguage(string lang)
    {
        await JS.InvokeVoidAsync("fypTranslation.setLanguage", lang);
        showLangMenu = false;
    }
}

<style>
.layout {
    display: flex;
    height: 100vh;
    font-family: Arial, sans-serif;
}

.sidebar {
    width: 260px;
    background: #2c3e50;
    color: white;
    display: flex;
    flex-direction: column;
    padding: 18px;
    height: 100vh;
    overflow: hidden;
}

.profile-section {
    text-align: center;
    margin-bottom: 16px;
}

.profile-pic {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.6);
    object-fit: cover;
    margin-bottom: 10px;
}

.profile-name {
    font-weight: 700;
    font-size: 16px;
}

.profile-sub {
    font-size: 13px;
    opacity: 0.85;
    margin-top: 4px;
}

.primary-btn {
    margin-top: 12px;
    width: 100%;
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    cursor: pointer;
    background: #2563eb;
    color: #fff;
    font-weight: 700;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 16px;
    flex: 1;
    overflow-y: auto;
    padding-right: 4px;
}

.side-btn {
    background: transparent;
    border: none;
    color: #fff;
    text-align: left;
    padding: 10px 10px;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    gap: 10px;
    align-items: center;
}

.side-btn:hover {
    background: rgba(255,255,255,0.15);
}

.bottom-section {
    border-top: 1px solid rgba(255,255,255,0.15);
    padding-top: 12px;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: space-between;
    position: relative;
}

.icon-btn {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

.language-menu {
    position: absolute;
    bottom: 55px;
    left: 10px;
    background: #fff;
    color: #111;
    border-radius: 10px;
    padding: 6px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.language-menu button {
    border: none;
    background: transparent;
    padding: 8px 10px;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
}

.language-menu button:hover {
    background: #f3f4f6;
}

.logout-btn {
    border: none;
    border-radius: 10px;
    padding: 10px 12px;
    cursor: pointer;
    background: #ef4444;
    color: #fff;
    font-weight: 700;
}

.main-content {
    flex: 1;
    background: #f4f6fb;
    display: flex;
    flex-direction: column;
}

.top-navbar {
    height: 64px;
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
}

.title-main {
    font-weight: 800;
    font-size: 16px;
}

.title-sub {
    font-size: 12px;
    opacity: 0.7;
    margin-top: 2px;
}

.top-actions {
    display: flex;
    gap: 10px;
}

.top-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    background: #fff;
    cursor: pointer;
}

.page-body {
    padding: 18px;
    overflow-y: auto;
    flex: 1;
}

.state-box {
    background: #fff;
    border: 1px solid #e5e7eb;
    padding: 14px;
    border-radius: 12px;
}

.state-box.error {
    border-color: #fecaca;
    background: #fff1f2;
}


</style>