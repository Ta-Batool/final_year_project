@inherits LayoutComponentBase

@using System.Security.Claims
@using Model
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject IJSRuntime JS

<div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="profile-section">
            <img src="https://via.placeholder.com/80" alt="Profile" class="profile-pic" />
            <h4>@displayName</h4>
            <p class="specialization">@roleText</p>

            @* ✅ NEW: Upgrade button (Patient only, non-premium only) *@
            @if (isPatient && !isPremium)
            {
                <button class="upgrade-btn" @onclick="GoToUpgrade">
                    ⭐ Upgrade Now
                </button>
                <p class="small-upgrade-text">Unlock consultation & premium features</p>
            }
            else if (isPatient && isPremium)
            {
                <div class="premium-badge">Premium ✅</div>
            }
        </div>

        <nav class="sidebar-nav">
            <button class="side-btn" @onclick="GoToProfile">
                <i class="fas fa-user"></i> Edit Profile
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/userdashboard")'>
                <i class="fas fa-home"></i> Home
            </button>

            @* ✅ NEW: Fitness Coach Assistant page *@
            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/patient/coach")'>
                <i class="fas fa-robot"></i> Fitness Coach
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/selectdoctor")'>
                <i class="fas fa-user-md"></i> Book Appointment
                @if (isPatient && !isPremium)
                {
                    <span class="lock-badge">🔒</span>
                }
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/my-appointments")'>
                <i class="fas fa-calendar-check"></i> My Appointments
                @if (isPatient && !isPremium)
                {
                    <span class="lock-badge">🔒</span>
                }
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/userexercises")'>
                <i class="fas fa-dumbbell"></i> Exercises
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/medication-compliance")'>
                <i class="fas fa-pills"></i> Medication
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/usermessages")'>
                <i class="fas fa-comments"></i> Messages
                @if (isPatient && !isPremium)
                {
                    <span class="lock-badge">🔒</span>
                }
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/health-logs")'>
                <i class="fas fa-notes-medical"></i> Health Logs
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/health-charts")'>
                <i class="fas fa-chart-line"></i> Health Charts
            </button>

            <button class="side-btn" @onclick='() => Navigation.NavigateTo("/health-alerts")'>
                <i class="fas fa-triangle-exclamation"></i> Alerts
            </button>

            @* ✅ Optional: direct access to payment page in nav (patient only, non-premium only) *@
            @if (isPatient && !isPremium)
            {
                <button class="side-btn" @onclick="GoToUpgrade">
                    <i class="fas fa-credit-card"></i> Upgrade (Payment)
                </button>
            }
        </nav>

        <div class="bottom-section">
            <button class="settings-btn" @onclick="ToggleLanguageMenu">
                <i class="fas fa-gear"></i>
            </button>

            @if (showLangMenu)
            {
                <div class="language-menu">
                    <button @onclick="SetEnglish">English</button>
                    <button @onclick="SetUrdu">اردو</button>
                </div>
            }

            <button class="logout-btn" @onclick="Logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-navbar">
            <h5>@headerTitle</h5>

            @* ✅ Optional: top right upgrade button too (patient only, non-premium only) *@
            @if (isPatient && !isPremium)
            {
                <button class="top-upgrade-btn" @onclick="GoToUpgrade">
                    Upgrade
                </button>
            }
        </header>

        <div class="page-body">
            @Body
        </div>
    </div>
</div>

<!-- ✅ Chatbot: DO NOT force doctor -->
<AiChatWidget />

@code {
    private string displayName = "User";
    private string roleText = "";
    private string headerTitle = "";
    private string? clientId;

    private bool showLangMenu = false;

    // ✅ NEW premium state
    private bool isPremium = false;
    private bool isPatient = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (!user.Identity?.IsAuthenticated ?? true)
            return;

        var email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
        if (string.IsNullOrWhiteSpace(email)) return;

        email = email.Trim().ToLowerInvariant();

        var client = await CService.GetClientByEmailAsync(email);
        if (client == null) return;

        clientId = client.Id;

        // ✅ premium flag comes from client model
        isPremium = client.IsPremium;

        var role = (client.Role ?? "").Trim().ToLowerInvariant();

        if (role == "doctor")
        {
            isPatient = false;

            var doc = await DService.GetDoctorByClientIdAsync(client.Id);
            displayName = doc?.Name != null ? $"Dr. {doc.Name}" : "Doctor";
            roleText = "Doctor";
            headerTitle = "Doctor Dashboard";
        }
        else
        {
            isPatient = true;

            var usr = await UService.GetUserByClientIdAsync(client.Id);
            displayName = usr?.Name ?? client.Name ?? "User";
            roleText = "Patient";
            headerTitle = "Patient Dashboard";
        }
    }

    void GoToProfile()
    {
        if (clientId != null)
            Navigation.NavigateTo($"/userprofile/{clientId}");
    }

    void GoToUpgrade()
    {
        // ✅ your dummy payment page route
        Navigation.NavigateTo("/patient/subscribe");
    }

    void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }

    void ToggleLanguageMenu()
    {
        showLangMenu = !showLangMenu;
    }

    async Task SetEnglish() => await ChangeLanguage("en");
    async Task SetUrdu()    => await ChangeLanguage("ur");

    async Task ChangeLanguage(string lang)
    {
        await JS.InvokeVoidAsync("fypTranslation.setLanguage", lang);
    }
}

<style>
    .layout {
        display: flex;
        height: 100vh;
        font-family: Arial, sans-serif;
    }

    .sidebar {
        width: 250px;
        background: #2c3e50;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 20px;
        position: relative;
        height: 100vh;
        overflow: hidden;
    }

    .profile-section {
        text-align: center;
        margin-bottom: 20px;
    }

    .profile-pic {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        margin-bottom: 10px;
        border: 3px solid white;
    }

    .specialization {
        font-size: 14px;
        color: #ddd;
        margin-bottom: 10px;
    }

    /* ✅ NEW: upgrade button styles */
    .upgrade-btn {
        width: 100%;
        background: #f59e0b;
        border: none;
        color: #111827;
        font-weight: 700;
        padding: 10px 12px;
        border-radius: 8px;
        cursor: pointer;
        margin-top: 10px;
        transition: transform 0.15s ease, opacity 0.15s ease;
    }
    .upgrade-btn:hover {
        opacity: 0.95;
        transform: translateY(-1px);
    }
    .small-upgrade-text {
        font-size: 12px;
        color: #e5e7eb;
        margin-top: 6px;
    }
    .premium-badge {
        margin-top: 10px;
        display: inline-block;
        background: rgba(34, 197, 94, 0.2);
        border: 1px solid rgba(34, 197, 94, 0.35);
        color: #bbf7d0;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
        flex: 1;
        overflow-y: auto;
        padding-bottom: 12px;
    }

    .side-btn {
        background: transparent;
        color: white;
        border: none;
        text-align: left;
        padding: 10px;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 5px;
        transition: background 0.2s;
        position: relative;
    }

    .side-btn:hover {
        background: rgba(255,255,255,0.2);
    }

    .lock-badge {
        margin-left: auto;
        font-size: 13px;
        background: rgba(255,255,255,0.15);
        padding: 2px 8px;
        border-radius: 999px;
    }

    .bottom-section {
        margin-top: 0;
        padding-top: 12px;
        border-top: 1px solid rgba(255,255,255,0.15);
        background: #2c3e50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .settings-btn {
        background: transparent;
        border: none;
        color: white;
        font-size: 18px;
        cursor: pointer;
    }

    .language-menu {
        position: absolute;
        bottom: 70px;
        left: 20px;
        background: #fff;
        color: #333;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        padding: 6px 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        z-index: 10;
    }

    .language-menu button {
        background: transparent;
        border: none;
        cursor: pointer;
        text-align: left;
        padding: 4px 6px;
        font-size: 13px;
    }

    .language-menu button:hover {
        background: #eee;
    }

    .logout-btn {
        padding: 10px;
        background: #ff4d4d;
        border: none;
        border-radius: 5px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logout-btn:hover {
        background: #e60000;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #f9f9f9;
    }

    .top-navbar {
        height: 60px;
        background: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 20px;
        border-bottom: 1px solid #ddd;
    }

    .top-upgrade-btn {
        background: #111827;
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 700;
    }
    .top-upgrade-btn:hover {
        opacity: 0.9;
    }

    .page-body {
        padding: 20px;
        overflow-y: auto;
    }
</style>
