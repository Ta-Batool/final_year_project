@inherits LayoutComponentBase

@using System.Security.Claims
@using Model
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject IJSRuntime JS

<div class="layout">
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="profile-section">
            <img src="https://via.placeholder.com/80" alt="Profile" class="profile-pic" />
            <h4>@displayName</h4>
            <p class="specialization">@roleText</p>
        </div>

                    <nav class="sidebar-nav">
                <button class="side-btn" @onclick="GoToProfile">
                    <i class="fas fa-user"></i> Edit Profile
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/userdashboard")'>
                    <i class="fas fa-home"></i> Home
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/selectdoctor")'>
                    <i class="fas fa-user-md"></i> Book Appointment
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/my-appointments")'>
                    <i class="fas fa-calendar-check"></i> My Appointments
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/userexercises")'>
                    <i class="fas fa-dumbbell"></i> Exercises
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/medication-compliance")'>
                    <i class="fas fa-pills"></i> Medication
                </button>

                <button class="side-btn" @onclick='() => Navigation.NavigateTo("/usermessages")'>
                    <i class="fas fa-comments"></i> Messages
                </button>

                @* Optional: keep old route if that page still exists *@
                @* <button class="side-btn" @onclick='() => Navigation.NavigateTo("/userappointments")'>
                    <i class="fas fa-calendar-check"></i> Appointments (Old)
                </button> *@
            </nav>

        <div class="bottom-section">
            <button class="settings-btn" @onclick="ToggleLanguageMenu">
                <i class="fas fa-gear"></i>
            </button>

            @if (showLangMenu)
            {
                <div class="language-menu">
                    <button @onclick="SetEnglish">English</button>
                    <button @onclick="SetUrdu">اردو</button>
                </div>
            }

            <button class="logout-btn" @onclick="Logout">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-navbar">
            <h5>@headerTitle</h5>
        </header>

        <div class="page-body">
            @Body
        </div>
    </div>
    <AiChatWidget IsDoctor="true" />

</div>

@code {
    private string displayName = "User";
    private string roleText = "";
    private string headerTitle = "";
    private string? clientId;
    private bool showLangMenu = false;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = auth.User;

        if (!user.Identity?.IsAuthenticated ?? true)
            return;

        var email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.FindFirst("email")?.Value;
        if (email is null) return;

        var client = await CService.GetClientByEmailAsync(email);
        if (client == null) return;

        clientId = client.Id;
        string role = client.Role?.ToLower() ?? "user";

        if (role == "doctor")
        {
            var doc = await DService.GetDoctorByClientIdAsync(client.Id);
            displayName = doc?.Name != null ? $"Dr. {doc.Name}" : "Doctor";
            roleText = "Doctor";
            headerTitle = "Doctor Dashboard";
        }
        else
        {
            var usr = await UService.GetUserByClientIdAsync(client.Id);
            displayName = usr?.Name ?? client.Name ?? "User";
            roleText = "Patient";
            headerTitle = "Patient Dashboard";
        }
    }

    void GoToProfile()
    {
        if (clientId != null)
            Navigation.NavigateTo($"/userprofile/{clientId}");
    }

    void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }

    void ToggleLanguageMenu()
    {
        showLangMenu = !showLangMenu;
    }

    async Task SetEnglish() => await ChangeLanguage("en");
    async Task SetUrdu()    => await ChangeLanguage("ur");

    async Task ChangeLanguage(string lang)
    {
        await JS.InvokeVoidAsync("fypTranslation.setLanguage", lang);
    }
}

<style>
    .layout {
        display: flex;
        height: 100vh;
        font-family: Arial, sans-serif;
    }

    .sidebar {
        width: 250px;
        background: #2c3e50;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 20px;
        position: relative; /* so language menu anchors to sidebar */
    }

    .profile-section {
        text-align: center;
        margin-bottom: 20px;
    }

    .profile-pic {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        margin-bottom: 10px;
        border: 3px solid white;
    }

    .specialization {
        font-size: 14px;
        color: #ddd;
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 20px;
    }

    .side-btn {
        background: transparent;
        color: white;
        border: none;
        text-align: left;
        padding: 10px;
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 5px;
        transition: background 0.2s;
    }

    .side-btn:hover {
        background: rgba(255,255,255,0.2);
    }

    .bottom-section {
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .settings-btn {
        background: transparent;
        border: none;
        color: white;
        font-size: 18px;
        cursor: pointer;
    }

    .language-menu {
        position: absolute;
        bottom: 70px;
        left: 20px;
        background: #fff;
        color: #333;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        padding: 6px 10px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        z-index: 10;
    }

    .language-menu button {
        background: transparent;
        border: none;
        cursor: pointer;
        text-align: left;
        padding: 4px 6px;
        font-size: 13px;
    }

    .language-menu button:hover {
        background: #eee;
    }

    .logout-btn {
        padding: 10px;
        background: #ff4d4d;
        border: none;
        border-radius: 5px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .logout-btn:hover {
        background: #e60000;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #f9f9f9;
    }

    .top-navbar {
        height: 60px;
        background: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 20px;
        border-bottom: 1px solid #ddd;
    }

    .page-body {
        padding: 20px;
        overflow-y: auto;
    }
</style>
