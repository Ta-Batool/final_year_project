@page "/admin"

@inject BlazorApp1.Service.AdminSession Session
@inject NavigationManager Nav

<AdminGuard>
    <h3>Admin Panel</h3>

    <button class="btn btn-danger btn-sm" @onclick="Logout">Logout</button>

    <div class="mt-3">
        <a class="btn btn-primary" href="@DoctorsUrl">Doctor Approvals</a>
        <a class="btn btn-secondary ms-2" href="@PatientsUrl">Patients</a>
    </div>
</AdminGuard>

@code {
    private string DoctorsUrl => new Uri(new Uri(Nav.BaseUri), "admin/doctors").ToString();
    private string PatientsUrl => new Uri(new Uri(Nav.BaseUri), "admin/patients").ToString();

    private void Logout()
    {
        Session.Logout();

        // ✅ BaseUri-safe navigation
        var url = new Uri(new Uri(Nav.BaseUri), "admin-login").ToString();
        Nav.NavigateTo(url);
    }
}
