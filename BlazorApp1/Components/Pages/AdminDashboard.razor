@page "/admin"

@inject BlazorApp1.Service.AdminSession Session

<AdminGuard>
    <h3>Admin Panel</h3>

    <button class="btn btn-danger btn-sm" @onclick="Logout">Logout</button>

    <div class="mt-3">
        <a class="btn btn-primary" href="/admin/doctors">Doctor Approvals</a>
        <a class="btn btn-secondary ms-2" href="/admin/patients">Patients</a>
    </div>
</AdminGuard>

@code {
    private void Logout() => Session.Logout();
}
