@page "/admin/doctors"
@layout BlazorApp1.Components.Layout.AdminLayout

@using Model

@inject IAdminApiService AdminApi
@inject HttpClient Http

<AdminGuard>
    <h3>Pending Doctor Approvals</h3>

    @if (loading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (docs.Count == 0)
    {
        <div class="cardx">No pending doctors ✅</div>
    }
    else
    {
        <div class="grid">
            @foreach (var d in docs)
            {
                <div class="cardx">
                    <div class="name">@d.Name</div>
                    <div class="meta">@d.Email</div>
                    <div class="meta">@d.Specialization</div>

                    <div class="badge">@d.VerificationStatus</div>

                    <div class="actions">
                        @if (!string.IsNullOrWhiteSpace(d.Id))
                        {
                            <a class="btn secondary"
                               target="_blank"
                               href="@CertUrl(d.Id!)"
                               @onclick="() => MarkViewed(d.Id!)">
                                View Certificate
                            </a>

                            <button class="btn ok"
                                    disabled="@(!HasViewed(d.Id!))"
                                    @onclick="() => Approve(d.Id!)">
                                Approve
                            </button>

                            <button class="btn danger"
                                    disabled="@(!HasViewed(d.Id!))"
                                    @onclick="() => StartReject(d.Id!)">
                                Reject
                            </button>
                        }
                    </div>

                    @if (!HasViewed(d.Id!))
                    {
                        <div class="hint">
                            Please view the certificate first (required).
                        </div>
                    }

                    @if (rejectingId == d.Id)
                    {
                        <div class="reject-box">
                            <label><b>Rejection Notes (required)</b></label>
                            <textarea class="txt" @bind="rejectNotes"></textarea>

                            <div class="actions">
                                <button class="btn danger" @onclick="() => ConfirmReject(d.Id!)">
                                    Confirm Reject
                                </button>
                                <button class="btn secondary" @onclick="CancelReject">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</AdminGuard>

@code {
    private bool loading = true;
    private string? error;
    private List<Doctor> docs = new();

    // Enforce "view certificate before action"
    private readonly HashSet<string> viewed = new();

    private string? rejectingId;
    private string rejectNotes = "";

    // ✅ Render-safe API URL builder
    private string CertUrl(string doctorId)
    {
        // Http.BaseAddress should be your API base, e.g. https://final-year-project-8r3w.onrender.com/
        return new Uri(Http.BaseAddress!, $"api/doctor-verification/{doctorId}/certificate").ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        try
        {
            loading = true;
            error = null;
            docs = await AdminApi.GetPendingDoctorsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void MarkViewed(string id) => viewed.Add(id);
    private bool HasViewed(string id) => viewed.Contains(id);

    private async Task Approve(string id)
    {
        try
        {
            error = null;
            await AdminApi.ReviewDoctorAsync(id, true, "Approved");
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void StartReject(string id)
    {
        rejectingId = id;
        rejectNotes = "";
        error = null;
    }

    private void CancelReject()
    {
        rejectingId = null;
        rejectNotes = "";
    }

    private async Task ConfirmReject(string id)
    {
        if (string.IsNullOrWhiteSpace(rejectNotes))
        {
            error = "Rejection notes are required.";
            return;
        }

        try
        {
            error = null;
            await AdminApi.ReviewDoctorAsync(id, false, rejectNotes);
            rejectingId = null;
            rejectNotes = "";
            await Load();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}

<style>
.grid{
    display:grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap:14px;
    margin-top:12px;
}
.cardx{
    background:white;
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px;
    box-shadow:0 6px 18px rgba(17,24,39,0.06);
}
.name{
    font-weight:900;
    font-size:16px;
    color:#111827;
}
.meta{
    color:#6b7280;
    font-size:13px;
    margin-top:2px;
}
.badge{
    margin-top:10px;
    display:inline-block;
    padding:6px 10px;
    border-radius:999px;
    background:#eef2ff;
    color:#3730a3;
    font-weight:800;
    font-size:12px;
}
.actions{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-top:12px;
}
.btn{
    border:none;
    border-radius:10px;
    padding:10px 12px;
    font-weight:800;
    cursor:pointer;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    justify-content:center;
}
.btn.secondary{
    background:#f3f4f6;
    color:#111827;
}
.btn.ok{
    background:#22c55e;
    color:white;
}
.btn.danger{
    background:#ef4444;
    color:white;
}
.btn:disabled{
    opacity:0.5;
    cursor:not-allowed;
}
.reject-box{
    margin-top:12px;
    padding-top:10px;
    border-top:1px solid #e5e7eb;
}
.txt{
    width:100%;
    min-height:90px;
    border:1px solid #e5e7eb;
    border-radius:10px;
    padding:10px;
    margin-top:6px;
}
.hint{
    margin-top:10px;
    padding:10px;
    border-radius:10px;
    background:#fff7ed;
    color:#9a3412;
    font-weight:700;
    font-size:12px;
}
</style>
