@page "/admin"
@inject NavigationManager Nav
@inject BlazorApp1.Service.AdminSession Session

<h3>Admin Login</h3>

<div class="card p-3" style="max-width:420px;">
    <label>Email</label>
    <input class="form-control" @bind="email" />

    <label class="mt-2">Password</label>
    <input class="form-control" type="password" @bind="password" />

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger mt-2">@error</div>
    }

    <button class="btn btn-primary mt-3" @onclick="LoginAsync">Login</button>
</div>

@code {
    private string email = "admin@admin.com";
    private string password = "admin123";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        if (Session.IsAdmin)
        {
            Go("admin/dashboard");
        }
    }

    private async Task LoginAsync()
    {
        error = null;

        var ok = await Session.LoginAsync(email, password);
        if (ok)
        {
            Go("admin/dashboard");
        }
        else
        {
            error = "Invalid admin credentials.";
        }
    }

    private void Go(string path)
    {
        var url = new Uri(new Uri(Nav.BaseUri), path).ToString();
        Nav.NavigateTo(url);
    }
}
