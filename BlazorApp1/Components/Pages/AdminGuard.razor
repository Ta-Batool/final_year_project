@inject NavigationManager Nav
@inject BlazorApp1.Service.AdminSession Session

@if (!Session.IsAdmin)
{
    @code {
        protected override void OnInitialized()
        {
            // ✅ FIX: use BaseUri-safe navigation
            var url = new Uri(new Uri(Nav.BaseUri), "admin-login").ToString();
            Nav.NavigateTo(url);
        }
    }
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
