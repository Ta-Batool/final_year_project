@page "/book/{DoctorId}"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AppointmentApiService ApptApi
@inject IDService DoctorService

<h2>📅 Book Appointment</h2>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <div class="card">
        <p><strong>Doctor:</strong> @doctorName</p>

        <div class="form-group">
            <label>Select Date</label>
            <input type="date" class="form-control" value="@dateStr" @onchange="OnDateChanged" />
        </div>

        <div class="form-group">
            <label>Slot Size (minutes)</label>
            <input type="number" class="form-control" @bind="slotMinutes" min="10" step="5" />
        </div>

        <div class="form-group">
            <label>Appointment Duration (minutes)</label>
            <input type="number" class="form-control" @bind="durationMinutes" min="10" step="5" />
        </div>

        <div class="form-group">
            <label>Notes (optional)</label>
            <textarea class="form-control" @bind="notes"></textarea>
        </div>

        <button class="btn-primary" @onclick="LoadAvailability" disabled="@busy">
            @(busy ? "Loading..." : "Load Available Slots")
        </button>
    </div>

    <div class="card mt">
        <h3>Available Slots</h3>

        @if (availability == null)
        {
            <p>Select date and click “Load Available Slots”.</p>
        }
        else if (availability.AvailableSlots == null || availability.AvailableSlots.Count == 0)
        {
            <p>No slots available for this date.</p>
        }
        else
        {
            <div class="slots">
                @foreach (var s in availability.AvailableSlots)
                {
                    <button class="slot-btn" @onclick="() => BookSlot(s)" disabled="@busy">
                        @s.Start.ToString("hh:mm tt") - @s.End.ToString("hh:mm tt")
                    </button>
                }
            </div>

            <hr style="margin:16px 0;" />

            <h4>Or choose a precise time</h4>
            <div class="form-group">
                <label>Time</label>
                <input type="time" class="form-control" @bind="manualTime" />
            </div>

            <button class="btn-primary" @onclick="BookManualTime" disabled="@busy">
                Book This Time
            </button>
        }
    </div>
}

@code {
    [Parameter] public string DoctorId { get; set; } = "";

    private bool isLoading = true;
    private bool busy = false;
    private string error = "";

    private string? userId;
    private string doctorName = "Doctor";

    private int slotMinutes = 30;
    private int durationMinutes = 30;
    private string notes = "";

    private DateTime selectedDate = DateTime.Today;

    private AvailabilityResponseDto? availability;

    private TimeOnly? manualTime = new(9, 0);

    private string dateStr => selectedDate.ToString("yyyy-MM-dd");

    private void OnDateChanged(ChangeEventArgs e)
    {
        var v = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(v) && DateTime.TryParse(v, out var d))
        {
            selectedDate = d.Date;
            availability = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
            {
                error = "User ID not found. Please login again.";
                return;
            }

            var doc = await DoctorService.GetDoctorByIdAsync(DoctorId);
            if (doc != null && !string.IsNullOrWhiteSpace(doc.Name))
                doctorName = doc.Name!;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAvailability()
    {
        try
        {
            error = "";
            busy = true;

            availability = await ApptApi.GetAvailabilityAsync(DoctorId, selectedDate, slotMinutes);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task BookSlot(TimeSlotDto slot)
    {
        try
        {
            error = "";
            busy = true;

            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId missing");

            var req = new BookAppointmentRequest(
                PatientUserId: userId!,
                DoctorId: DoctorId,
                Start: slot.Start,
                DurationMinutes: durationMinutes,
                Notes: notes
            );

            await ApptApi.BookAsync(req);
            Nav.NavigateTo("/my-appointments", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task BookManualTime()
    {
        try
        {
            error = "";
            busy = true;

            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId missing");

            if (manualTime == null)
                throw new Exception("Please select a time.");

            // ensure availability loaded
            if (availability == null)
                availability = await ApptApi.GetAvailabilityAsync(DoctorId, selectedDate, slotMinutes);

            var start = selectedDate.Date.Add(manualTime.Value.ToTimeSpan());

            // must match an available slot start
            var ok = availability?.AvailableSlots?.Any(s => s.Start == start) == true;
            if (!ok)
                throw new Exception("This time is not available. Please choose from available slots.");

            var req = new BookAppointmentRequest(
                PatientUserId: userId!,
                DoctorId: DoctorId,
                Start: start,
                DurationMinutes: durationMinutes,
                Notes: notes
            );

            await ApptApi.BookAsync(req);
            Nav.NavigateTo("/my-appointments", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}

<style>
    .card {
        background: #fff;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        max-width: 900px;
    }

    .mt { margin-top: 16px; }
    .form-group { margin-bottom: 10px; }

    .form-control {
        width: 100%;
        padding: 8px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .btn-primary {
        background: #3b3bbf;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 14px;
        cursor: pointer;
    }

    .slots {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .slot-btn {
        border: 1px solid #3b3bbf;
        background: #fff;
        color: #3b3bbf;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
    }

    .slot-btn:hover {
        background: #3b3bbf;
        color: #fff;
    }
</style>
