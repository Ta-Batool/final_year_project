@page "/book/{DoctorId}"
@layout UserDashboardLayout
@attribute [Authorize]

@using BlazorApp1.Service
@inject IAService AppointmentService
@inject IJSRuntime JS
@inject NavigationManager Nav

<h2>Book Appointment</h2>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="card p-3 mb-3">
    <label>Select Date</label>
    <input type="date" class="form-control" @bind="dateStr" />

    <label class="mt-2">Slot Minutes</label>
    <input type="number" class="form-control" @bind="slotMinutes" min="10" step="5" />

    <label class="mt-2">Duration Minutes</label>
    <input type="number" class="form-control" @bind="durationMinutes" min="10" step="5" />

    <label class="mt-2">Notes</label>
    <textarea class="form-control" @bind="notes"></textarea>

    <button class="btn btn-primary mt-3" @onclick="LoadSlots">Load Slots</button>
</div>

@if (availability?.AvailableSlots?.Count > 0)
{
    <h4>Available Slots</h4>
    <div class="list-group">
        @foreach (var s in availability.AvailableSlots)
        {
            <button class="list-group-item list-group-item-action"
                    @onclick="() => Book(s)">
                @s.Start.ToString("hh:mm tt") - @s.End.ToString("hh:mm tt")
            </button>
        }
    </div>
}
else if (availability != null)
{
    <p>No slots found for this day.</p>
}

@code {
    [Parameter] public string DoctorId { get; set; } = "";

    string? userId;
    string error = "";
    AvailabilityResponseDto? availability;

    int slotMinutes = 30;
    int durationMinutes = 30;
    string notes = "";
    DateTime selectedDate = DateTime.Today;

    string dateStr
    {
        get => selectedDate.ToString("yyyy-MM-dd");
        set => selectedDate = DateTime.Parse(value);
    }

    protected override async Task OnInitializedAsync()
    {
        userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
        if (string.IsNullOrWhiteSpace(userId))
            error = "User ID not found. Please login again.";
    }

    async Task LoadSlots()
    {
        try
        {
            error = "";
            availability = await AppointmentService.GetAvailabilityAsync(DoctorId, selectedDate, slotMinutes);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task Book(TimeSlotDto slot)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(userId)) return;

            var req = new BookAppointmentRequest(
                PatientUserId: userId!,
                DoctorId: DoctorId,
                Start: slot.Start,
                DurationMinutes: durationMinutes,
                Notes: notes
            );

            await AppointmentService.BookAppointmentAsync(req);

            Nav.NavigateTo("/myappointments"); // create/list patient appointments page if you want
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
