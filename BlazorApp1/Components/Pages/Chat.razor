@page "/messages/{doctorClientId}/{userClientId}"
@page "/chat/{doctorClientId}/{userClientId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout BlazorApp1.Components.Layout.DashboardLayout

@using System
@using System.Collections.Generic
@using System.Threading.Tasks
@using System.Security.Claims
@using System.Net.Http
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Model
@using BlazorApp1.Service

@inject MessageClientService MessageService
@inject IDService DoctorService
@inject IUService UserService
@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IConfiguration Configuration

<h3>Chat with @(isDoctorView ? userName : doctorName)</h3>

<div class="chat-container">
    @if (string.IsNullOrWhiteSpace(doctorClientId) || string.IsNullOrWhiteSpace(userClientId))
    {
        <p class="empty">No conversation selected. Go to <b>Messages</b> and choose a conversation.</p>
    }
    else
    {
        <div class="messages">
            @if (isLoading)
            {
                <p>Loading conversation...</p>
            }
            else if (messages.Count == 0)
            {
                <p class="empty">No messages yet. Say hello!</p>
            }
            else
            {
                @foreach (var m in messages)
                {
                    var mine = !string.IsNullOrWhiteSpace(currentClientId) && m.SenderId == currentClientId;
                    <div class="message @(mine ? "mine" : "theirs")">
                        <div class="meta">
                            <span class="name">@m.SenderName</span>
                            <span class="time">@m.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="text">
                            @if (!string.IsNullOrWhiteSpace(m.Text))
                            {
                                <div>@m.Text</div>
                            }

                            @if (!string.IsNullOrEmpty(m.AttachmentFileName) && !string.IsNullOrEmpty(m.Id))
                            {
                                var isImage = m.AttachmentContentType?.StartsWith("image") == true;
                                var isAudio = m.AttachmentContentType?.StartsWith("audio") == true || m.IsVoiceMessage;
                                var url = GetAttachmentUrl(m);

                                if (isImage)
                                {
                                    <img src="@url" class="chat-image" />
                                }
                                else if (isAudio)
                                {
                                    <audio controls src="@url" class="chat-audio"></audio>
                                }
                                else
                                {
                                    <a href="@url" target="_blank">
                                        Download @m.AttachmentFileName
                                    </a>
                                }
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="composer">
            <InputFile OnChange="OnFileSelected" />
            <input @bind="newMessageText"
                   @bind:event="oninput"
                   placeholder="Type a message..." />
            <button @onclick="SendMessage">Send</button>
        </div>
    }
</div>

@code {
    [Parameter] public string doctorClientId { get; set; } = string.Empty;
    [Parameter] public string userClientId { get; set; } = string.Empty;

    private string doctorName = "Doctor";
    private string userName = "You";

    private List<Message> messages = new();
    private string newMessageText = "";
    private bool isLoading = true;

    // who is logged in
    private string? currentClientId;
    private bool isDoctorView = false;

    // ⭐ attachments
    private IBrowserFile? selectedFile;
    private const long maxUploadSize = 10 * 1024 * 1024; // 10 MB
    private string apiBaseUrl = "";

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        apiBaseUrl = Configuration["ApiBaseUrl"] ?? "http://localhost:5092/";

        try
        {
            // Load doctor name
            if (!string.IsNullOrWhiteSpace(doctorClientId))
            {
                var doctor = await DoctorService.GetDoctorByClientIdAsync(doctorClientId);
                if (doctor != null && !string.IsNullOrWhiteSpace(doctor.Name))
                    doctorName = $"Dr. {doctor.Name}";
            }

            // Load user name
            if (!string.IsNullOrWhiteSpace(userClientId))
            {
                var user = await UserService.GetUserByClientIdAsync(userClientId);
                if (user != null && !string.IsNullOrWhiteSpace(user.Name))
                    userName = user.Name;
            }

            // Determine who is currently logged in (doctor or patient)
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (principal?.Identity != null && principal.Identity.IsAuthenticated)
            {
                var email = principal.FindFirst(ClaimTypes.Email)?.Value
                            ?? principal.FindFirst("email")?.Value;

                if (!string.IsNullOrWhiteSpace(email))
                {
                    var client = await CService.GetClientByEmailAsync(email);
                    if (client != null)
                    {
                        currentClientId = client.Id;
                        isDoctorView = string.Equals(client.Role, "Doctor", StringComparison.OrdinalIgnoreCase)
                                       && client.Id == doctorClientId;
                    }
                }
            }

            // Fallback: if we couldn't detect current client, assume patient
            if (string.IsNullOrWhiteSpace(currentClientId))
                currentClientId = userClientId;

            // Load conversation
            if (!string.IsNullOrWhiteSpace(userClientId) &&
                !string.IsNullOrWhiteSpace(doctorClientId))
            {
                messages = await MessageService.GetConversationAsync(userClientId, doctorClientId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading chat: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessageText) && selectedFile == null)
            return;

        if (string.IsNullOrWhiteSpace(doctorClientId) || string.IsNullOrWhiteSpace(userClientId))
            return;

        var senderId = currentClientId ?? userClientId;
        var senderName = isDoctorView ? doctorName : userName;
        var receiverId = isDoctorView ? userClientId : doctorClientId;
        var receiverName = isDoctorView ? userName : doctorName;

        try
        {
            Message saved;

            if (selectedFile != null)
            {
                using var content = new MultipartFormDataContent();

                // file
                var stream = selectedFile.OpenReadStream(maxUploadSize);
                var fileContent = new StreamContent(stream);
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(selectedFile.ContentType);
                content.Add(fileContent, "file", selectedFile.Name);

                // metadata fields expected by API
                content.Add(new StringContent(senderId), "senderId");
                content.Add(new StringContent(senderName), "senderName");
                content.Add(new StringContent(receiverId), "receiverId");
                content.Add(new StringContent(receiverName), "receiverName");
                content.Add(new StringContent(userClientId), "userClientId");
                content.Add(new StringContent(doctorClientId), "doctorClientId");
                content.Add(new StringContent(newMessageText ?? string.Empty), "text");
                content.Add(new StringContent("false"), "isVoice"); // voice notes later

                saved = await MessageService.SendAttachmentAsync(content);

                selectedFile = null;
            }
            else
            {
                var msg = new Message
                {
                    SenderId = senderId,
                    SenderName = senderName,
                    ReceiverId = receiverId,
                    ReceiverName = receiverName,
                    UserClientId = userClientId,
                    DoctorClientId = doctorClientId,
                    Text = newMessageText,
                    SentAt = DateTime.UtcNow
                };

                saved = await MessageService.SendMessageAsync(msg);
            }

            messages.Add(saved);
            newMessageText = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error sending message: {ex.Message}");
        }
    }

    private string GetAttachmentUrl(Message m)
    {
        if (string.IsNullOrEmpty(m.Id))
            return "#";

        return $"{apiBaseUrl.TrimEnd('/')}/api/message/{m.Id}/attachment";
    }
}

<style>
    .chat-container {
        max-width: 700px;
        margin: 20px auto;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .messages {
        max-height: 400px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-right: 4px;
    }

    .message {
        max-width: 70%;
        padding: 8px 10px;
        border-radius: 10px;
        background: #f1f2f6;
        font-size: 14px;
    }

    .message.mine {
        margin-left: auto;
        background: #d1e7ff;
    }

    .message.theirs {
        margin-right: auto;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #555;
        margin-bottom: 2px;
    }

    .text {
        font-size: 14px;
    }

    .composer {
        display: flex;
        gap: 8px;
        margin-top: 8px;
        align-items: center;
    }

    .composer input[type="file"],
    .composer ::deep input[type="file"] {
        max-width: 180px;
        font-size: 12px;
    }

    .composer input[type="text"],
    .composer input:not([type="file"]) {
        flex: 1;
        padding: 8px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .composer button {
        padding: 8px 14px;
        border: none;
        background: #3b3bbf;
        color: #fff;
        cursor: pointer;
        border-radius: 8px;
    }

    .composer button:hover {
        opacity: 0.9;
    }

    .empty {
        color: #777;
        font-style: italic;
    }

    .chat-image {
        max-width: 200px;
        border-radius: 8px;
        margin-top: 4px;
    }

    .chat-audio {
        width: 200px;
        margin-top: 4px;
    }
</style>
