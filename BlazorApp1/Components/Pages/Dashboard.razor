@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout BlazorApp1.Components.Layout.DashboardLayout

@using System.Security.Claims
@using Model

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject NavigationManager NavManager

<h3>Dashboard</h3>

@if (isLoading)
{
    <p>Loading your profile...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentDoctor is not null)
{
    <h4>Welcome, Dr. @currentDoctor.Name</h4>
    <p><b>Specialization:</b> @currentDoctor.Specialization</p>
    <p><b>Email:</b> @clientEmail</p>
    <p><b>Gender:</b> @currentDoctor.Gender</p>
}
else if (currentUser is not null)
{
    <h4>Welcome, @currentUser.Name</h4>
    <p><b>Email:</b> @clientEmail</p>
    <p><b>Phone:</b> @currentUser.Phone</p>
    <p><b>Reason for visit:</b> @currentUser.Reason</p>
}
else
{
    <p>No profile found. Please complete your registration.</p>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? clientEmail;

    private Client? currentClient;
    private Doctor? currentDoctor;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!(principal.Identity?.IsAuthenticated ?? false))
            {
                NavManager.NavigateTo("/login-google", forceLoad: true);
                return;
            }

            clientEmail =
                principal.FindFirst(ClaimTypes.Email)?.Value
                ?? principal.FindFirst("email")?.Value;

            clientEmail = clientEmail?.Trim().ToLowerInvariant();

            if (string.IsNullOrWhiteSpace(clientEmail))
            {
                errorMessage = "No email found in your Google account.";
                return;
            }

            currentClient = await CService.GetClientByEmailAsync(clientEmail);

            if (currentClient is null)
            {
                // No client profile -> must register
                NavManager.NavigateTo("/register", forceLoad: true);
                return;
            }

            var role = (currentClient.Role ?? "").Trim().ToLowerInvariant();

            // ✅ If role not chosen yet
            if (string.IsNullOrWhiteSpace(role))
            {
                NavManager.NavigateTo("/register", forceLoad: true);
                return;
            }

            // ✅ DOCTOR FLOW
            if (role == "doctor")
            {
                currentDoctor = await DService.GetDoctorByClientIdAsync(currentClient.Id);

                // If doctor profile not created yet -> go to doctor form
                if (currentDoctor is null)
                {
                    NavManager.NavigateTo($"/form/{currentClient.Id}", forceLoad: true);
                    return;
                }

                // If not approved -> go to verification upload
                if (currentDoctor.VerificationStatus != DoctorVerificationStatus.Approved)
                {
                    NavManager.NavigateTo("/doctor/verification", forceLoad: true);
                    return;
                }

                // Approved doctor stays on /dashboard (or you can navigate to doctor dashboard page)
                return;
            }

            // ✅ PATIENT FLOW
            if (role == "patient")
            {
                currentUser = await UService.GetUserByClientIdAsync(currentClient.Id);

                if (currentUser is null)
                {
                    NavManager.NavigateTo($"/formuser/{currentClient.Id}", forceLoad: true);
                    return;
                }

                NavManager.NavigateTo("/userdashboard", forceLoad: true);
                return;
            }

            // ✅ Unknown role fallback
            NavManager.NavigateTo("/register", forceLoad: true);
            return;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
