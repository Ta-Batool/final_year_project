@page "/messages"
@using Model
@using BlazorApp1.Service
@using BlazorApp1.Components.Layout
@layout DashboardLayout

@inject MessageClientService MessageService
@inject IUService UserService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="chat-page">
    <h2>💬 Your Conversations</h2>

    @if (isLoading)
    {
        <p>Loading conversations...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p class="error">Error loading conversations: @loadError</p>
    }
    else if (string.IsNullOrWhiteSpace(currentDoctorClientId))
    {
        <div class="empty-state">
            <p>Could not detect your Doctor ClientId.</p>
            <p class="hint">Make sure a doctor is logged in so <code>localStorage['doctorId']</code> is set.</p>
        </div>
    }
    else if (conversations.Count == 0)
    {
        <div class="empty-state">
            <p>No messages yet.</p>
            <button class="start-chat-btn" @onclick="GoToPatients">
                Start Chat
            </button>
        </div>
    }
    else
    {
        <div class="conversation-list">
            @foreach (var convo in conversations)
            {
                <div class="conversation-card">
                    <div class="info">
                        <h3>@convo.UserName</h3>
                        <p><strong>User ClientId:</strong> @convo.UserClientId</p>
                    </div>
                    <button class="open-btn"
                            @onclick="() => OpenChat(convo.UserClientId)">
                        Open Chat
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private class ConversationUser
    {
        public string UserClientId { get; set; } = "";
        public string UserName { get; set; } = "";
    }

    private List<ConversationUser> conversations = new();
    private string? currentDoctorClientId;
    private bool isLoading = true;
    private string? loadError;
    private bool _loadedFromJs = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loadedFromJs)
            return;

        _loadedFromJs = true;

        try
        {
            // 🔹 read doctorId from localStorage
            currentDoctorClientId = await JS.InvokeAsync<string>("localStorage.getItem", "doctorId");

            if (!string.IsNullOrWhiteSpace(currentDoctorClientId))
            {
                // 🔹 which users has this doctor talked to?
                var userIds = await MessageService.GetUsersForDoctorAsync(currentDoctorClientId);
                var uniqueUserIds = new HashSet<string>(userIds ?? new List<string>());

                foreach (var userClientId in uniqueUserIds)
                {
                    if (string.IsNullOrWhiteSpace(userClientId)) continue;

                    var user = await UserService.GetUserByClientIdAsync(userClientId);
                    var name = (user != null && !string.IsNullOrWhiteSpace(user.Name))
                        ? user.Name
                        : "(Unknown User)";

                    conversations.Add(new ConversationUser
                    {
                        UserClientId = userClientId,
                        UserName = name
                    });
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void OpenChat(string userClientId)
    {
        if (string.IsNullOrWhiteSpace(currentDoctorClientId))
            return;

        Nav.NavigateTo($"/messages/{currentDoctorClientId}/{userClientId}");
    }

    private void GoToPatients()
    {
        // or wherever your doctor should go to pick a patient
        Nav.NavigateTo("/patients");
    }
}

<style>
    .chat-page {
        padding: 20px;
    }

    .conversation-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .conversation-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .info h3 {
        margin: 0;
        font-size: 18px;
    }

    .info p {
        margin: 4px 0 0;
        font-size: 13px;
        color: #666;
    }

    .open-btn {
        background: #3b3bbf;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 12px;
        cursor: pointer;
    }

    .open-btn:hover {
        opacity: 0.9;
    }

    .empty-state {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        background: #f5f6ff;
        text-align: center;
    }

    .start-chat-btn {
        margin-top: 10px;
        background: #27ae60;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        cursor: pointer;
        font-weight: 600;
    }

    .start-chat-btn:hover {
        background: #219150;
    }

    .error {
        color: #b00020;
    }

    .hint {
        font-size: 12px;
        color: #777;
    }
</style>
