@page "/doctor/prescribe/{PatientUserId}"
@layout BlazorApp1.Components.Layout.DashboardLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Model
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@inject DoctorPatientsApiService DoctorPatientsApi
@inject IJSRuntime JS

<h2>Prescribe Medication</h2>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="card">
    <p><strong>Patient UserId:</strong> @PatientUserId</p>

    <EditForm Model="@plan" OnValidSubmit="Submit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Medicine Name</label>
            <InputText @bind-Value="plan.Name" class="form-control" />
        </div>

        <div class="form-group">
            <label>Dosage</label>
            <InputText @bind-Value="plan.Dosage" class="form-control" />
        </div>

        <div class="form-group">
            <label>Time Of Day (HH:mm)</label>
            <InputText @bind-Value="plan.TimeOfDay" class="form-control" placeholder="08:00" />
        </div>

        <div class="form-group">
            <label>Start Date</label>
            <InputDate @bind-Value="plan.StartDate" class="form-control" />
        </div>

        <div class="form-group">
            <label>End Date (optional)</label>
            <InputDate @bind-Value="plan.EndDate" class="form-control" />
        </div>

        <div class="form-group">
            <label>Notes</label>
            <InputTextArea @bind-Value="plan.Notes" class="form-control" />
        </div>

        <button class="btn-primary" type="submit" disabled="@isSaving">
            @(isSaving ? "Prescribing..." : "Prescribe")
        </button>
    </EditForm>
</div>

@code {
    [Parameter] public string PatientUserId { get; set; } = "";

    private string? doctorId;
    private string error = "";
    private bool isSaving = false;

    private MedicationPlan plan = new MedicationPlan
    {
        StartDate = DateTime.UtcNow.Date
    };

    protected override async Task OnInitializedAsync()
    {
        doctorId = await JS.InvokeAsync<string?>("localStorage.getItem", "doctorId");
        if (string.IsNullOrWhiteSpace(doctorId))
            error = "Doctor ID not found. Please log in again.";
    }

    private async Task Submit()
    {
        try
        {
            error = "";
            isSaving = true;

            if (string.IsNullOrWhiteSpace(doctorId))
                throw new Exception("Doctor ID missing");

            if (string.IsNullOrWhiteSpace(PatientUserId))
                throw new Exception("Patient userId missing");

            plan.UserId = PatientUserId;

            // ✅ auto link to avoid Forbid during demo
            await DoctorPatientsApi.LinkPatientAsync(doctorId!, PatientUserId);

            await DoctorPatientsApi.PrescribeMedicationAsync(doctorId!, PatientUserId, plan);

            // reset
            plan = new MedicationPlan { StartDate = DateTime.UtcNow.Date };
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .card {
        background: #fff;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        max-width: 700px;
    }

    .form-group { margin-bottom: 10px; }

    .form-control {
        width: 100%;
        padding: 6px 8px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 14px;
    }

    .btn-primary {
        background: #3b3bbf;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 14px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-primary[disabled] {
        opacity: 0.6;
        cursor: default;
    }
</style>
