@page "/doctor/verification"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using Model

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IDService DService
@inject IDoctorVerificationApiService VerifyApi
@inject NavigationManager NavManager

<h3>Doctor Verification</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (doctor is null)
{
    <p>Doctor profile not found. Please complete doctor registration.</p>
}
else
{
    <div class="card p-3">
        <p><b>Status:</b> @doctor.VerificationStatus</p>

        @if (doctor.VerificationStatus == DoctorVerificationStatus.Approved)
        {
            <div class="alert alert-success">
                Approved ✅ You can now access your dashboard.
            </div>

            <button class="btn btn-primary" @onclick="GoToDashboard">
                Go to Dashboard
            </button>
        }
        else if (doctor.VerificationStatus == DoctorVerificationStatus.PendingAdminApproval)
        {
            <div class="alert alert-info">
                Certificate uploaded ✅ Waiting for admin approval.
            </div>
        }
        else
        {
            <p class="text-muted">
                Upload your medical certificate (PDF/JPG/PNG). After upload, admin will verify your documents.
            </p>

            @if (doctor.VerificationStatus == DoctorVerificationStatus.Rejected &&
                 !string.IsNullOrWhiteSpace(doctor.ReviewNotes))
            {
                <div class="alert alert-warning">
                    <b>Rejected:</b> @doctor.ReviewNotes
                </div>
            }

            <InputFile OnChange="OnFileSelected" />

            @if (!string.IsNullOrWhiteSpace(uploadMessage))
            {
                <div class="alert alert-info mt-2">@uploadMessage</div>
            }
        }
    </div>
}

@code {
    private bool isLoading = true;
    private string? error;
    private Doctor? doctor;
    private string? uploadMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!(principal.Identity?.IsAuthenticated ?? false))
            {
                NavManager.NavigateTo("/login-google", true);
                return;
            }

            var email = principal.FindFirst(ClaimTypes.Email)?.Value
                        ?? principal.FindFirst("email")?.Value;

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "No email found in your Google account.";
                return;
            }

            var client = await CService.GetClientByEmailAsync(email);
            if (client is null)
            {
                error = "Client profile not found.";
                return;
            }

            doctor = await DService.GetDoctorByClientIdAsync(client.Id);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToDashboard()
    {
        NavManager.NavigateTo("/dashboard", true);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (doctor?.Id is null) return;

        var file = e.File;
        if (file is null) return;

        try
        {
            uploadMessage = "Uploading...";

            using var stream = file.OpenReadStream(15_000_000);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            await VerifyApi.UploadCertificateAsync(doctor.Id, bytes, file.Name, file.ContentType);

            uploadMessage = "Uploaded ✅ Waiting for admin approval.";

            // Refresh doctor profile
            doctor = await DService.GetDoctorByIdAsync(doctor.Id);
        }
        catch (Exception ex)
        {
            uploadMessage = null;
            error = ex.Message;
        }
    }
}
