@page "/form/{ClientId}"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using PhoneNumbers
@using Model
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IDService DoctorService
@inject AuthenticationStateProvider AuthStateProvider

<div class="auth-container">
    <div class="auth-left">
        <h1>Registration Form</h1>
        <p>Please complete your details below</p>
    </div>

    <div class="auth-right">
        <div class="auth-card">
            @if (step == 1)
            {
                <EditForm Model="@doctor" OnValidSubmit="@GoToProfessional">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label>Full Name</label>
                        <InputText class="form-input" @bind-Value="doctor.Name" placeholder="Enter your full name" />
                        <ValidationMessage For="@(() => doctor.Name)" />
                    </div>

                    <div class="form-group">
                        <label>Email Address</label>
                        <InputText class="form-input readonly-input" @bind-Value="doctor.Email" readonly />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect class="form-input" @bind-Value="doctor.Gender">
                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => doctor.Gender)" />
                    </div>

                    <div class="form-group">
                        <label>Age</label>
                        <InputNumber class="form-input" @bind-Value="doctor.Age" />
                        <ValidationMessage For="@(() => doctor.Age)" />
                    </div>

                    <div class="form-group">
                        <label>Phone Number</label>

                        <div class="phone-row">
                            <InputSelect class="form-input country-select" @bind-Value="selectedCountryIso" @onchange="ResetPhoneError">
                                @foreach (var country in countries)
                                {
                                    <option value="@country.Iso">
                                        @country.Name (+@country.Code)
                                    </option>
                                }
                            </InputSelect>

                            <InputText class="form-input phone-input"
                                       @bind-Value="doctor.Phone"
                                       @oninput="OnPhoneChanged"
                                       placeholder="Enter number without country code" />
                        </div>

                        <small class="phone-help">
                            Example for Pakistan: 3001234567 or 03001234567
                        </small>

                        <ValidationMessage For="@(() => doctor.Phone)" />

                        @if (!string.IsNullOrWhiteSpace(localPhoneError))
                        {
                            <div class="field-error">@localPhoneError</div>
                        }
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <InputText class="form-input" @bind-Value="doctor.Address" placeholder="Enter address" />
                        <ValidationMessage For="@(() => doctor.Address)" />
                    </div>

                    <button type="submit" class="btn-next">Next</button>
                </EditForm>
            }
            else if (step == 2)
            {
                <EditForm Model="@doctor" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrWhiteSpace(step2Error))
                    {
                        <div class="alert alert-danger">@step2Error</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(submitError))
                    {
                        <div class="alert alert-danger">@submitError</div>
                    }

                    <div class="form-group">
                        <label>Specialization</label>
                        <InputText class="form-input" @bind-Value="doctor.Specialization" placeholder="Enter specialization" />
                        <ValidationMessage For="@(() => doctor.Specialization)" />
                    </div>

                    <div class="form-group">
                        <label>Years of Experience</label>
                        <InputNumber class="form-input" @bind-Value="doctor.ExperienceYears" />
                        <ValidationMessage For="@(() => doctor.ExperienceYears)" />
                    </div>

                    <div class="form-group">
                        <label>PMDC Number</label>
                        <InputText class="form-input" @bind-Value="doctor.PMDCNumber" placeholder="Enter PMDC number" />
                        <ValidationMessage For="@(() => doctor.PMDCNumber)" />
                    </div>

                    <button type="submit" class="btn-submit" disabled="@isSubmitting">
                        @(isSubmitting ? "Submitting..." : "Submit")
                    </button>

                    <button type="button" class="btn-back" @onclick="GoBack" disabled="@isSubmitting">
                        Back
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ClientId { get; set; }

    private int step = 1;
    private Doctor doctor = new();

    private string? step2Error;
    private string? submitError;
    private bool isSubmitting = false;

    private readonly PhoneNumberUtil phoneUtil = PhoneNumberUtil.GetInstance();

    private List<CountryOption> countries = new();
    private string selectedCountryIso = "PK";
    private string? localPhoneError;

    protected override async Task OnInitializedAsync()
    {
        countries = BuildCountryList();

        if (!string.IsNullOrWhiteSpace(ClientId))
        {
            doctor.ClientId = ClientId;
            Console.WriteLine($"✅ Client ID set: {doctor.ClientId}");
        }
        else
        {
            Console.WriteLine("⚠️ ClientId not found in URL!");
        }

        await LoadGoogleUserInfoAsync();
    }

    private async Task LoadGoogleUserInfoAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            ?? user.FindFirst("email")?.Value
                            ?? user.Claims.FirstOrDefault(c => c.Type.ToLower().Contains("email"))?.Value;

                if (!string.IsNullOrWhiteSpace(email))
                {
                    doctor.Email = email.Trim().ToLowerInvariant();
                }

                var name = user.FindFirst("name")?.Value
                           ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

                if (!string.IsNullOrWhiteSpace(name) && string.IsNullOrWhiteSpace(doctor.Name))
                {
                    doctor.Name = name.Trim();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("⚠️ Could not fetch Google user info: " + ex.Message);
        }
    }

    private List<CountryOption> BuildCountryList()
    {
        var list = new List<CountryOption>();

        foreach (var culture in CultureInfo.GetCultures(CultureTypes.SpecificCultures))
        {
            try
            {
                var region = new RegionInfo(culture.Name);
                var iso = region.TwoLetterISORegionName;

                if (string.IsNullOrWhiteSpace(iso))
                    continue;

                var code = phoneUtil.GetCountryCodeForRegion(iso);

                if (code <= 0)
                    continue;

                if (!list.Any(x => x.Iso == iso))
                {
                    list.Add(new CountryOption
                    {
                        Iso = iso,
                        Name = region.EnglishName,
                        Code = code
                    });
                }
            }
            catch
            {
            }
        }

        return list.OrderBy(x => x.Name).ToList();
    }

    private void OnPhoneChanged(ChangeEventArgs e)
    {
        doctor.Phone = e.Value?.ToString();
        ResetPhoneError();
    }

    private void ResetPhoneError()
    {
        localPhoneError = null;
    }

    private bool ValidatePhone()
    {
        localPhoneError = null;

        if (string.IsNullOrWhiteSpace(doctor.Phone))
        {
            localPhoneError = "Please enter your phone number.";
            return false;
        }

        var rawPhone = doctor.Phone.Trim();

        if (!rawPhone.All(c => char.IsDigit(c) || c == '+' || c == ' ' || c == '-'))
        {
            localPhoneError = "Phone number can only contain digits, spaces, +, or hyphen.";
            return false;
        }

        var digitsOnly = new string(rawPhone.Where(char.IsDigit).ToArray());

        if (digitsOnly.Length < 6)
        {
            localPhoneError = "Phone number is too short.";
            return false;
        }

        if (digitsOnly.Length > 15)
        {
            localPhoneError = "Phone number is too long.";
            return false;
        }

        try
        {
            var parsed = phoneUtil.Parse(rawPhone, selectedCountryIso);

            if (!phoneUtil.IsValidNumberForRegion(parsed, selectedCountryIso))
            {
                localPhoneError = "Invalid phone number for selected country.";
                return false;
            }

            doctor.Phone = phoneUtil.Format(parsed, PhoneNumberFormat.E164);
            return true;
        }
        catch
        {
            localPhoneError = "Invalid phone number format.";
            return false;
        }
    }

    private void GoToProfessional()
    {
        step2Error = null;
        submitError = null;

        if (!ValidatePhone())
            return;

        step = 2;
    }

    private void GoBack()
    {
        step2Error = null;
        submitError = null;
        step = 1;
    }

    private async Task HandleSubmit()
    {
        step2Error = null;
        submitError = null;

        if (string.IsNullOrWhiteSpace(doctor.Email))
        {
            submitError = "Google email could not be fetched. Please sign in again.";
            step = 1;
            return;
        }

        if (string.IsNullOrWhiteSpace(doctor.Specialization))
        {
            step2Error = "Specialization is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(doctor.PMDCNumber))
        {
            step2Error = "PMDC Number is required.";
            return;
        }

        if (isSubmitting) return;
        isSubmitting = true;

        try
        {
            await DoctorService.AddDoctorAsync(doctor);

            if (!string.IsNullOrWhiteSpace(doctor.ClientId))
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "doctorId", doctor.ClientId);
            }

            Navigation.NavigateTo("/dashboard?submitted=true");
        }
        catch (Exception ex)
        {
            submitError = "Error submitting form: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class CountryOption
    {
        public string Iso { get; set; } = "";
        public string Name { get; set; } = "";
        public int Code { get; set; }
    }
}

<style>
    .auth-container {
        display: flex;
        justify-content: center;
        align-items: stretch;
        max-width: 1000px;
        margin: 40px auto;
        height: 80vh;
        min-height: 600px;
        border-radius: 20px;
        overflow: hidden;
        background: #4a47a3;
        color: white;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .auth-left {
        flex: 1;
        color: white;
        text-align: center;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .auth-left h1 {
        font-size: 26px;
        margin-bottom: 12px;
    }

    .auth-left p {
        font-size: 16px;
        color: #ddd;
    }

    .auth-right {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        max-height: 80vh;
        padding: 22px;
        background: #fff;
    }

    .auth-card {
        background: #fff;
        color: #333;
        padding: 24px;
        border-radius: 15px;
        width: 100%;
        max-width: 440px;
        text-align: left;
        box-shadow: none;
    }

    .form-group {
        margin-bottom: 14px;
    }

    .form-group label {
        font-weight: bold;
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
    }

    .form-input {
        width: 100%;
        padding: 11px 13px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }

    .form-input:focus {
        border-color: #3f3da6;
        box-shadow: 0 0 5px rgba(63,61,166,0.4);
    }

    .readonly-input {
        background: #f5f5f5;
        cursor: not-allowed;
        color: #555;
    }

    .phone-row {
        display: flex;
        gap: 8px;
    }

    .country-select {
        max-width: 170px;
    }

    .phone-input {
        flex: 1;
    }

    .phone-help {
        display: block;
        margin-top: 6px;
        color: #777;
        font-size: 12px;
    }

    .field-error {
        margin-top: 8px;
        font-size: 13px;
        font-weight: 600;
        color: #e50000;
    }

    .validation-message {
        font-size: 13px;
        color: #e50000;
        margin-top: 4px;
        display: block;
    }

    .alert-danger {
        padding: 10px;
        margin-bottom: 12px;
        border-radius: 8px;
        background: #ffecec;
        color: #c90000;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-next, .btn-submit, .btn-back {
        width: 100%;
        padding: 11px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 9px;
        transition: 0.2s ease-in-out;
    }

    .btn-next {
        background: #3f3da6;
        color: white;
    }

    .btn-next:hover {
        background: #2f2b8f;
    }

    .btn-submit {
        background: #28a745;
        color: white;
    }

    .btn-submit:hover {
        background: #218838;
    }

    .btn-back {
        background: #6c757d;
        color: white;
    }

    .btn-back:hover {
        background: #5a6268;
    }

    .btn-submit:disabled,
    .btn-back:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
        .auth-container {
            flex-direction: column;
            height: auto;
            min-height: 100vh;
            margin: 0;
            border-radius: 0;
        }

        .auth-left {
            padding: 25px;
        }

        .auth-right {
            max-height: none;
            overflow-y: visible;
        }

        .phone-row {
            flex-direction: column;
        }

        .country-select {
            max-width: 100%;
        }
    }
</style>