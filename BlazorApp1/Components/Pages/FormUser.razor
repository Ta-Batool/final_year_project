@page "/formuser/{ClientId}"
@using Model
@using System.Security.Claims
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IUService UserService
@inject AuthenticationStateProvider AuthStateProvider

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-left">
            <h1>User Registration</h1>
            <p>Please fill in your details to create your account</p>
        </div>

        <div class="auth-right">
            <div class="auth-card">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="error-box">@errorMessage</div>
                }

                <EditForm Model="@user" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>Full Name</label>
                        <InputText class="form-input" @bind-Value="user.Name" />
                        <ValidationMessage For="@(() => user.Name)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <InputText class="form-input" @bind-Value="user.Email" readonly />
                        <ValidationMessage For="@(() => user.Email)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Gender</label>
                        <InputSelect class="form-input" @bind-Value="user.Gender">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => user.Gender)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Age</label>
                        <InputNumber class="form-input" @bind-Value="user.Age" />
                        <ValidationMessage For="@(() => user.Age)" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label>Weight</label>
                        <InputText class="form-input" @bind-Value="user.Weight" />
                    </div>

                    <div class="form-group">
                        <label>Height</label>
                        <InputText class="form-input" @bind-Value="user.Height" />
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <InputText class="form-input" @bind-Value="user.Address" />
                    </div>

                    <button type="submit" class="btn-submit" disabled="@isSaving">
                        @(isSaving ? "Registering..." : "Register")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? ClientId { get; set; }

    private User user = new();
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user.ClientId = ClientId;
        user.RegisterDate = DateTime.Now;
        user.AuthProvider = "Google";
        user.Age = 18;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var googleUser = authState.User;

        if (googleUser.Identity?.IsAuthenticated == true)
        {
            user.Email =
                googleUser.FindFirst(ClaimTypes.Email)?.Value ??
                googleUser.FindFirst("email")?.Value ??
                "";

            user.Name =
                googleUser.FindFirst(ClaimTypes.Name)?.Value ??
                googleUser.FindFirst("name")?.Value ??
                user.Name;

            user.GoogleId =
                googleUser.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
                googleUser.FindFirst("sub")?.Value ??
                "";

            user.ClientId ??= user.GoogleId;
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            user.ClientId ??= ClientId;
            user.Sex = user.Gender;
            user.RegisterDate = DateTime.Now;
            user.AuthProvider = "Google";

            await UserService.AddUserAsync(user);

            if (!string.IsNullOrWhiteSpace(user.ClientId))
                await JS.InvokeVoidAsync("localStorage.setItem", "userId", user.ClientId);

            Navigation.NavigateTo("/userdashboard", true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Registration failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    :global(html),
    :global(body) {
        min-height: 100%;
        overflow-y: auto !important;
    }

    .auth-page {
        min-height: 100vh;
        padding: 40px 20px 80px;
        background: #f7f7fb;
        box-sizing: border-box;
        overflow-y: visible;
    }

    .auth-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 1050px;
        margin: 0 auto;
        border-radius: 22px;
        overflow: visible;
        background: #fff;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.16);
    }

    .auth-left {
        background: #4a47a3;
        color: white;
        min-height: 620px;
        padding: 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
        border-radius: 22px 0 0 22px;
    }

    .auth-left h1 {
        font-size: 34px;
        margin-bottom: 16px;
        font-weight: 800;
    }

    .auth-left p {
        font-size: 17px;
        color: #eeeeff;
        line-height: 1.5;
    }

    .auth-right {
        background: #fff;
        padding: 36px 46px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        border-radius: 0 22px 22px 0;
    }

    .auth-card {
        width: 100%;
        max-width: 430px;
        color: #222;
    }

    .form-group {
        margin-bottom: 13px;
    }

    .form-group label {
        display: block;
        margin-bottom: 6px;
        font-size: 14px;
        font-weight: 700;
        color: #333;
        text-align: left;
    }

    .form-input {
        width: 100%;
        height: 46px;
        padding: 10px 14px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 15px;
        outline: none;
        box-sizing: border-box;
        background: #fff;
    }

    .form-input:focus {
        border-color: #4a47a3;
        box-shadow: 0 0 0 3px rgba(74, 71, 163, 0.12);
    }

    .form-input[readonly] {
        background: #f5f6fa;
        color: #444;
    }

    .validation-message {
        font-size: 12px;
        color: #d00000;
        margin-top: 4px;
        display: block;
    }

    .btn-submit {
        width: 100%;
        height: 48px;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        margin-top: 10px;
        background: #28a745;
        color: white;
        transition: 0.2s ease;
    }

    .btn-submit:hover {
        background: #218838;
    }

    .btn-submit:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .error-box,
    .validation-summary-errors {
        background: #fff1f1;
        color: #a40000;
        border: 1px solid #ffc7c7;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 14px;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .auth-page {
            padding: 20px 14px 70px;
        }

        .auth-container {
            grid-template-columns: 1fr;
        }

        .auth-left {
            min-height: auto;
            padding: 34px 20px;
            border-radius: 22px 22px 0 0;
        }

        .auth-left h1 {
            font-size: 28px;
        }

        .auth-right {
            padding: 28px 22px;
            border-radius: 0 0 22px 22px;
        }
    }
</style>