@page "/health-alerts"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject HealthApiService HealthApi

<h2>🚨 Health Alerts</h2>

@if (busy)
{
    <p>Checking latest readings...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (alerts.Count == 0)
{
    <div class="ok-card">✅ No abnormal readings found in latest logs.</div>
}
else
{
    <div class="alerts">
        @foreach (var a in alerts)
        {
            <div class="alert-card @a.SeverityClass">
                <div class="title">
                    <strong>@a.Title</strong>
                    <span class="time">@a.Time.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                </div>
                <div class="msg">@a.Message</div>
            </div>
        }
    </div>
}

@code {
    bool busy = true;
    string error = "";
    string? userId;

    List<AlertItem> alerts = new();

    const int BP_SYS_HIGH = 140;
    const int BP_DIA_HIGH = 90;

    const int GLUCOSE_HIGH = 180;
    const int GLUCOSE_LOW = 70;

    const double WEIGHT_SPIKE_KG = 2.0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            busy = true;

            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId not found in localStorage. Please login again.");

            var bp = (await HealthApi.GetBPAsync(userId!)) ?? new();
            var g  = (await HealthApi.GetGlucoseAsync(userId!)) ?? new();
            var w  = (await HealthApi.GetWeightAsync(userId!)) ?? new();

            bp = bp.OrderByDescending(x => x.LoggedAt).ToList();
            g  = g.OrderByDescending(x => x.LoggedAt).ToList();
            w  = w.OrderByDescending(x => x.LoggedAt).ToList();

            var latestBp = bp.FirstOrDefault();
            if (latestBp != null && (latestBp.Systolic >= BP_SYS_HIGH || latestBp.Diastolic >= BP_DIA_HIGH))
            {
                alerts.Add(new AlertItem
                {
                    Title = "High Blood Pressure",
                    Message = $"BP is {latestBp.Systolic}/{latestBp.Diastolic}. (Threshold {BP_SYS_HIGH}/{BP_DIA_HIGH})",
                    Time = latestBp.LoggedAt,
                    Severity = "danger"
                });
            }

            var latestG = g.FirstOrDefault();
            if (latestG != null)
            {
                if (latestG.ValueMgDl >= GLUCOSE_HIGH)
                    alerts.Add(new AlertItem { Title="High Glucose", Message=$"Glucose is {latestG.ValueMgDl} mg/dL. (High ≥ {GLUCOSE_HIGH})", Time=latestG.LoggedAt, Severity="danger" });
                else if (latestG.ValueMgDl <= GLUCOSE_LOW)
                    alerts.Add(new AlertItem { Title="Low Glucose", Message=$"Glucose is {latestG.ValueMgDl} mg/dL. (Low ≤ {GLUCOSE_LOW})", Time=latestG.LoggedAt, Severity="warn" });
            }

            if (w.Count >= 2)
            {
                var latestW = w[0];
                var prevW = w[1];

                var diff = Math.Abs(latestW.WeightKg - prevW.WeightKg);
                if (diff >= WEIGHT_SPIKE_KG)
                {
                    alerts.Add(new AlertItem
                    {
                        Title = "Sudden Weight Change",
                        Message = $"Weight changed by {diff:0.0} kg since last log. ({prevW.WeightKg} → {latestW.WeightKg})",
                        Time = latestW.LoggedAt,
                        Severity = "warn"
                    });
                }
            }

            alerts = alerts.OrderByDescending(a => a.Time).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    class AlertItem
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime Time { get; set; }
        public string Severity { get; set; } = "warn";
        public string SeverityClass => Severity == "danger" ? "danger" : "warn";
    }
}

<style>
    .ok-card{ background:#ecfdf5; border:1px solid #a7f3d0; padding:12px; border-radius:10px; max-width:900px; }
    .alerts{ display:flex; flex-direction:column; gap:10px; max-width:900px; }
    .alert-card{ background:#fff; border-radius:12px; padding:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); border-left:6px solid #f59e0b; }
    .alert-card.danger{ border-left-color:#ef4444; }
    .alert-card.warn{ border-left-color:#f59e0b; }
    .title{ display:flex; justify-content:space-between; align-items:center; }
    .time{ font-size:12px; color:#666; }
    .msg{ margin-top:6px; color:#222; }
</style>
