@page "/health-alerts"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using Model
@inject IJSRuntime JS
@inject BPLogApiService BPApi
@inject GlucoseLogApiService GlucoseApi
@inject WeightLogApiService WeightApi

<h2>🚨 Health Alerts</h2>

@if (busy)
{
    <p>Checking latest readings...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else if (alerts.Count == 0)
{
    <div class="ok-card">✅ No abnormal readings found in latest logs.</div>
}
else
{
    <div class="alerts">
        @foreach (var a in alerts)
        {
            <div class="alert-card @a.SeverityClass">
                <div class="title">
                    <strong>@a.Title</strong>
                    <span class="time">@a.Time.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                </div>
                <div class="msg">@a.Message</div>
            </div>
        }
    </div>
}

@code {
    bool busy = true;
    string error = "";
    string? userId;
    List<AlertItem> alerts = new();

    const int BP_SYS_HIGH = 140;
    const int BP_DIA_HIGH = 90;
    const int GLUCOSE_HIGH = 180;
    const int GLUCOSE_LOW = 70;
    const double WEIGHT_SPIKE_KG = 2.0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            busy = true;
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId not found.");

            var bp = (await BPApi.GetByUserAsync(userId)) ?? new();
            var g  = (await GlucoseApi.GetByUserAsync(userId)) ?? new();
            var w  = (await WeightApi.GetByUserAsync(userId)) ?? new();

            bp = bp.OrderByDescending(x => x.LoggedAt).ToList();
            g  = g.OrderByDescending(x => x.LoggedAt).ToList();
            w  = w.OrderByDescending(x => x.LoggedAt).ToList();

            var latestBp = bp.FirstOrDefault();
            if (latestBp != null &&
                (latestBp.Systolic >= BP_SYS_HIGH || latestBp.Diastolic >= BP_DIA_HIGH))
            {
                alerts.Add(new AlertItem
                {
                    Title = "High Blood Pressure",
                    Message = $"BP is {latestBp.Systolic}/{latestBp.Diastolic}.",
                    Time = latestBp.LoggedAt,
                    Severity = "danger"
                });
            }

            var latestG = g.FirstOrDefault();
            if (latestG != null)
            {
                if (latestG.ValueMgDl >= GLUCOSE_HIGH)
                    alerts.Add(new AlertItem
                    {
                        Title = "High Glucose",
                        Message = $"Glucose is {latestG.ValueMgDl} mg/dL",
                        Time = latestG.LoggedAt,
                        Severity = "danger"
                    });
                else if (latestG.ValueMgDl <= GLUCOSE_LOW)
                    alerts.Add(new AlertItem
                    {
                        Title = "Low Glucose",
                        Message = $"Glucose is {latestG.ValueMgDl} mg/dL",
                        Time = latestG.LoggedAt,
                        Severity = "warn"
                    });
            }

            if (w.Count >= 2)
            {
                var diff = Math.Abs(w[0].WeightKg - w[1].WeightKg);
                if (diff >= WEIGHT_SPIKE_KG)
                {
                    alerts.Add(new AlertItem
                    {
                        Title = "Sudden Weight Change",
                        Message = $"Weight changed by {diff:0.0} kg",
                        Time = w[0].LoggedAt,
                        Severity = "warn"
                    });
                }
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    class AlertItem
    {
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime Time { get; set; }
        public string Severity { get; set; } = "warn";
        public string SeverityClass => Severity == "danger" ? "danger" : "warn";
    }
}
