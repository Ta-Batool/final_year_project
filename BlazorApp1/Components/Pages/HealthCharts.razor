@page "/health-charts"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using Model
@inject IJSRuntime JS
@inject BPLogApiService BPApi
@inject GlucoseLogApiService GlucoseApi
@inject WeightLogApiService WeightApi

<h2>📊 Health Charts</h2>

@if (busy)
{
    <p>Loading charts...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="grid">
        <div class="card"><canvas id="bpChart"></canvas></div>
        <div class="card"><canvas id="glucoseChart"></canvas></div>
        <div class="card"><canvas id="weightChart"></canvas></div>
    </div>
}

@code {
    bool busy = true;
    string error = "";
    string? userId;

    List<BPLog> bp = new();
    List<GlucoseLog> glucose = new();
    List<WeightLog> weight = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId not found.");

            bp = await BPApi.GetByUserAsync(userId) ?? new();
            glucose = await GlucoseApi.GetByUserAsync(userId) ?? new();
            weight = await WeightApi.GetByUserAsync(userId) ?? new();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || busy || !string.IsNullOrWhiteSpace(error)) return;

        await JS.InvokeVoidAsync("healthCharts.renderLineChart",
            "glucoseChart",
            "Glucose",
            glucose.OrderBy(x => x.LoggedAt).Select(x => x.LoggedAt.ToString("MM-dd")).ToList(),
            new[] { new { label = "Glucose", data = glucose.Select(x => (double)x.ValueMgDl) } });

        await JS.InvokeVoidAsync("healthCharts.renderLineChart",
            "weightChart",
            "Weight",
            weight.OrderBy(x => x.LoggedAt).Select(x => x.LoggedAt.ToString("MM-dd")).ToList(),
            new[] { new { label = "Weight", data = weight.Select(x => x.WeightKg) } });
    }
}
