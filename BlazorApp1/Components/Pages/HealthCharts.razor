@page "/health-charts"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject HealthApiService HealthApi

<h2>📊 Health Charts</h2>

@if (busy)
{
    <p>Loading charts...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="grid">
        <div class="card"><h5>Blood Pressure</h5><canvas id="bpChart"></canvas></div>
        <div class="card"><h5>Glucose</h5><canvas id="glucoseChart"></canvas></div>
        <div class="card"><h5>Weight</h5><canvas id="weightChart"></canvas></div>
    </div>
}

@code {
    private bool busy = true;
    private bool chartsRendered = false;
    private string error = "";
    private string? userId;

    private List<BPLog> bp = new();
    private List<GlucoseLog> glucose = new();
    private List<WeightLog> weight = new();

    protected override Task OnInitializedAsync()
    {
        // Don't use JS interop here in Blazor Server
        busy = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("UserId not found in localStorage. Please login again.");

            bp = await HealthApi.GetBPAsync(userId) ?? new();
            glucose = await HealthApi.GetGlucoseAsync(userId) ?? new();
            weight = await HealthApi.GetWeightAsync(userId) ?? new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }

        // Render charts AFTER state update
        await Task.Yield();
        await RenderChartsOnce();
    }

    private async Task RenderChartsOnce()
    {
        if (chartsRendered || busy || !string.IsNullOrWhiteSpace(error)) return;
        chartsRendered = true;

        // BP
        var bpOrdered = bp.OrderBy(x => x.LoggedAt).ToList();
        var bpLabels = bpOrdered.Select(x => x.LoggedAt.ToLocalTime().ToString("MM-dd HH:mm")).ToList();
        var systolic = bpOrdered.Select(x => (double)x.Systolic).ToList();
        var diastolic = bpOrdered.Select(x => (double)x.Diastolic).ToList();

        await JS.InvokeVoidAsync("healthCharts.renderLineChart",
            "bpChart",
            "Blood Pressure (Systolic/Diastolic)",
            bpLabels,
            new object[]
            {
                new { label = "Systolic", data = systolic, tension = 0.25 },
                new { label = "Diastolic", data = diastolic, tension = 0.25 }
            });

        // Glucose
        var gOrdered = glucose.OrderBy(x => x.LoggedAt).ToList();
        var gLabels = gOrdered.Select(x => x.LoggedAt.ToLocalTime().ToString("MM-dd HH:mm")).ToList();
        var gVals = gOrdered.Select(x => (double)x.ValueMgDl).ToList();

        await JS.InvokeVoidAsync("healthCharts.renderLineChart",
            "glucoseChart",
            "Glucose (mg/dL)",
            gLabels,
            new object[]
            {
                new { label = "Glucose", data = gVals, tension = 0.25 }
            });

        // Weight
        var wOrdered = weight.OrderBy(x => x.LoggedAt).ToList();
        var wLabels = wOrdered.Select(x => x.LoggedAt.ToLocalTime().ToString("MM-dd HH:mm")).ToList();
        var wVals = wOrdered.Select(x => (double)x.WeightKg).ToList();

        await JS.InvokeVoidAsync("healthCharts.renderLineChart",
            "weightChart",
            "Weight (kg)",
            wLabels,
            new object[]
            {
                new { label = "Weight", data = wVals, tension = 0.25 }
            });
    }
}

<style>
    .grid{ display:grid; grid-template-columns: 1fr; gap: 14px; max-width: 1000px; }
    .card{ background:#fff; border-radius:12px; padding:14px; box-shadow:0 2px 8px rgba(0,0,0,0.08); }
    h5{ margin:0 0 10px 0; font-weight:600; }
</style>
