@page "/health-logs"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject BPLogApiService BPApi
@inject GlucoseLogApiService GlucoseApi
@inject WeightLogApiService WeightApi

<h2>📒 Health Logs</h2>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="tabs">
    <button class="tab-btn @(tab=="bp" ? "active" : "")" @onclick='() => tab = "bp"'>BP</button>
    <button class="tab-btn @(tab=="glucose" ? "active" : "")" @onclick='() => tab = "glucose"'>Glucose</button>
    <button class="tab-btn @(tab=="weight" ? "active" : "")" @onclick='() => tab = "weight"'>Weight</button>
</div>

@if (busy)
{
    <p>Loading...</p>
}
else
{
    @* ---------------- BP TAB ---------------- *@
    @if (tab == "bp")
    {
        <div class="card">
            <h4>Add BP Log</h4>

            <div class="grid">
                <div>
                    <label>Systolic</label>
                    <input type="number" class="form-control" @bind="bpSystolic" />
                </div>
                <div>
                    <label>Diastolic</label>
                    <input type="number" class="form-control" @bind="bpDiastolic" />
                </div>
                <div>
                    <label>Pulse (optional)</label>
                    <input type="number" class="form-control" @bind="bpPulse" />
                </div>
                <div>
                    <label>Notes</label>
                    <input class="form-control" @bind="bpNotes" />
                </div>
            </div>

            <button class="btn-primary" @onclick="AddBP" disabled="@busyAction">
                @(busyAction ? "Saving..." : "Save BP")
            </button>
        </div>

        <div class="card mt">
            <h4>Recent BP Logs</h4>

            @if (bpLogs.Count == 0)
            {
                <p>No BP logs yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Systolic</th>
                            <th>Diastolic</th>
                            <th>Pulse</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in bpLogs)
                        {
                            <tr>
                                <td>@x.LoggedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@x.Systolic</td>
                                <td>@x.Diastolic</td>
                                <td>@(x.Pulse ?? 0)</td>
                                <td>@x.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @* ---------------- GLUCOSE TAB ---------------- *@
    else if (tab == "glucose")
    {
        <div class="card">
            <h4>Add Glucose Log</h4>

            <div class="grid">
                <div>
                    <label>Value (mg/dL)</label>
                    <input type="number" class="form-control" @bind="glucoseValue" />
                </div>
                <div>
                    <label>Type</label>
                    <select class="form-control" @bind="glucoseType">
                        <option value="Fasting">Fasting</option>
                        <option value="Random">Random</option>
                        <option value="PostMeal">PostMeal</option>
                    </select>
                </div>
                <div>
                    <label>Notes</label>
                    <input class="form-control" @bind="glucoseNotes" />
                </div>
            </div>

            <button class="btn-primary" @onclick="AddGlucose" disabled="@busyAction">
                @(busyAction ? "Saving..." : "Save Glucose")
            </button>
        </div>

        <div class="card mt">
            <h4>Recent Glucose Logs</h4>

            @if (glucoseLogs.Count == 0)
            {
                <p>No glucose logs yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Value</th>
                            <th>Type</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in glucoseLogs)
                        {
                            <tr>
                                <td>@x.LoggedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@x.ValueMgDl</td>
                                <td>@x.Type</td>
                                <td>@x.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @* ---------------- WEIGHT TAB ---------------- *@
    else if (tab == "weight")
    {
        <div class="card">
            <h4>Add Weight Log</h4>

            <div class="grid">
                <div>
                    <label>Weight (kg)</label>
                    <input type="number" step="0.1" class="form-control" @bind="weightVal" />
                </div>
                <div>
                    <label>Body Fat % (optional)</label>
                    <input type="number" step="0.1" class="form-control" @bind="weightBodyFat" />
                </div>
                <div>
                    <label>Notes</label>
                    <input class="form-control" @bind="weightNotes" />
                </div>
            </div>

            <button class="btn-primary" @onclick="AddWeight" disabled="@busyAction">
                @(busyAction ? "Saving..." : "Save Weight")
            </button>
        </div>

        <div class="card mt">
            <h4>Recent Weight Logs</h4>

            @if (weightLogs.Count == 0)
            {
                <p>No weight logs yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Weight</th>
                            <th>Body Fat %</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in weightLogs)
                        {
                            <tr>
                                <td>@x.LoggedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@x.WeightKg</td>
                                <td>@(x.BodyFatPercentage ?? 0)</td>
                                <td>@x.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}

@code {
    private string tab = "bp";
    private bool busy = true;
    private bool busyAction = false;
    private string error = "";
    private string? userId;

    private List<BPLog> bpLogs = new();
    private List<GlucoseLog> glucoseLogs = new();
    private List<WeightLog> weightLogs = new();

    private int bpSystolic = 120;
    private int bpDiastolic = 80;
    private int? bpPulse = null;
    private string bpNotes = "";

    private int glucoseValue = 90;
    private string glucoseType = "Fasting";
    private string glucoseNotes = "";

    private double weightVal = 70;
    private double? weightBodyFat = null;
    private string weightNotes = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
            if (string.IsNullOrWhiteSpace(userId))
            {
                error = "UserId not found. Please login again.";
                return;
            }

            await ReloadAll();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private async Task ReloadAll()
    {
        bpLogs = await BPApi.GetByUserAsync(userId!) ?? new();
        glucoseLogs = await GlucoseApi.GetByUserAsync(userId!) ?? new();
        weightLogs = await WeightApi.GetByUserAsync(userId!) ?? new();
    }

    private async Task AddBP()
    {
        busyAction = true;
        await BPApi.CreateAsync(new BPLog
        {
            UserId = userId!,
            Systolic = bpSystolic,
            Diastolic = bpDiastolic,
            Pulse = bpPulse,
            Notes = bpNotes,
            LoggedAt = DateTime.UtcNow
        });
        await ReloadAll();
        busyAction = false;
    }

    private async Task AddGlucose()
    {
        busyAction = true;
        await GlucoseApi.CreateAsync(new GlucoseLog
        {
            UserId = userId!,
            ValueMgDl = glucoseValue,
            Type = glucoseType,
            Notes = glucoseNotes,
            LoggedAt = DateTime.UtcNow
        });
        await ReloadAll();
        busyAction = false;
    }

    private async Task AddWeight()
    {
        busyAction = true;
        await WeightApi.CreateAsync(new WeightLog
        {
            UserId = userId!,
            WeightKg = weightVal,
            BodyFatPercentage = weightBodyFat,
            Notes = weightNotes,
            LoggedAt = DateTime.UtcNow
        });
        await ReloadAll();
        busyAction = false;
    }
}
