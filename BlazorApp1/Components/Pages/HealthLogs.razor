@page "/health-logs"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject HealthApiService HealthApi

<h2>📒 Health Logs</h2>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="tabs">
    <button class="tab-btn @(tab=="bp" ? "active" : "")" @onclick='() => SwitchTab("bp")'>BP</button>
    <button class="tab-btn @(tab=="glucose" ? "active" : "")" @onclick='() => SwitchTab("glucose")'>Glucose</button>
    <button class="tab-btn @(tab=="weight" ? "active" : "")" @onclick='() => SwitchTab("weight")'>Weight</button>

    @* ✅ NEW TAB BUTTON (ADDED) *@
    <button class="tab-btn @(tab=="metabolism" ? "active" : "")" @onclick='() => SwitchTab("metabolism")'>Metabolism</button>
</div>

@if (busy)
{
    <p>Loading...</p>
}
else
{
    @if (string.IsNullOrWhiteSpace(userId))
    {
        <p class="text-muted">You are not logged in (missing userId).</p>
    }
    else
    {
        @if (tab == "bp")
        {
            <div class="card">
                <h4>Add BP Log</h4>

                <div class="grid">
                    <input type="number" class="form-control" placeholder="Systolic" @bind="bpSystolic" />
                    <input type="number" class="form-control" placeholder="Diastolic" @bind="bpDiastolic" />
                    <input type="number" class="form-control" placeholder="Pulse (optional)" @bind="bpPulse" />
                    <input class="form-control" placeholder="Notes" @bind="bpNotes" />
                </div>

                <button class="btn-primary" @onclick="AddBP" disabled="@actionBusy">
                    @(actionBusy ? "Saving..." : "Save BP")
                </button>
            </div>

            <div class="card mt">
                <h4>Recent BP Logs</h4>

                @if (bpLogs is null || bpLogs.Count == 0)
                {
                    <p class="text-muted">No BP logs yet.</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Systolic</th>
                                <th>Diastolic</th>
                                <th>Pulse</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in bpLogs)
                            {
                                <tr>
                                    <td>@FormatDate(x.LoggedAt)</td>
                                    <td>@x.Systolic</td>
                                    <td>@x.Diastolic</td>
                                    <td>@(x.Pulse?.ToString() ?? "-")</td>
                                    <td>@(x.Notes ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else if (tab == "glucose")
        {
            <div class="card">
                <h4>Add Glucose Log</h4>

                <div class="grid">
                    <input type="number" class="form-control" placeholder="Value (mg/dL)" @bind="glucoseValue" />
                    <select class="form-control" @bind="glucoseType">
                        <option value="Fasting">Fasting</option>
                        <option value="Random">Random</option>
                        <option value="PostMeal">PostMeal</option>
                    </select>
                    <input class="form-control" placeholder="Notes" @bind="glucoseNotes" />
                </div>

                <button class="btn-primary" @onclick="AddGlucose" disabled="@actionBusy">
                    @(actionBusy ? "Saving..." : "Save Glucose")
                </button>
            </div>

            <div class="card mt">
                <h4>Recent Glucose Logs</h4>

                @if (glucoseLogs is null || glucoseLogs.Count == 0)
                {
                    <p class="text-muted">No glucose logs yet.</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Value</th>
                                <th>Type</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in glucoseLogs)
                            {
                                <tr>
                                    <td>@FormatDate(x.LoggedAt)</td>
                                    <td>@x.ValueMgDl</td>
                                    <td>@x.Type</td>
                                    <td>@(x.Notes ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else if (tab == "weight")
        {
            <div class="card">
                <h4>Add Weight Log</h4>

                <div class="grid">
                    <input type="number" step="0.1" class="form-control" placeholder="Weight (kg)" @bind="weightVal" />
                    <input class="form-control" placeholder="Notes" @bind="weightNotes" />
                </div>

                <button class="btn-primary" @onclick="AddWeight" disabled="@actionBusy">
                    @(actionBusy ? "Saving..." : "Save Weight")
                </button>
            </div>

            <div class="card mt">
                <h4>Recent Weight Logs</h4>

                @if (weightLogs is null || weightLogs.Count == 0)
                {
                    <p class="text-muted">No weight logs yet.</p>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Weight (kg)</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var x in weightLogs)
                            {
                                <tr>
                                    <td>@FormatDate(x.LoggedAt)</td>
                                    <td>@x.WeightKg</td>
                                    <td>@(x.Notes ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        @* ✅ NEW TAB CONTENT (ADDED) *@
        else if (tab == "metabolism")
        {
            <div class="card">
                <h4>🔥 Metabolism Calculator (BMR + Maintenance)</h4>

                <p class="text-muted">
                    Uses <b>Mifflin–St Jeor</b> equation. Weight is automatically pulled from your <b>latest Weight Log</b>.
                </p>

                @if (latestWeight <= 0)
                {
                    <div class="alert alert-warning">
                        Please add at least one <b>Weight Log</b> first — metabolism needs weight.
                    </div>
                }

                <div class="grid">
                    <input type="number" class="form-control" placeholder="Age (years)" @bind="metaAge" />
                    <input type="number" step="0.1" class="form-control" placeholder="Height (cm)" @bind="metaHeightCm" />

                    <select class="form-control" @bind="metaGender">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>

                    <select class="form-control" @bind="metaActivityFactor">
                        <option value="1.2">Sedentary (little/no exercise)</option>
                        <option value="1.375">Lightly active (1–3 days/week)</option>
                        <option value="1.55">Moderately active (3–5 days/week)</option>
                        <option value="1.725">Very active (6–7 days/week)</option>
                    </select>
                </div>

                <button class="btn-primary mt" @onclick="CalculateMetabolism" disabled="@actionBusy">
                    Calculate
                </button>

                @if (!string.IsNullOrWhiteSpace(metaError))
                {
                    <div class="alert alert-danger mt">@metaError</div>
                }

                @if (bmr > 0 && maintenanceCalories > 0)
                {
                    <div class="card mt">
                        <h5>Results</h5>
                        <p><b>Latest Weight:</b> @latestWeight kg</p>
                        <p><b>BMR:</b> @bmr kcal/day</p>
                        <p><b>Maintenance Calories:</b> @maintenanceCalories kcal/day</p>
                    </div>
                }
            </div>

            <div class="card mt">
                <h4>📌 Notes (for viva)</h4>
                <ul>
                    <li><b>BMR</b> = calories body burns at rest (basic functions).</li>
                    <li><b>Maintenance</b> = BMR × activity factor (estimated daily requirement).</li>
                    <li>Because weight logs change over time, BMR and maintenance can update dynamically.</li>
                </ul>
            </div>
        }
    }
}

@code {
    private string tab = "bp";
    private bool busy = true;
    private bool actionBusy = false;

    private string? userId;
    private string error = "";

    private List<BPLog> bpLogs = new();
    private List<GlucoseLog> glucoseLogs = new();
    private List<WeightLog> weightLogs = new();

    private int bpSystolic = 120;
    private int bpDiastolic = 80;
    private int? bpPulse;
    private string bpNotes = "";

    private int glucoseValue = 90;
    private string glucoseType = "Fasting";
    private string glucoseNotes = "";

    private double weightVal = 70;
    private string weightNotes = "";

    // ✅ METABOLISM (NEW STATE)
    private int metaAge = 25;
    private double metaHeightCm = 170;
    private string metaGender = "Male";
    private double metaActivityFactor = 1.2;

    private double latestWeight = 0;
    private int bmr = 0;
    private int maintenanceCalories = 0;
    private string metaError = "";

    protected override Task OnInitializedAsync()
    {
        // IMPORTANT (Blazor Server): don't do JS interop here
        busy = true;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // ✅ JS Interop is safe here
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");

            if (string.IsNullOrWhiteSpace(userId))
            {
                error = "User not logged in. (userId missing in localStorage)";
                return;
            }

            await ReloadAll();
        }
        catch (Exception ex)
        {
            error = $"Initialization failed: {ex.Message}";
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private void SwitchTab(string t)
    {
        tab = t;
    }

    private async Task ReloadAll()
    {
        if (string.IsNullOrWhiteSpace(userId)) return;

        try
        {
            bpLogs = await HealthApi.GetBPAsync(userId) ?? new();
            glucoseLogs = await HealthApi.GetGlucoseAsync(userId) ?? new();
            weightLogs = await HealthApi.GetWeightAsync(userId) ?? new();

            // optional: sort newest first if you want
            bpLogs = bpLogs.OrderByDescending(x => x.LoggedAt).ToList();
            glucoseLogs = glucoseLogs.OrderByDescending(x => x.LoggedAt).ToList();
            weightLogs = weightLogs.OrderByDescending(x => x.LoggedAt).ToList();

            // ✅ NEW: always keep latest weight ready for metabolism
            latestWeight = weightLogs.FirstOrDefault()?.WeightKg ?? 0;

            // Optional: if user already calculated, recalc when weight changes
            // (only if results already exist)
            if (bmr > 0 && maintenanceCalories > 0 && latestWeight > 0)
            {
                CalculateMetabolism();
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load logs: {ex.Message}";
            bpLogs = new();
            glucoseLogs = new();
            weightLogs = new();
            latestWeight = 0;
        }
    }

    private async Task AddBP()
    {
        if (string.IsNullOrWhiteSpace(userId)) { error = "Not logged in."; return; }

        actionBusy = true;
        error = "";

        try
        {
            await HealthApi.AddBPAsync(new BPLog
            {
                UserId = userId,
                Systolic = bpSystolic,
                Diastolic = bpDiastolic,
                Pulse = bpPulse,
                Notes = bpNotes
            });

            await ReloadAll();
        }
        catch (Exception ex)
        {
            error = $"Failed to save BP: {ex.Message}";
        }
        finally
        {
            actionBusy = false;
        }
    }

    private async Task AddGlucose()
    {
        if (string.IsNullOrWhiteSpace(userId)) { error = "Not logged in."; return; }

        actionBusy = true;
        error = "";

        try
        {
            await HealthApi.AddGlucoseAsync(new GlucoseLog
            {
                UserId = userId,
                ValueMgDl = glucoseValue,
                Type = glucoseType,
                Notes = glucoseNotes
            });

            await ReloadAll();
        }
        catch (Exception ex)
        {
            error = $"Failed to save glucose: {ex.Message}";
        }
        finally
        {
            actionBusy = false;
        }
    }

    private async Task AddWeight()
    {
        if (string.IsNullOrWhiteSpace(userId)) { error = "Not logged in."; return; }

        actionBusy = true;
        error = "";

        try
        {
            await HealthApi.AddWeightAsync(new WeightLog
            {
                UserId = userId,
                WeightKg = weightVal,
                Notes = weightNotes
            });

            await ReloadAll();
        }
        catch (Exception ex)
        {
            error = $"Failed to save weight: {ex.Message}";
        }
        finally
        {
            actionBusy = false;
        }
    }

    // ✅ NEW: Metabolism Calculation
    private void CalculateMetabolism()
    {
        metaError = "";

        if (latestWeight <= 0)
        {
            metaError = "Please add a Weight Log first.";
            bmr = 0;
            maintenanceCalories = 0;
            return;
        }

        if (metaAge <= 0 || metaHeightCm <= 0)
        {
            metaError = "Age and height must be greater than 0.";
            bmr = 0;
            maintenanceCalories = 0;
            return;
        }

        // Mifflin–St Jeor
        double rawBmr =
            (10 * latestWeight) +
            (6.25 * metaHeightCm) -
            (5 * metaAge);

        rawBmr += (metaGender == "Male") ? 5 : -161;

        bmr = (int)Math.Round(rawBmr);
        maintenanceCalories = (int)Math.Round(bmr * metaActivityFactor);
    }

    private static string FormatDate(DateTime dt)
    {
        // avoids exceptions and gives consistent display
        try { return dt.ToLocalTime().ToString("yyyy-MM-dd hh:mm tt"); }
        catch { return dt.ToString(); }
    }
}
