@page "/health-logs"
@attribute [Authorize]
@layout BlazorApp1.Components.Layout.UserDashboardLayout

@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Service
@using Model
@inject IJSRuntime JS
@inject HealthApiService HealthApi

<h2>📒 Health Logs</h2>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="tabs">
    <button class="tab-btn @(tab=="bp" ? "active" : "")" @onclick='() => tab = "bp"'>BP</button>
    <button class="tab-btn @(tab=="glucose" ? "active" : "")" @onclick='() => tab = "glucose"'>Glucose</button>
    <button class="tab-btn @(tab=="weight" ? "active" : "")" @onclick='() => tab = "weight"'>Weight</button>
</div>

@if (busy)
{
    <p>Loading...</p>
}
else
{
    @if (tab == "bp")
    {
        <div class="card">
            <h4>Add BP Log</h4>

            <div class="grid">
                <input type="number" class="form-control" placeholder="Systolic" @bind="bpSystolic" />
                <input type="number" class="form-control" placeholder="Diastolic" @bind="bpDiastolic" />
                <input type="number" class="form-control" placeholder="Pulse (optional)" @bind="bpPulse" />
                <input class="form-control" placeholder="Notes" @bind="bpNotes" />
            </div>

            <button class="btn-primary" @onclick="AddBP">Save BP</button>
        </div>
    }

    else if (tab == "glucose")
    {
        <div class="card">
            <h4>Add Glucose Log</h4>

            <div class="grid">
                <input type="number" class="form-control" placeholder="Value (mg/dL)" @bind="glucoseValue" />
                <select class="form-control" @bind="glucoseType">
                    <option>Fasting</option>
                    <option>Random</option>
                    <option>PostMeal</option>
                </select>
                <input class="form-control" placeholder="Notes" @bind="glucoseNotes" />
            </div>

            <button class="btn-primary" @onclick="AddGlucose">Save Glucose</button>
        </div>
    }

    else if (tab == "weight")
    {
        <div class="card">
            <h4>Add Weight Log</h4>

            <div class="grid">
                <input type="number" step="0.1" class="form-control" placeholder="Weight (kg)" @bind="weightVal" />
                <input class="form-control" placeholder="Notes" @bind="weightNotes" />
            </div>

            <button class="btn-primary" @onclick="AddWeight">Save Weight</button>
        </div>

        <div class="card mt">
            <h4>Recent Weight Logs</h4>

            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Weight (kg)</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in weightLogs)
                    {
                        <tr>
                            <td>@x.LoggedAt.ToLocalTime()</td>
                            <td>@x.WeightKg</td>
                            <td>@x.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    string tab = "bp";
    bool busy = true;
    string? userId;
    string error = "";

    List<BPLog> bpLogs = new();
    List<GlucoseLog> glucoseLogs = new();
    List<WeightLog> weightLogs = new();

    int bpSystolic = 120;
    int bpDiastolic = 80;
    int? bpPulse;
    string bpNotes = "";

    int glucoseValue = 90;
    string glucoseType = "Fasting";
    string glucoseNotes = "";

    double weightVal = 70;
    string weightNotes = "";

    protected override async Task OnInitializedAsync()
    {
        userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");
        if (string.IsNullOrWhiteSpace(userId))
        {
            error = "User not logged in.";
            return;
        }

        await ReloadAll();
        busy = false;
    }

    async Task ReloadAll()
    {
        bpLogs = await HealthApi.GetBPAsync(userId!) ?? new();
        glucoseLogs = await HealthApi.GetGlucoseAsync(userId!) ?? new();
        weightLogs = await HealthApi.GetWeightAsync(userId!) ?? new();
    }

    async Task AddBP()
    {
        await HealthApi.AddBPAsync(new BPLog
        {
            UserId = userId!,
            Systolic = bpSystolic,
            Diastolic = bpDiastolic,
            Pulse = bpPulse,
            Notes = bpNotes
        });
        await ReloadAll();
    }

    async Task AddGlucose()
    {
        await HealthApi.AddGlucoseAsync(new GlucoseLog
        {
            UserId = userId!,
            ValueMgDl = glucoseValue,
            Type = glucoseType,
            Notes = glucoseNotes
        });
        await ReloadAll();
    }

    async Task AddWeight()
    {
        await HealthApi.AddWeightAsync(new WeightLog
        {
            UserId = userId!,
            WeightKg = weightVal,
            Notes = weightNotes
        });
        await ReloadAll();
    }
}


