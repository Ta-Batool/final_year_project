@page "/medication-compliance"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Model
@using BlazorApp1.Components.Layout
@using BlazorApp1.Service
@inject IMedicationHttpService MedicationService
@inject IJSRuntime JS
@layout UserDashboardLayout

<h2>Medication Compliance</h2>

<p class="subtitle">
    Track your prescribed medicines and mark today’s doses as taken.
</p>

@if (isLoading)
{
    <p>Loading your medications...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="medication-grid">
        <!-- LEFT: Add Medication Plan -->
        <div class="card">
            <h3>Add Medication</h3>

            <EditForm Model="@newPlan" OnValidSubmit="AddMedication">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label>Medicine Name</label>
                    <InputText @bind-Value="newPlan.Name" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Dosage (e.g. 500 mg after breakfast)</label>
                    <InputText @bind-Value="newPlan.Dosage" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Time of day (HH:MM)</label>
                    <InputText @bind-Value="newPlan.TimeOfDay" class="form-control" />
                    <small>Example: 08:00, 20:00</small>
                </div>

                <div class="form-group">
                    <label>Start date</label>
                    <InputDate @bind-Value="newPlan.StartDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label>End date (optional)</label>
                    <InputDate @bind-Value="newPlan.EndDate" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <InputTextArea @bind-Value="newPlan.Notes" class="form-control" />
                </div>

                <button type="submit" class="btn-primary" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Medication")
                </button>
            </EditForm>
        </div>

        <!-- RIGHT: Today’s meds with compliance -->
        <div class="card">
            <h3>Today’s Medications</h3>

            @if (!planRows.Any())
            {
                <p>No medications added yet.</p>
            }
            else
            {
                <ul class="med-list">
                    @foreach (var row in planRows)
                    {
                        <li class="med-item">
                            <div class="med-main">
                                <strong>@row.Plan.Name</strong>
                                <span class="dose">@row.Plan.Dosage</span>
                                <span class="time">@row.Plan.TimeOfDay</span>
                            </div>

                            <div class="med-meta">
                                <span>Start: @row.Plan.StartDate.ToShortDateString()</span>
                                @if (row.Plan.EndDate.HasValue)
                                {
                                    <span>End: @row.Plan.EndDate.Value.ToShortDateString()</span>
                                }
                            </div>

                            <div class="med-actions">
                                <label>
                                    <input type="checkbox"
                                           @bind="row.IsTakenToday"
                                           @bind:after="() => OnTakenChanged(row)" />
                                    Taken today
                                </label>

                                <button class="btn-danger" @onclick="() => DeleteMedication(row)" disabled="@row.IsDeleting">
                                    @(row.IsDeleting ? "Removing..." : "Remove")
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="card summary-card">
        <h3>Today’s Summary</h3>
        <p>
            Total medicines: <strong>@planRows.Count</strong> |
            Taken today: <strong>@planRows.Count(r => r.IsTakenToday)</strong>
        </p>
    </div>
}

@code {
    // One row in the UI
    public class MedicationPlanRow
    {
        public MedicationPlan Plan { get; set; } = new MedicationPlan();
        public string? LogId { get; set; }
        public bool IsTakenToday { get; set; }
        public bool IsDeleting { get; set; }
    }

    private string? userId;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    private MedicationPlan newPlan = new MedicationPlan
    {
        StartDate = DateTime.UtcNow.Date
    };

    private List<MedicationPlanRow> planRows = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // We stored userId in localStorage in GoogleCallBack.razor
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");

            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not found. Please login again.";
                return;
            }

            // 1) Load all plans
            var plans = await MedicationService.GetPlansAsync(userId) ?? new List<MedicationPlan>();

            // 2) Load today logs
            var logs = await MedicationService.GetTodayLogsAsync(userId) ?? new List<MedicationLog>();

            // 3) Create UI rows and map logs -> rows
            planRows = plans.Select(p =>
            {
                var row = new MedicationPlanRow { Plan = p };

                var log = logs.FirstOrDefault(l => l.PlanId == p.Id);
                if (log != null)
                {
                    row.LogId = log.Id;
                    row.IsTakenToday = log.Status == MedicationStatus.Taken;
                }

                return row;
            }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load medications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddMedication()
    {
        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "User ID is missing.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            newPlan.UserId = userId;

            var created = await MedicationService.CreatePlanAsync(newPlan);
            if (created != null)
            {
                planRows.Add(new MedicationPlanRow
                {
                    Plan = created,
                    IsTakenToday = false
                });
            }

            // reset form
            newPlan = new MedicationPlan
            {
                StartDate = DateTime.UtcNow.Date
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save medication: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteMedication(MedicationPlanRow row)
    {
        if (row.Plan.Id == null)
        {
            planRows.Remove(row);
            return;
        }

        row.IsDeleting = true;
        errorMessage = null;

        try
        {
            await MedicationService.DeletePlanAsync(row.Plan.Id);
            planRows.Remove(row);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete medication: {ex.Message}";
            row.IsDeleting = false;
        }
    }

    private async Task OnTakenChanged(MedicationPlanRow row)
    {
        if (string.IsNullOrEmpty(row.LogId))
        {
            // If no log for today, revert checkbox and show message
            row.IsTakenToday = !row.IsTakenToday;
            errorMessage = "No log entry found for today's dose.";
            return;
        }

        try
        {
            var newStatus = row.IsTakenToday ? MedicationStatus.Taken : MedicationStatus.Pending;
            await MedicationService.UpdateLogStatusAsync(row.LogId, newStatus);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update status: {ex.Message}";
        }
    }
}


<style>
    .subtitle {
        color: #777;
        margin-bottom: 20px;
    }

    .medication-grid {
        display: grid;
        grid-template-columns: 1.2fr 1.5fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .card {
        background: #fff;
        padding: 16px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .form-group {
        margin-bottom: 10px;
    }

    .form-control {
        width: 100%;
        padding: 6px 8px;
        border-radius: 6px;
        border: 1px solid #ccc;
        font-size: 14px;
    }

    .btn-primary {
        background: #3b3bbf;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 14px;
        cursor: pointer;
        font-size: 14px;
    }

    .btn-primary[disabled] {
        opacity: 0.6;
        cursor: default;
    }

    .med-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .med-item {
        padding: 10px 8px;
        border-bottom: 1px solid #eee;
    }

    .med-main {
        display: flex;
        gap: 12px;
        align-items: baseline;
    }

    .med-main .dose {
        color: #555;
        font-size: 13px;
    }

    .med-main .time {
        font-size: 12px;
        color: #888;
    }

    .med-meta {
        margin-top: 4px;
        font-size: 12px;
        color: #777;
        display: flex;
        gap: 12px;
    }

    .med-actions {
        margin-top: 6px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
    }

    .btn-danger {
        background: #ff4d4d;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 4px 10px;
        cursor: pointer;
        font-size: 13px;
    }

    .summary-card {
        margin-top: 10px;
    }
</style>
