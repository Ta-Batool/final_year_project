@code {
    // One row in the UI
    public class MedicationPlanRow
    {
        public MedicationPlan Plan { get; set; } = new MedicationPlan();
        public string? LogId { get; set; }
        public bool IsTakenToday { get; set; }
        public bool IsDeleting { get; set; }
    }

    private string? userId;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    private MedicationPlan newPlan = new MedicationPlan
    {
        StartDate = DateTime.UtcNow.Date
    };

    private List<MedicationPlanRow> planRows = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // We stored userId in localStorage in GoogleCallBack.razor
            userId = await JS.InvokeAsync<string?>("localStorage.getItem", "userId");

            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "User ID not found. Please login again.";
                return;
            }

            // 1) Load all plans
            var plans = await MedicationService.GetPlansAsync(userId) ?? new List<MedicationPlan>();

            // 2) Load today logs
            var logs = await MedicationService.GetTodayLogsAsync(userId) ?? new List<MedicationLog>();

            // 3) Create UI rows and map logs -> rows
            planRows = plans.Select(p =>
            {
                var row = new MedicationPlanRow { Plan = p };

                var log = logs.FirstOrDefault(l => l.PlanId == p.Id);
                if (log != null)
                {
                    row.LogId = log.Id;
                    row.IsTakenToday = log.Status == MedicationStatus.Taken;
                }

                return row;
            }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load medications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddMedication()
    {
        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "User ID is missing.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            newPlan.UserId = userId;

            var created = await MedicationService.CreatePlanAsync(newPlan);
            if (created != null)
            {
                planRows.Add(new MedicationPlanRow
                {
                    Plan = created,
                    IsTakenToday = false
                });
            }

            // reset form
            newPlan = new MedicationPlan
            {
                StartDate = DateTime.UtcNow.Date
            };
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save medication: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteMedication(MedicationPlanRow row)
    {
        if (row.Plan.Id == null)
        {
            planRows.Remove(row);
            return;
        }

        row.IsDeleting = true;
        errorMessage = null;

        try
        {
            await MedicationService.DeletePlanAsync(row.Plan.Id);
            planRows.Remove(row);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete medication: {ex.Message}";
            row.IsDeleting = false;
        }
    }

    private async Task OnTakenChanged(MedicationPlanRow row)
    {
        if (string.IsNullOrEmpty(row.LogId))
        {
            // If no log for today, revert checkbox and show message
            row.IsTakenToday = !row.IsTakenToday;
            errorMessage = "No log entry found for today's dose.";
            return;
        }

        try
        {
            var newStatus = row.IsTakenToday ? MedicationStatus.Taken : MedicationStatus.Pending;
            await MedicationService.UpdateLogStatusAsync(row.LogId, newStatus);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update status: {ex.Message}";
        }
    }
}
