@page "/patient/coach"
@using System.Security.Claims
@using System.Net
@using System.Net.Http.Json
@using System.Text.Json

@layout BlazorApp1.Components.Layout.UserDashboardLayout
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState

<h3>Fitness Coach Chatbot</h3>

@if (loading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="card p-3 mb-3 shadow-sm">
        <div><b>ClientId:</b> @clientId</div>
        <div><b>Premium:</b> @(isPremium ? "Yes ✅" : "No ❌")</div>

        @if (!isPremium)
        {
            <a class="btn btn-warning mt-2" href="/patient/subscribe">Upgrade to Premium</a>
        }
    </div>

    <div class="card p-3 mb-3 shadow-sm">
        <h5 class="mb-3">Monthly Health Data</h5>

        <div class="d-flex gap-2 mb-3">
            <input class="form-control" type="number" @bind="year" />
            <input class="form-control" type="number" @bind="month" min="1" max="12" />
            <button class="btn btn-primary" @onclick="LoadSummaryAndAiPlan">
                Load AI Plan
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(summaryError))
        {
            <div class="alert alert-danger mb-0">@summaryError</div>
        }
        else if (summaryModel is not null)
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Check-ins</div>
                        <div class="fs-4 fw-bold">@summaryModel.Checkins</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Average Steps</div>
                        <div class="fs-4 fw-bold">@summaryModel.AvgSteps</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">Avg Exercise Minutes</div>
                        <div class="fs-4 fw-bold">@summaryModel.AvgExerciseMinutes</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6>Weight & BMI</h6>

                        @if (summaryModel.StartWeightKg is not null && summaryModel.EndWeightKg is not null)
                        {
                            <p><b>Start Weight:</b> @summaryModel.StartWeightKg kg</p>
                            <p><b>End Weight:</b> @summaryModel.EndWeightKg kg</p>
                            <p><b>Change:</b> @summaryModel.ChangeKg kg</p>
                            <p><b>BMI:</b> @summaryModel.BmiStart → @summaryModel.BmiEnd</p>
                        }
                        else
                        {
                            <p class="text-warning">
                                No weight or height data found yet.
                            </p>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h6>Meal Data</h6>
                        <p><b>Meals Logged:</b> @summaryModel.MealsLogged</p>
                        <p><b>Meal Days:</b> @summaryModel.MealDays</p>
                        <p><b>Total Calories:</b> @summaryModel.TotalCalories</p>
                        <p><b>Average Calories:</b> @summaryModel.AvgCalories</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card p-3 shadow-sm">
        <h5 class="mb-3">AI Coach</h5>

        <div class="chat-box mb-3">
            @if (messages.Count == 0)
            {
                <div class="text-muted">Ask your fitness coach anything.</div>
            }
            else
            {
                @foreach (var m in messages)
                {
                    <div class="mb-3 p-3 rounded @(m.Role == "You" ? "user-msg" : "coach-msg")">
                        <div class="fw-bold mb-1">@m.Role</div>
                        <div style="white-space: pre-line;">@m.Text</div>
                    </div>
                }
            }
        </div>

        <div class="d-flex gap-2">
            <input class="form-control"
                   @bind="input"
                   @bind:event="oninput"
                   placeholder="Ask about your diet, workout, weight, calories..." />

            <button class="btn btn-success" @onclick="Send" disabled="@sending">
                @(sending ? "Sending..." : "Send")
            </button>
        </div>
    </div>
}

@code {
    bool loading = true;
    bool sending = false;
    bool loadingAiPlan = false;

    string error = "";
    string clientId = "";
    bool isPremium = false;

    int year = DateTime.UtcNow.Year;
    int month = DateTime.UtcNow.Month;

    string? summaryError;
    MonthlySummaryDto? summaryModel;
    string input = "";

    List<ChatMessageVm> messages = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;

            var email = user.FindFirst(ClaimTypes.Email)?.Value
                        ?? user.FindFirst("email")?.Value
                        ?? "";

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Not logged in.";
                return;
            }

            var resp = await Http.GetAsync($"api/Clients/{Uri.EscapeDataString(email)}");

            if (resp.StatusCode == HttpStatusCode.NotFound)
            {
                error = "Client not found for this email.";
                return;
            }

            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                error = $"Client API failed ({(int)resp.StatusCode}): {body}";
                return;
            }

            var client = JsonSerializer.Deserialize<ClientDto>(
                body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (client is null || string.IsNullOrWhiteSpace(client.Id))
            {
                error = "Client data invalid.";
                return;
            }

            clientId = client.Id;
            isPremium = client.IsPremium;

            await LoadSummaryAndAiPlan();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    async Task LoadSummaryAndAiPlan()
    {
        await LoadSummary();
        await AskAiCoachForMonthlyPlan();
    }

    async Task LoadSummary()
    {
        summaryError = null;
        summaryModel = null;

        if (string.IsNullOrWhiteSpace(clientId))
            return;

        try
        {
            var resp = await Http.GetAsync($"api/FitnessCoach/summary/{clientId}/{year}/{month}");
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                summaryError = $"Summary API failed ({(int)resp.StatusCode}): {body}";
                return;
            }

            summaryModel = JsonSerializer.Deserialize<MonthlySummaryDto>(
                body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (summaryModel is null)
                summaryError = "Failed to parse summary response.";
        }
        catch (Exception ex)
        {
            summaryError = ex.Message;
        }
    }

    async Task AskAiCoachForMonthlyPlan()
    {
        if (string.IsNullOrWhiteSpace(clientId) || loadingAiPlan)
            return;

        loadingAiPlan = true;

        messages.Add(new ChatMessageVm
        {
            Role = "Coach",
            Text = "Analyzing your monthly health, meals, calories, weight, and activity data..."
        });

        var req = new CoachChatRequest
        {
            ClientId = clientId,
            Year = year,
            Month = month,
            Message = "Analyze my monthly health data, meal logs, calories, weight, BMI, exercise, steps, sleep, and water intake. Give me a personalized fitness and nutrition plan."
        };

        try
        {
            var resp = await Http.PostAsJsonAsync("api/FitnessCoach/chat", req);
            var body = await resp.Content.ReadAsStringAsync();

            messages.RemoveAt(messages.Count - 1);

            if (!resp.IsSuccessStatusCode)
            {
                messages.Add(new ChatMessageVm
                {
                    Role = "Coach",
                    Text = $"AI coach failed ({(int)resp.StatusCode}): {body}"
                });
                return;
            }

            var coachReply = JsonSerializer.Deserialize<CoachChatResponseDto>(
                body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            messages.Add(new ChatMessageVm
            {
                Role = "Coach",
                Text = coachReply?.Reply ?? "No AI response received."
            });
        }
        catch (Exception ex)
        {
            messages.RemoveAt(messages.Count - 1);

            messages.Add(new ChatMessageVm
            {
                Role = "Coach",
                Text = ex.Message
            });
        }
        finally
        {
            loadingAiPlan = false;
        }
    }

    async Task Send()
    {
        if (string.IsNullOrWhiteSpace(input) || string.IsNullOrWhiteSpace(clientId) || sending)
            return;

        var myMsg = input;

        messages.Add(new ChatMessageVm
        {
            Role = "You",
            Text = myMsg
        });

        input = "";
        sending = true;

        var req = new CoachChatRequest
        {
            ClientId = clientId,
            Message = myMsg,
            Year = year,
            Month = month
        };

        try
        {
            var resp = await Http.PostAsJsonAsync("api/FitnessCoach/chat", req);
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                messages.Add(new ChatMessageVm
                {
                    Role = "Coach",
                    Text = $"Chat API failed ({(int)resp.StatusCode}): {body}"
                });
                return;
            }

            var coachReply = JsonSerializer.Deserialize<CoachChatResponseDto>(
                body,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            messages.Add(new ChatMessageVm
            {
                Role = "Coach",
                Text = coachReply?.Reply ?? "No AI response received."
            });
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessageVm
            {
                Role = "Coach",
                Text = ex.Message
            });
        }
        finally
        {
            sending = false;
        }
    }

    class ChatMessageVm
    {
        public string Role { get; set; } = "";
        public string Text { get; set; } = "";
    }

    class ClientDto
    {
        public string Id { get; set; } = "";
        public bool IsPremium { get; set; }
    }

    class CoachChatRequest
    {
        public string ClientId { get; set; } = "";
        public string Message { get; set; } = "";
        public int Year { get; set; }
        public int Month { get; set; }
    }

    class CoachChatResponseDto
    {
        public string ClientId { get; set; } = "";
        public int Year { get; set; }
        public int Month { get; set; }
        public string? Reply { get; set; }
        public MonthlySummaryDto? Context { get; set; }
    }

    class MonthlySummaryDto
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public bool HasData { get; set; }
        public string? Message { get; set; }

        public int Checkins { get; set; }
        public int MealsLogged { get; set; }
        public int MealDays { get; set; }
        public int TotalCalories { get; set; }
        public double AvgCalories { get; set; }

        public double? StartWeightKg { get; set; }
        public double? EndWeightKg { get; set; }
        public double? ChangeKg { get; set; }
        public double? BmiStart { get; set; }
        public double? BmiEnd { get; set; }

        public double AvgSteps { get; set; }
        public double AvgExerciseMinutes { get; set; }
        public double AvgSleepHours { get; set; }
        public double AvgWaterCups { get; set; }
    }
}

<style>
    .chat-box {
        height: 360px;
        overflow-y: auto;
        border: 1px solid #ddd;
        padding: 12px;
        border-radius: 10px;
        background: #fafafa;
    }

    .user-msg {
        background: #eef2ff;
        border: 1px solid #d8ddff;
    }

    .coach-msg {
        background: white;
        border: 1px solid #e5e5e5;
    }
</style>