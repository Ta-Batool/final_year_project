@page "/patient/coach"
@using System.Security.Claims
@using System.Net
@using System.Net.Http.Json

@layout BlazorApp1.Components.Layout.DashboardLayout
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState

<h3>Fitness Coach Chatbot</h3>

@if (loading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <div class="card p-3 mb-3">
        <div><b>ClientId:</b> @clientId</div>
        <div><b>Premium:</b> @(isPremium ? "Yes ✅" : "No ❌")</div>
        @if (!isPremium)
        {
            <a class="btn btn-warning mt-2" href="/patient/subscribe">Upgrade to Premium</a>
        }
    </div>

    <div class="card p-3 mb-3">
        <h5>Monthly Summary</h5>
        <div class="d-flex gap-2 mb-2">
            <input class="form-control" type="number" @bind="year" />
            <input class="form-control" type="number" @bind="month" min="1" max="12" />
            <button class="btn btn-primary" @onclick="LoadSummary">Load</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(summary))
        {
            <pre style="white-space:pre-wrap">@summary</pre>
        }
    </div>

    <div class="card p-3">
        <h5>Chat</h5>

        <div style="height:260px; overflow:auto; border:1px solid #ddd; padding:10px; border-radius:8px;" class="mb-2">
            @foreach (var m in messages)
            {
                <div class="mb-2">
                    <b>@m.Role:</b> @m.Text
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <input class="form-control" @bind="input" placeholder="Tell me your food + exercise today..." />
            <button class="btn btn-success" @onclick="Send">Send</button>
        </div>
    </div>
}

@code {
    bool loading = true;
    string error = "";

    string clientId = "";
    bool isPremium = false;

    int year = DateTime.UtcNow.Year;
    int month = DateTime.UtcNow.Month;

    string? summary;
    string input = "";

    List<(string Role, string Text)> messages = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;

            var email = user.FindFirst(ClaimTypes.Email)?.Value
                        ?? user.FindFirst("email")?.Value
                        ?? "";

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Not logged in (no email claim).";
                return;
            }

            var url = $"api/Clients/{Uri.EscapeDataString(email)}";
            var resp = await Http.GetAsync(url);

            if (resp.StatusCode == HttpStatusCode.NotFound)
            {
                error = "Client not found for this email. Create a client record on signup/login.";
                return;
            }

            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                error = $"Client API failed ({(int)resp.StatusCode}): {body}";
                return;
            }

            var client = System.Text.Json.JsonSerializer.Deserialize<ClientDto>(
                body,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

            if (client is null || string.IsNullOrWhiteSpace(client.Id))
            {
                error = "Client data invalid / missing Id.";
                return;
            }

            clientId = client.Id;
            isPremium = client.IsPremium;

            await LoadSummary();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    async Task LoadSummary()
    {
        summary = null;

        if (string.IsNullOrWhiteSpace(clientId))
            return;

        try
        {
            var resp = await Http.GetAsync($"api/FitnessCoach/summary/{clientId}/{year}/{month}");
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                summary = $"Summary API failed ({(int)resp.StatusCode}): {body}";
                return;
            }

            summary = body;
        }
        catch (Exception ex)
        {
            summary = ex.Message;
        }
    }

    async Task Send()
    {
        if (string.IsNullOrWhiteSpace(input))
            return;

        messages.Add(("You", input));
        var myMsg = input;
        input = "";

        var req = new CoachChatRequest
        {
            ClientId = clientId,
            Message = myMsg,
            Year = year,
            Month = month
        };

        try
        {
            var resp = await Http.PostAsJsonAsync("api/FitnessCoach/chat", req);
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                messages.Add(("Coach", $"Chat API failed ({(int)resp.StatusCode}): {body}"));
                return;
            }

            messages.Add(("Coach", body));
        }
        catch (Exception ex)
        {
            messages.Add(("Coach", ex.Message));
        }
    }

    class ClientDto
    {
        public string Id { get; set; } = "";
        public bool IsPremium { get; set; }
    }

    class CoachChatRequest
    {
        public string ClientId { get; set; } = "";
        public string Message { get; set; } = "";
        public int Year { get; set; }
        public int Month { get; set; }
    }
}