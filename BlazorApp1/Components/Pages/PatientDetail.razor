@page "/patientdetail/{patientUserId}"
@layout BlazorApp1.Components.Layout.DashboardLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Linq
@using Model
@using BlazorApp1.Service

@inject IUService UserService
@inject IAService AppointmentService
@inject IMealService MealService
@inject IMedicationHttpService MedicationService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page">
    <div class="page-head">
        <div>
            <h2>Patient Details</h2>
            <div class="muted">Profile + last appointments + today meals & medication status.</div>
        </div>
        <button class="ghost" @onclick="GoBack">⬅ Back</button>
    </div>

    @if (isLoading)
    {
        <div class="state">Loading patient details…</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="state error">@errorMessage</div>
    }
    else if (patient == null)
    {
        <div class="state">Patient not found.</div>
    }
    else
    {
        <div class="grid-2">
            <section class="card">
                <div class="card-title">@patient.Name</div>
                <div class="kv"><b>Reason:</b> @patient.Reason</div>
                <div class="kv"><b>Gender:</b> @patient.Sex</div>
                <div class="kv"><b>DOB:</b> @patient.DOB.ToShortDateString()</div>
                <div class="kv"><b>Weight:</b> @patient.Weight</div>
                <div class="kv"><b>Height:</b> @patient.Height</div>
                <div class="kv"><b>Phone:</b> @patient.Phone</div>
                <div class="kv"><b>Address:</b> @patient.Address</div>
                <div class="kv"><b>Registered since:</b> @patient.RegisterDate.ToShortDateString()</div>

                @if (patient.Tags != null && patient.Tags.Count > 0)
                {
                    <div class="tags">
                        @foreach (var t in patient.Tags)
                        {
                            <span class="tag">@t</span>
                        }
                    </div>
                }

                <div class="actions">
                    <button class="btn" @onclick="OpenChat">Chat</button>
                    <button class="btn primary" @onclick="GoPrescribe">Prescribe</button>
                </div>
            </section>

            <section class="card">
                <div class="card-title">Appointments with you</div>

                @if (appointments.Count == 0)
                {
                    <div class="mini">No appointments found for this patient with you.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in appointments)
                                {
                                    <tr>
                                        <td>@a.Start.ToShortDateString()</td>
                                        <td>@a.Start.ToShortTimeString()</td>
                                        <td>@a.Status</td>
                                        <td class="notes">@a.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>

        <div class="grid-2">
            <section class="card">
                <div class="card-title">Today’s Meals</div>
                @if (mealsToday.Count == 0)
                {
                    <div class="mini">No meals logged for today.</div>
                }
                else
                {
                    <ul class="list">
                        @foreach (var m in mealsToday)
                        {
                            <li>
                                <b>@m.Type</b> – @m.Foods
                                @if (m.Calories.HasValue)
                                {
                                    <span class="muted"> (@m.Calories.Value kcal)</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="card">
                <div class="card-title">Medication Status (Today)</div>

                @if (todayLogs.Count == 0)
                {
                    <div class="mini">No medication logs for today.</div>
                }
                else
                {
                    <div class="stats">
                        <div class="box"><div class="k">Total</div><div class="v">@totalDoses</div></div>
                        <div class="box"><div class="k">Taken</div><div class="v">@takenDoses</div></div>
                        <div class="box"><div class="k">Skipped</div><div class="v">@skippedDoses</div></div>
                        <div class="box"><div class="k">Pending</div><div class="v">@pendingDoses</div></div>
                    </div>
                }
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public string patientUserId { get; set; } = string.Empty;

    private User? patient;
    private string? patientClientId;
    private List<Appointment> appointments = new();
    private List<Meal> mealsToday = new();
    private List<MedicationLog> todayLogs = new();

    private int totalDoses;
    private int takenDoses;
    private int skippedDoses;
    private int pendingDoses;

    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(patientUserId))
            {
                errorMessage = "No patient specified.";
                return;
            }

            var doctorMongoId = await JS.InvokeAsync<string>("localStorage.getItem", "doctorMongoId");

            // ✅ FIX 1: resolve patient via CLIENT ID
            patient = await UserService.GetUserByClientIdAsync(patientUserId);
            if (patient == null)
            {
                errorMessage = "Patient not found.";
                return;
            }

            patientClientId = patient.ClientId;

            // ✅ FIX 2: appointments MUST use CLIENT ID
            var allAppts = await AppointmentService.GetAppointmentsByUserAsync(patientClientId)
                           ?? new List<Appointment>();

            if (!string.IsNullOrWhiteSpace(doctorMongoId))
            {
                allAppts = allAppts
                    .Where(a => a.DoctorId == doctorMongoId)
                    .ToList();
            }

            appointments = allAppts
                .OrderByDescending(a => a.Start)
                .Take(10)
                .ToList();

            mealsToday = await MealService.GetTodayMealsAsync(patientClientId) ?? new List<Meal>();
            todayLogs = await MedicationService.GetTodayLogsAsync(patientClientId) ?? new List<MedicationLog>();

            totalDoses = todayLogs.Count;
            takenDoses = todayLogs.Count(l => l.Status == MedicationStatus.Taken);
            skippedDoses = todayLogs.Count(l => l.Status == MedicationStatus.Skipped);
            pendingDoses = todayLogs.Count(l => l.Status == MedicationStatus.Pending);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading patient details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenChat()
    {
        var doctorClientId = await JS.InvokeAsync<string>("localStorage.getItem", "doctorId");
        if (string.IsNullOrWhiteSpace(doctorClientId) || string.IsNullOrWhiteSpace(patientClientId)) return;

        Nav.NavigateTo($"/chat/{doctorClientId}/{patientClientId}", forceLoad: true);
    }

    private void GoPrescribe()
    {
        Nav.NavigateTo($"/doctor/prescribe/{patientUserId}");
    }

    private void GoBack() => Nav.NavigateTo("/patients");
}
