@page "/patient/subscribe"
@using System.Security.Claims
@using System.Net.Http.Json
@layout BlazorApp1.Components.Layout.UserDashboardLayout
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<div class="subscribe-page">
    <div class="subscribe-card">
        <h2>Upgrade to Premium</h2>
        <p>Get access to premium NutriNest features.</p>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="error-box">@error</div>
        }

        <div class="price-box">
            <span>PKR</span>
            <strong>@amountPkr</strong>
        </div>

        <button class="btn-pay" @onclick="PayWithStripe" disabled="@busy">
            @(busy ? "Redirecting..." : "Pay with Stripe")
        </button>

        <p class="note">Secure checkout powered by Stripe. We do not store card details.</p>
    </div>
</div>

@code {
    private string error = "";
    private bool busy = false;
    private string clientId = "";
    private int amountPkr = 1500;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;

            var email = user.FindFirst(ClaimTypes.Email)?.Value
                ?? user.FindFirst("email")?.Value
                ?? "";

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "You are not logged in.";
                return;
            }

            var client = await Http.GetFromJsonAsync<ClientDto>(
                $"api/Clients/{Uri.EscapeDataString(email.Trim().ToLowerInvariant())}");

            if (client == null || string.IsNullOrWhiteSpace(client.Id))
            {
                error = "Client not found.";
                return;
            }

            clientId = client.Id;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task PayWithStripe()
    {
        try
        {
            busy = true;
            error = "";

            if (string.IsNullOrWhiteSpace(clientId))
                throw new Exception("ClientId missing. Please reload the page.");

            var response = await Http.PostAsJsonAsync(
                "api/Payments/create-checkout-session",
                new CreateCheckoutRequest
                {
                    ClientId = clientId,
                    AmountPkr = amountPkr
                });

            if (!response.IsSuccessStatusCode)
            {
                error = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CheckoutResponse>();

            if (string.IsNullOrWhiteSpace(result?.CheckoutUrl))
            {
                error = "Stripe checkout URL not received.";
                return;
            }

            Nav.NavigateTo(result.CheckoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private class ClientDto
    {
        public string Id { get; set; } = "";
    }

    private class CreateCheckoutRequest
    {
        public string ClientId { get; set; } = "";
        public int AmountPkr { get; set; }
    }

    private class CheckoutResponse
    {
        public string CheckoutUrl { get; set; } = "";
    }
}

<style>
    .subscribe-page {
        min-height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: #f7f7fb;
    }

    .subscribe-card {
        width: 100%;
        max-width: 520px;
        background: #fff;
        padding: 36px;
        border-radius: 22px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.14);
        text-align: center;
    }

    .subscribe-card h2 {
        font-size: 28px;
        font-weight: 800;
        color: #24214f;
        margin-bottom: 10px;
    }

    .price-box {
        background: #4a47a3;
        color: white;
        padding: 22px;
        border-radius: 18px;
        margin: 24px 0;
    }

    .price-box strong {
        font-size: 42px;
        margin-left: 8px;
    }

    .btn-pay {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 12px;
        background: #28a745;
        color: white;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-pay:hover {
        background: #218838;
    }

    .btn-pay:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .note {
        margin-top: 14px;
        font-size: 13px;
        color: #777;
    }

    .error-box {
        background: #ffe2e2;
        color: #b00020;
        padding: 10px;
        border-radius: 10px;
        margin: 16px 0;
    }
</style>