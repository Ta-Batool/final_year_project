@page "/patient/subscribe"
@using System.Security.Claims
@using System.Net.Http.Json
@layout BlazorApp1.Components.Layout.UserDashboardLayout
@inject HttpClient Http
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<h3>Dummy Payment Gateway</h3>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="card p-3" style="max-width:520px;">
    <div class="mb-2">
        <label>Card Number</label>
        <input class="form-control" @bind="cardNumber" placeholder="4111 1111 1111 1111" />
    </div>

    <div class="mb-2">
        <label>Name on Card</label>
        <input class="form-control" @bind="cardName" />
    </div>

    <div class="row">
        <div class="col-6 mb-2">
            <label>Expiry</label>
            <input class="form-control" @bind="expiry" placeholder="12/29" />
        </div>
        <div class="col-6 mb-2">
            <label>CVV</label>
            <input class="form-control" @bind="cvv" placeholder="123" />
        </div>
    </div>

    <div class="mb-2">
        <label>Amount (PKR)</label>
        <input class="form-control" type="number" @bind="amountPkr" />
    </div>

    <button class="btn btn-success" @onclick="Pay" disabled="@busy">
        @(busy ? "Processing..." : "Pay (Dummy)")
    </button>
</div>

@code {
    string error = "";
    bool busy = false;

    string email = "";
    string clientId = "";

    string cardNumber = "";
    string cardName = "";
    string expiry = "";
    string cvv = "";
    int amountPkr = 1500;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var user = state.User;

            email = user.FindFirst(ClaimTypes.Email)?.Value
                 ?? user.FindFirst("email")?.Value
                 ?? "";

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "Not logged in.";
                return;
            }

            email = email.Trim().ToLowerInvariant();

            // ✅ Correct endpoint (your logs show it works):
            // GET /api/Clients/{email}
            var client = await Http.GetFromJsonAsync<ClientDto>($"api/Clients/{Uri.EscapeDataString(email)}");

            if (client is null || string.IsNullOrWhiteSpace(client.Id))
            {
                error = "Client not found.";
                return;
            }

            clientId = client.Id;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task Pay()
    {
        try
        {
            error = "";
            busy = true;

            if (string.IsNullOrWhiteSpace(clientId))
                throw new Exception("ClientId missing. Reload page.");

            var req = new SubscribeRequest
            {
                ClientId = clientId,
                CardNumber = (cardNumber ?? "").Replace(" ", ""),
                CardName = cardName ?? "",
                Expiry = expiry ?? "",
                Cvv = cvv ?? "",
                AmountPkr = amountPkr
            };

            // ✅ POST /api/Payments/subscribe
            // This MUST update DB premium flag in backend
            var resp = await Http.PostAsJsonAsync("api/Payments/subscribe", req);

            if (!resp.IsSuccessStatusCode)
            {
                error = await resp.Content.ReadAsStringAsync();
                return;
            }

            // ✅ Go back to Home (you wanted home after upgrade)
            Nav.NavigateTo("/userdashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    class ClientDto { public string Id { get; set; } = ""; }

    class SubscribeRequest
    {
        public string ClientId { get; set; } = "";
        public string CardNumber { get; set; } = "";
        public string CardName { get; set; } = "";
        public string Expiry { get; set; } = "";
        public string Cvv { get; set; } = "";
        public int AmountPkr { get; set; }
    }
}
