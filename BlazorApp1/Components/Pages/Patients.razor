@page "/patients"
@layout BlazorApp1.Components.Layout.DashboardLayout
@attribute [Authorize]

@using Model
@using BlazorApp1.Service
@inject IAService AppointmentService
@inject IUService UserService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="patients-list">
    <h3>Today's Patients</h3>

    @if (isLoading)
    {
        <p>Loading patients...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p style="color:red">@loadError</p>
    }
    else if (patients.Count == 0)
    {
        <p>No patients scheduled for today.</p>
    }
    else
    {
        <ul>
            @foreach (var p in patients)
            {
                <li class="patient-item">
                    <div class="patient-summary" @onclick="() => TogglePatient(p)">
                        <div>
                            <strong>@p.Name</strong><br />
                            <span>@p.Reason</span>
                        </div>
                        <div class="patient-time">@p.Time</div>
                    </div>

                    @if (p.IsExpanded)
                    {
                        <div class="patient-details-expanded">
                            <div class="patient-info">
                                <p><strong>Address:</strong> @p.Address</p>
                                <p><strong>DOB:</strong> @p.DOB.ToShortDateString()</p>
                                <p><strong>Sex:</strong> @p.Sex</p>
                                <p><strong>Weight:</strong> @p.Weight</p>
                                <p><strong>Height:</strong> @p.Height</p>
                                <p><strong>Last Appointment:</strong> @p.LastAppointment.ToShortDateString()</p>
                                <p><strong>Registered Since:</strong> @p.RegisterDate.ToShortDateString()</p>

                                @if (p.Tags?.Count > 0)
                                {
                                    <p><strong>Tags:</strong></p>
                                    <div class="tags">
                                        @foreach (var tag in p.Tags)
                                        {
                                            <span class="tag">@tag</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="patient-actions">
                                <button class="btn-call">📞 @p.Phone</button>
                                <button class="btn">Documents</button>
                                <button class="btn" @onclick="() => OpenChat(p)">Chat</button>
                            </div>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    private class PatientViewModel
    {
        public string AppointmentId { get; set; } = "";
        public string UserClientId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Reason { get; set; } = "";
        public string Time { get; set; } = "";
        public string Address { get; set; } = "";
        public DateTime DOB { get; set; }
        public string Sex { get; set; } = "";
        public string Weight { get; set; } = "";
        public string Height { get; set; } = "";
        public DateTime LastAppointment { get; set; }
        public DateTime RegisterDate { get; set; }
        public string Phone { get; set; } = "";
        public List<string> Tags { get; set; } = new();
        public bool IsExpanded { get; set; }
    }

    private List<PatientViewModel> patients = new();
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadPatientsAsync();
        StateHasChanged();
    }

    private async Task LoadPatientsAsync()
    {
        isLoading = true;
        loadError = null;
        patients.Clear();

        try
        {
            var doctorId = await JS.InvokeAsync<string>("localStorage.getItem", "doctorId");
            if (string.IsNullOrWhiteSpace(doctorId))
            {
                loadError = "Doctor ID not found. Please log in again.";
                return;
            }

            var appts = await AppointmentService.GetAppointmentsByDoctorAsync(doctorId)
                        ?? new List<Appointment>();

            var today = DateTime.Today;
            appts = appts.Where(a => a.Start.Date == today).ToList();

            foreach (var appt in appts)
            {
                if (string.IsNullOrWhiteSpace(appt.UserId))
                    continue;

                var user = await UserService.GetUserByClientIdAsync(appt.UserId);
                if (user == null) continue;

                patients.Add(new PatientViewModel
                {
                    AppointmentId = appt.Id ?? "",
                    UserClientId = appt.UserId,
                    Name = !string.IsNullOrWhiteSpace(user.Name)
                        ? user.Name
                        : (appt.PatientName ?? "Unknown"),
                    Reason = string.IsNullOrWhiteSpace(user.Reason) ? (appt.Notes ?? "") : user.Reason!,
                    Time = appt.Start.ToShortTimeString(),
                    Address = user.Address ?? "",
                    DOB = user.DOB,
                    Sex = user.Sex ?? "",
                    Weight = user.Weight ?? "",
                    Height = user.Height ?? "",
                    LastAppointment = user.LastAppointment,
                    RegisterDate = user.RegisterDate,
                    Phone = user.Phone ?? "",
                    Tags = user.Tags ?? new List<string>()
                });
            }
        }
        catch (Exception ex)
        {
            loadError = $"Error loading patients: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePatient(PatientViewModel p)
    {
        p.IsExpanded = !p.IsExpanded;
    }

    private void OpenChat(PatientViewModel p)
    {
        // doctorId is already stored; Chat page needs /chat/{doctorClientId}/{userClientId}
        Nav.NavigateTo($"/chat/{p.UserClientId}/{p.UserClientId}", forceLoad: true);
        // ^ if you prefer: use doctorId from localStorage; this is a simple stub.
    }
}


<style>
    .patients-list {
        max-width: 600px;
        margin: 0 auto;
    }

    .patient-item {
        background: #fff;
        border-radius: 10px;
        margin: 10px 0;
        padding: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .patient-summary {
        display: flex;
        justify-content: space-between;
        cursor: pointer;
    }

    .patient-time {
        font-weight: bold;
    }

    .patient-details-expanded {
        margin-top: 10px;
        border-top: 1px solid #eee;
        padding-top: 10px;
        font-size: 14px;
        color: #444;
    }

    .patient-tags {
        margin: 8px 0;
    }

    .tag {
        display: inline-block;
        background: #eef2ff;
        border-radius: 12px;
        padding: 5px 10px;
        margin: 3px;
        font-size: 12px;
    }

    .patient-actions {
        margin-top: 15px;
    }

    .btn, .btn-call {
        border: none;
        border-radius: 6px;
        padding: 8px 12px;
        margin-right: 10px;
        cursor: pointer;
        background: #eef2ff;
        font-size: 14px;
    }

    .btn-call {
        background: #dff0d8;
    }

    .patients-list {
        margin-left: 20px;
        margin-right: 20px;
    }

    .patients-list ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .patient-item {
        background: #fff;
        border-radius: 10px;
        margin: 12px 0;
        padding: 12px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        width: 100%;
    }

    .patient-summary {
        display: flex;
        justify-content: space-between;
        cursor: pointer;
        font-weight: bold;
    }
</style>
