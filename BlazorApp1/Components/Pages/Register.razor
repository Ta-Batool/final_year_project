@page "/register"
@inject NavigationManager Navigation
@inject ICService ClientServices
@inject AuthenticationStateProvider AuthStateProvider
@using Model

<div class="auth-container">
    <div class="auth-right">
        <div class="auth-card">
            <h2 class="role-title">Choose your role</h2>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger" style="margin-bottom:14px;">
                    @error
                </div>
            }

            @if (isLoading)
            {
                <p style="color:white;">Loading your profile...</p>
            }
            else
            {
                <div class="choice-container">
                    <button type="button" class="choice-btn doctor"
                            disabled="@isSaving"
                            @onclick="GoToDoc">
                        <span>@(isSaving ? "Please wait..." : "Doctor")</span>
                    </button>

                    <button type="button" class="choice-btn patient"
                            disabled="@isSaving"
                            @onclick="GoToUser">
                        <span>@(isSaving ? "Please wait..." : "Patient")</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private Client CurrentClient = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        error = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!(user.Identity?.IsAuthenticated ?? false))
            {
                Navigation.NavigateTo("/login-google", true);
                return;
            }

            var email = user.FindFirst(c => c.Type.Contains("email"))?.Value?.Trim().ToLowerInvariant();

            if (string.IsNullOrWhiteSpace(email))
            {
                error = "No email found in your Google account.";
                return;
            }

            // ✅ Ensure Client exists (important!)
            var client = await ClientServices.GetClientByEmailAsync(email);

            if (client is null)
            {
                // If your CService has AddClientAsync, use it.
                // If not, remove this block and ensure google-callback ALWAYS creates client.
                try
                {
                    await ClientServices.AddClientAsync(new Client
                    {
                        Email = email,
                        Name = user.FindFirst("name")?.Value ?? "",
                        Role = null
                    });

                    client = await ClientServices.GetClientByEmailAsync(email);
                }
                catch
                {
                    // If AddClientAsync doesn't exist in your service, you’ll see this.
                    // Then rely on GoogleCallback to create the Client.
                }
            }

            CurrentClient = client ?? new Client { Email = email };
        }
        catch (Exception ex)
        {
            error = $"Failed to load register page: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GoToDoc()
    {
        await ChooseRoleAndNavigate("Doctor");
    }

    private async Task GoToUser()
    {
        await ChooseRoleAndNavigate("Patient");
    }

    private async Task ChooseRoleAndNavigate(string role)
    {
        error = null;

        if (string.IsNullOrWhiteSpace(CurrentClient.Email))
        {
            error = "Client email missing. Please login again.";
            return;
        }

        try
        {
            isSaving = true;

            // ✅ Save role
            CurrentClient.Role = role;
            await ClientServices.UpdateClientByEmailAsync(CurrentClient.Email, CurrentClient);

            // ✅ Re-fetch so we definitely have Id
            var updated = await ClientServices.GetClientByEmailAsync(CurrentClient.Email);
            if (updated != null)
                CurrentClient = updated;

            if (string.IsNullOrWhiteSpace(CurrentClient.Id))
            {
                error = "Client ID not found after saving role. Please refresh and try again.";
                return;
            }

            // ✅ Now navigate safely
            if (role.Equals("Doctor", StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo($"/form/{CurrentClient.Id}", true);
            else
                Navigation.NavigateTo($"/formuser/{CurrentClient.Id}", true);
        }
        catch (Exception ex)
        {
            error = $"Error setting role: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .auth-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background-color: #705ebe;
    }

    .auth-right {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .auth-card {
        background-color: #b1b1b1;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0px 4px 20px rgba(0,0,0,0.2);
        text-align: center;
        min-width: 350px;
    }

    .role-title {
        color: white;
        font-size: 1.8rem;
        margin-bottom: 30px;
        font-weight: bold;
    }

    .choice-container {
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .choice-btn {
        flex: 1;
        background-color: white;
        border: none;
        border-radius: 10px;
        padding: 15px 20px;
        font-size: 1.1rem;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .choice-btn:hover {
        transform: scale(1.08);
        background-color: #f0f0f0;
    }

    .choice-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
        transform: none;
    }
</style>
