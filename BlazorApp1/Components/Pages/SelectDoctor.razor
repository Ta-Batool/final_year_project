@page "/selectdoctor"
@page "/selectdoctor/{mode}"
@layout UserDashboardLayout

@using BlazorApp1.Components.Layout
@using Model
@using Microsoft.AspNetCore.Components
@inject IDService DoctorService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="doctor-page">
    <h2>👨‍⚕️ Select a Doctor</h2>

    @if (isLoading)
    {
        <p>Loading doctors...</p>
    }
    else if (doctors == null || doctors.Count == 0)
    {
        <p>No doctors found.</p>
    }
    else
    {
        <table class="doctor-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Specialization</th>
                    <th>Phone</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in doctors)
                {
                    <tr>
                        <td>@doc.Name</td>
                        <td>@doc.Specialization</td>
                        <td>@doc.Phone</td>
                        <td>
                            <button class="btn btn-select" @onclick="() => ChooseDoctor(doc)">
                                Select
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public string? mode { get; set; }

    private List<Doctor>? doctors;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            doctors = await DoctorService.GetAllDoctorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading doctors: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChooseDoctor(Doctor doc)
    {
        // -------------------------
        // MODE: chat
        // -------------------------
        if (string.Equals(mode, "chat", StringComparison.OrdinalIgnoreCase))
        {
            // Chat route in your app expects doctorClientId + userId
            var userId = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

            if (string.IsNullOrWhiteSpace(userId))
            {
                Console.WriteLine("❌ userId not found in localStorage. Make sure the user is logged in and registered.");
                return;
            }

            if (string.IsNullOrWhiteSpace(doc.ClientId))
            {
                Console.WriteLine("❌ Doctor ClientId missing. Cannot open chat.");
                return;
            }

            Nav.NavigateTo($"/messages/{doc.ClientId}/{userId}");
            return;
        }

        // -------------------------
        // MODE: appointments / booking (default)
        // -------------------------
        // For booking + availability, we MUST use Doctor.Id (Mongo _id)
        if (string.IsNullOrWhiteSpace(doc.Id))
        {
            Console.WriteLine("❌ Doctor Id missing. Cannot book appointment.");
            return;
        }

        // Optional: store selected doctor id for later use
        await JS.InvokeVoidAsync("localStorage.setItem", "selectedDoctorId", doc.Id);

        // ✅ Go to your booking page that uses availability endpoints
        // Make sure you have a page: @page "/book/{DoctorId}"
        Nav.NavigateTo($"/book/{doc.Id}");
    }
}

<style>
    .doctor-page {
        background: #f5f6fa;
        padding: 20px;
        border-radius: 10px;
    }

    .doctor-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .doctor-table th, .doctor-table td {
        padding: 10px;
        border-bottom: 1px solid #eee;
    }

    .doctor-table th {
        background: #3b3bbf;
        color: white;
        text-align: left;
    }

    .btn-select {
        background: #27ae60;
        color: white;
        border: none;
        padding: 6px 10px;
        border-radius: 5px;
        cursor: pointer;
    }

    .btn-select:hover {
        background: #219150;
    }
</style>
