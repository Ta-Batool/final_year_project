@page "/userdashboard"
@attribute [Authorize]

@using System.Security.Claims
@using System.Linq
@using System.Threading
@using Model
@using Microsoft.AspNetCore.Authorization
@using BlazorApp1.Components.Layout
@using BlazorApp1.Service
@layout UserDashboardLayout

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject IMealService MealService
@inject IMedicationHttpService MedicationService
@inject ICalorieNinjaService CalorieService
@inject NavigationManager Navigation


@if (isLoading)
{
    <p>Loading your dashboard...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentDoctor is null && currentUser is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    <div class="user-dashboard">
        <div class="left-panel">
            <h2>
                @if (currentDoctor is not null)
                {
                    @($"Hello, Dr. {currentDoctor.Name}")
                }
                else
                {
                    @($"Hello, {currentUser!.Name}")
                }
            </h2>

            <p class="subtitle">
                Let's start living healthy from now on
            </p>

            <div class="chart-section">
                <img src="https://toneopeats-strapi-prod.s3.ap-south-1.amazonaws.com/chart_of_a_healthy_diet_02_b7a3be54bb.jpg"
                     alt="Healthy diet chart" style="width:300px; height:auto;" />
            </div>

            <h3>Meals on @selectedDate.ToString("dd MMM yyyy")</h3>

            <!-- Add meal form -->
            <div class="add-meal-card">
                <div class="field">
                    <label>Meal type</label>
                    <select class="input" @bind="newMealType">
                        <option>Breakfast</option>
                        <option>Lunch</option>
                        <option>Dinner</option>
                        <option>Snack</option>
                    </select>
                </div>

                <div class="field">
                    <label>Food items</label>
                    <input class="input"
                           @bind="newMealFoods"
                           @oninput="OnFoodsInput"
                           placeholder="e.g. 2 eggs, toast, tea" />

                    @if (showSuggestions && foodSuggestions.Any())
                    {
                        <ul class="suggestions-list">
                            @foreach (var item in foodSuggestions)
                            {
                                <li @onclick="@(() => SelectSuggestion(item))">
                                    <span class="sugg-name">@item.Name</span>
                                    <span class="sugg-cal">@item.Calories.ToString("0") kcal</span>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="field">
                    <label>Calories (optional)</label>
                    <input class="input"
                           @bind="newMealCalories"
                           placeholder="e.g. 350" />
                </div>

                <button type="button" class="save-btn" @onclick="AddMealAsync">
                    Add meal
                </button>
            </div>

            @if (meals.Count == 0)
            {
                <p class="no-meals">No meals logged for this date.</p>
            }
            else
            {
                <div class="meals-grid">
                    @foreach (var meal in meals)
                    {
                        <div class="meal-card">
                            <div>
                                <h4>@meal.Type</h4>
                                <p>@meal.Foods</p>

                                @if (meal.Calories.HasValue)
                                {
                                    <span class="meal-cal">@meal.Calories.Value kcal</span>
                                }
                            </div>

                            <button class="delete-meal-btn"
                                    @onclick="() => DeleteMealAsync(meal.Id)">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="right-panel">
            <header class="top-bar">
                <button @onclick="Logout">Logout</button>
                <i class="fas fa-bell"></i>
                <i class="fas fa-envelope"></i>
                <i class="fas fa-cog"></i>
            </header>

            <!-- ✅ Today’s Medication summary card -->
            <div class="meds-summary-card">
                <h3>Today’s Medication</h3>

                @if (medsTotal == 0)
                {
                    <p>No medication scheduled for today.</p>
                }
                else
                {
                    <p><b>Total doses:</b> @medsTotal</p>
                    <p><b>Taken:</b> @medsTaken</p>
                    <p><b>Pending:</b> @medsPending</p>
                    <p><b>Skipped:</b> @medsSkipped</p>

                    <button type="button"
                            class="primary-btn"
                            @onclick="@(() => Navigation.NavigateTo("/medication-compliance"))">
                        Manage medications
                    </button>
                }
            </div>

            <!-- ✅ Functional 7-day calendar -->
            <div class="calendar">
                <h3>@selectedDate.ToString("MMMM yyyy")</h3>
                <div class="calendar-grid">
                    @foreach (var offset in Enumerable.Range(-3, 7))
                    {
                        var d = DateTime.Today.AddDays(offset);
                        var css = d.Date == selectedDate.Date ? "active" : string.Empty;

                        <span class="@css"
                              @onclick="@(() => OnDateSelected(d))">
                            @d.Day
                        </span>
                    }
                </div>
            </div>

            <div class="report">
                <h3>Today report</h3>

                <div class="report-item">
                    <b>Total meals (selected date):</b> @meals.Count
                </div>
                <div class="report-item">
                    <b>Total calories (selected date):</b> @totalCalories kcal
                </div>

                @if (currentDoctor is not null)
                {
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Specialization:</b> @currentDoctor.Specialization
                    </div>
                    <div class="report-item">
                        <b>Gender:</b> @currentDoctor.Gender
                    </div>
                }
                else if (currentUser is not null)
                {
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Phone:</b> @currentUser.Phone
                    </div>
                    <div class="report-item">
                        <b>Reason:</b> @currentUser.Reason
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? clientEmail;

    private Client? currentClient;
    private Doctor? currentDoctor;
    private User? currentUser;

    // Selected date for meals (calendar)
    private DateTime selectedDate = DateTime.Today;

    // Meals state
    private List<Meal> meals = new();
    private string newMealType = "Breakfast";
    private string newMealFoods = string.Empty;
    private string? newMealCalories;

    private int totalCalories =>
        meals.Where(m => m.Calories.HasValue).Sum(m => m.Calories!.Value);

    // Medication summary for today
    private List<MedicationLog> todayMedicationLogs = new();
    private int medsTotal;
    private int medsTaken;
    private int medsPending;
    private int medsSkipped;

    // CalorieNinjas autocomplete
    private List<NutritionItemSuggestion> foodSuggestions = new();
    private bool showSuggestions;
    private CancellationTokenSource? _suggestCts;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!(principal.Identity?.IsAuthenticated ?? false))
            {
                Navigation.NavigateTo("/login-google", true);
                return;
            }

            clientEmail = principal.FindFirst(ClaimTypes.Email)?.Value
                          ?? principal.FindFirst("email")?.Value;

            if (string.IsNullOrWhiteSpace(clientEmail))
            {
                errorMessage = "No email found in your Google account.";
                return;
            }

            // 1) get client (common table)
            currentClient = await CService.GetClientByEmailAsync(clientEmail);

            if (currentClient is null)
            {
                errorMessage = "No client profile found for this email. Please register first.";
                return;
            }

            var role = currentClient.Role?.ToLowerInvariant();

            // 2) then role-specific profile
            if (role == "doctor")
            {
                currentDoctor = await DService.GetDoctorByClientIdAsync(currentClient.Id);
                if (currentDoctor is null)
                    errorMessage = "Doctor profile not found. Please complete doctor registration.";
            }
            else
            {
                currentUser = await UService.GetUserByClientIdAsync(currentClient.Id);
                if (currentUser is null)
                    errorMessage = "Patient profile not found. Please complete registration.";
            }

            // 3) load meals for selected date
            await LoadMealsForDateAsync(currentClient.Id, selectedDate);

            // 4) load today's medication logs (always "today", not calendar-based yet)
            await LoadTodayMedicationAsync(currentClient.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMealsForDateAsync(string clientId, DateTime date)
    {
        // 👉 If you don't have this method yet, implement it in IMealService/MealService.
        // For now, you can temporarily call GetTodayMealsAsync if needed.
        meals = await MealService.GetMealsByDateAsync(clientId, date);
    }

    private async Task LoadTodayMedicationAsync(string clientId)
    {
        var logs = await MedicationService.GetTodayLogsAsync(clientId)
                   ?? new List<MedicationLog>();

        todayMedicationLogs = logs;

        medsTotal = logs.Count;
        medsTaken = logs.Count(l => l.Status == MedicationStatus.Taken);
        medsPending = logs.Count(l => l.Status == MedicationStatus.Pending);
        medsSkipped = logs.Count(l => l.Status == MedicationStatus.Skipped);
    }

    private async Task OnDateSelected(DateTime date)
    {
        selectedDate = date.Date;

        if (currentClient != null)
        {
            await LoadMealsForDateAsync(currentClient.Id!, selectedDate);
        }
    }

    private async Task AddMealAsync()
    {
        if (currentClient == null)
            return;

        if (string.IsNullOrWhiteSpace(newMealFoods))
            return;

        int? calories = null;
        if (int.TryParse(newMealCalories, out var c))
        {
            calories = c;
        }

        var meal = new Meal
        {
            ClientId = currentClient.Id!,
            Type = newMealType,
            Foods = newMealFoods.Trim(),
            Calories = calories,
            // make sure your Meal model has a Date/CreatedAt field to save this:
            Date = selectedDate.Date
        };

        await MealService.AddMealAsync(meal);
        await LoadMealsForDateAsync(currentClient.Id, selectedDate);

        // reset form
        newMealFoods = string.Empty;
        newMealCalories = string.Empty;
        newMealType = "Breakfast";
        showSuggestions = false;
        foodSuggestions.Clear();
    }

    private async Task DeleteMealAsync(string? mealId)
    {
        if (string.IsNullOrEmpty(mealId) || currentClient == null)
            return;

        await MealService.DeleteMealAsync(mealId);
        await LoadMealsForDateAsync(currentClient.Id, selectedDate);
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }

    // ========= CalorieNinjas autocomplete logic =========

    private async Task OnFoodsInput(ChangeEventArgs e)
    {
        newMealFoods = e.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(newMealFoods) || newMealFoods.Length < 2)
        {
            showSuggestions = false;
            foodSuggestions.Clear();
            StateHasChanged();
            return;
        }

        // debounce
        _suggestCts?.Cancel();
        _suggestCts = new CancellationTokenSource();
        var token = _suggestCts.Token;

        try
        {
            await Task.Delay(300, token); // 300ms debounce

            var items = await CalorieService.GetNutritionAsync(newMealFoods);

            if (token.IsCancellationRequested)
                return;

            foodSuggestions = items
                .Select(x => new NutritionItemSuggestion { Name = x.Name, Calories = x.Calories })
                .GroupBy(x => x.Name.ToLowerInvariant())
                .Select(g => g.First())
                .Take(6)
                .ToList();

            showSuggestions = foodSuggestions.Any();
        }
        catch
        {
            // fail silently for now
            showSuggestions = false;
            foodSuggestions.Clear();
        }

        StateHasChanged();
    }

    private void SelectSuggestion(NutritionItemSuggestion sugg)
    {
        newMealFoods = sugg.Name;
        newMealCalories = sugg.Calories.ToString("0");
        showSuggestions = false;
        foodSuggestions.Clear();
    }

    public class NutritionItemSuggestion
    {
        public string Name { get; set; } = string.Empty;
        public double Calories { get; set; }
    }
}

.user-dashboard {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    padding: 20px;
    font-family: 'Roboto', sans-serif;
    background-color: #fafafa;
}

.left-panel {
    flex: 2;
    background-color: #ffffff;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.right-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background-color: #ffffff;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.subtitle {
    color: #555;
    margin-bottom: 20px;
    font-size: 16px;
}

.add-meal-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    padding: 20px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
}

.add-meal-card .field {
    display: flex;
    flex-direction: column;
    position: relative;
}

.add-meal-card label {
    font-size: 14px;
    font-weight: 600;
    color: #444;
}

.add-meal-card .input {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 14px;
    transition: border 0.3s ease;
}

.add-meal-card .input:focus {
    border-color: #3b3bbf;
}

.save-btn {
    align-self: flex-end;
    border: none;
    border-radius: 8px;
    background-color: #5b2dfc;
    color: #fff;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
}

.save-btn:hover {
    background-color: #4720c8;
}

.meals-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.meal-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #fff;
    padding: 15px;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    gap: 10px;
    position: relative;
}

.meal-card h4 {
    font-size: 18px;
    margin-bottom: 8px;
}

.meal-cal {
    font-size: 12px;
    color: #888;
}

.delete-meal-btn {
    position: absolute;
    top: 5px;
    right: 5px;
    background-color: transparent;
    border: none;
    cursor: pointer;
    font-size: 20px;
    color: #e53935;
    transition: color 0.3s ease;
}

.delete-meal-btn:hover {
    color: #d32f2f;
}

.top-bar {
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    font-size: 20px;
    color: #3b3bbf;
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 10px;
    margin-top: 10px;
}

.calendar-grid span {
    padding: 8px 12px;
    border-radius: 8px;
    background: #f3f3f3;
    cursor: pointer;
    text-align: center;
}

.calendar-grid span:hover {
    background: #e0e0ff;
}

.calendar-grid .active {
    background-color: #3b3bbf;
    color: #fff;
}

.report-item {
    padding: 8px 0;
    font-size: 14px;
}

/* ✅ Medication summary */
.meds-summary-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    padding: 16px;
    font-size: 14px;
}

.meds-summary-card h3 {
    margin-bottom: 10px;
}

.meds-summary-card p {
    margin: 4px 0;
}

.primary-btn {
    margin-top: 10px;
    padding: 6px 12px;
    border-radius: 8px;
    border: none;
    background: #4CAF50;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
}

.primary-btn:hover {
    background: #3f8c41;
}

/* ✅ Suggestions dropdown */
.suggestions-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    max-height: 220px;
    overflow-y: auto;
    z-index: 20;
    font-size: 13px;
}

.suggestions-list li {
    display: flex;
    justify-content: space-between;
    padding: 6px 10px;
    cursor: pointer;
}

.suggestions-list li:hover {
    background: #f5f5ff;
}

.sugg-name {
    font-weight: 500;
}

.sugg-cal {
    color: #777;
}
