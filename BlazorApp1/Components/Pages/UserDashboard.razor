@page "/userdashboard"
@attribute [Authorize]

@using System.Security.Claims
@using Model
@using Microsoft.AspNetCore.Authorization
@layout UserDashboardLayout

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject IMealService MealService
@inject NavigationManager Navigation


@if (isLoading)
{
    <p>Loading your dashboard...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentDoctor is null && currentUser is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    <div class="user-dashboard">
        <div class="left-panel">
            <h2>
                @if (currentDoctor is not null)
                {
                    @($"Hello, Dr. {currentDoctor.Name}")
                }
                else
                {
                    @($"Hello, {currentUser!.Name}")
                }
            </h2>

            <p class="subtitle">
                Let's start living healthy from now on
            </p>

            <div class="chart-section">
                <img src="https://toneopeats-strapi-prod.s3.ap-south-1.amazonaws.com/chart_of_a_healthy_diet_02_b7a3be54bb.jpg"
                     alt="Healthy diet chart" style="width:300px; height:auto;" />
            </div>

            <h3>Meals today</h3>

            <!-- Add meal form -->
            <div class="add-meal-card">
                <div class="field">
                    <label>Meal type</label>
                    <select class="input" @bind="newMealType">
                        <option>Breakfast</option>
                        <option>Lunch</option>
                        <option>Lunch</option>
                        <option>Dinner</option>
                        <option>Snack</option>
                    </select>
                </div>

                <div class="field">
                    <label>Food items</label>
                    <input class="input"
                           @bind="newMealFoods"
                           placeholder="e.g. 2 eggs, toast, tea" />
                </div>

                <div class="field">
                    <label>Calories (optional)</label>
                    <input class="input"
                           @bind="newMealCalories"
                           placeholder="e.g. 350" />
                </div>

                <button type="button" class="save-btn" @onclick="AddMealAsync">
                    Add meal
                </button>
            </div>

            @if (meals.Count == 0)
            {
                <p class="no-meals">No meals added yet for today.</p>
            }
            else
            {
                <div class="meals-grid">
                    @foreach (var meal in meals)
                    {
                        <div class="meal-card">
                            <div>
                                <h4>@meal.Type</h4>
                                <p>@meal.Foods</p>

                                @if (meal.Calories.HasValue)
                                {
                                    <span class="meal-cal">@meal.Calories.Value kcal</span>
                                }
                            </div>

                            <button class="delete-meal-btn"
                                    @onclick="() => DeleteMealAsync(meal.Id)">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="right-panel">
            <header class="top-bar">
                <button @onclick="Logout">Logout</button>
                <i class="fas fa-bell"></i>
                <i class="fas fa-envelope"></i>
                <i class="fas fa-cog"></i>
            </header>

            <div class="calendar">
                <h3>@DateTime.Now.ToString("MMMM yyyy")</h3>
                <div class="calendar-grid">
                    <span>@(DateTime.Now.Day - 3)</span>
                    <span>@(DateTime.Now.Day - 2)</span>
                    <span>@(DateTime.Now.Day - 1)</span>
                    <span class="active">@DateTime.Now.Day</span>
                    <span>@(DateTime.Now.Day + 1)</span>
                    <span>@(DateTime.Now.Day + 2)</span>
                    <span>@(DateTime.Now.Day + 3)</span>
                </div>
            </div>

            <div class="report">
                <h3>Today report</h3>

                <div class="report-item">
                    <b>Total meals:</b> @meals.Count
                </div>
                <div class="report-item">
                    <b>Total calories:</b> @totalCalories kcal
                </div>

                @if (currentDoctor is not null)
                {
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Specialization:</b> @currentDoctor.Specialization
                    </div>
                    <div class="report-item">
                        <b>Gender:</b> @currentDoctor.Gender
                    </div>
                }
                else if (currentUser is not null)
                {
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Phone:</b> @currentUser.Phone
                    </div>
                    <div class="report-item">
                        <b>Reason:</b> @currentUser.Reason
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? clientEmail;

    private Client? currentClient;
    private Doctor? currentDoctor;
    private User? currentUser;

    // Meals state
    private List<Meal> meals = new();
    private string newMealType = "Breakfast";
    private string newMealFoods = string.Empty;
    private string? newMealCalories;

    private int totalCalories =>
        meals.Where(m => m.Calories.HasValue).Sum(m => m.Calories!.Value);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!(principal.Identity?.IsAuthenticated ?? false))
            {
                Navigation.NavigateTo("/login-google", true);
                return;
            }

            clientEmail = principal.FindFirst(ClaimTypes.Email)?.Value
                          ?? principal.FindFirst("email")?.Value;

            if (string.IsNullOrWhiteSpace(clientEmail))
            {
                errorMessage = "No email found in your Google account.";
                return;
            }

            // 1) get client (common table)
            currentClient = await CService.GetClientByEmailAsync(clientEmail);

            if (currentClient is null)
            {
                errorMessage = "No client profile found for this email. Please register first.";
                return;
            }

            var role = currentClient.Role?.ToLowerInvariant();

            // 2) then role-specific profile
            if (role == "doctor")
            {
                currentDoctor = await DService.GetDoctorByClientIdAsync(currentClient.Id);
                if (currentDoctor is null)
                    errorMessage = "Doctor profile not found. Please complete doctor registration.";
            }
            else
            {
                currentUser = await UService.GetUserByClientIdAsync(currentClient.Id);
                if (currentUser is null)
                    errorMessage = "Patient profile not found. Please complete registration.";
            }

            // 3) load today's meals
            meals = await MealService.GetTodayMealsAsync(currentClient.Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddMealAsync()
    {
        if (currentClient == null)
            return;

        if (string.IsNullOrWhiteSpace(newMealFoods))
            return;

        int? calories = null;
        if (int.TryParse(newMealCalories, out var c))
        {
            calories = c;
        }

        var meal = new Meal
        {
            ClientId = currentClient.Id!,
            Type = newMealType,
            Foods = newMealFoods.Trim(),
            Calories = calories
        };

        await MealService.AddMealAsync(meal);
        meals = await MealService.GetTodayMealsAsync(currentClient.Id);

        // reset form
        newMealFoods = string.Empty;
        newMealCalories = string.Empty;
        newMealType = "Breakfast";
    }

    private async Task DeleteMealAsync(string? mealId)
    {
        if (string.IsNullOrEmpty(mealId) || currentClient == null)
            return;

        await MealService.DeleteMealAsync(mealId);
        meals = await MealService.GetTodayMealsAsync(currentClient.Id);
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }
}

<style>
    .user-dashboard {
        display: flex;
        gap: 30px;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .left-panel {
        flex: 2;
    }

    .subtitle {
        color: #777;
        margin-bottom: 20px;
    }

    .chart-section {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        height: 250px;
        margin-bottom: 20px;
    }

    .add-meal-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        padding: 12px 14px;
        margin-bottom: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .field label {
        font-size: 13px;
        font-weight: 600;
        color: #444;
    }

    .input {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 6px 8px;
        font-size: 14px;
    }

    .no-meals {
        margin-top: 8px;
        color: #777;
        font-size: 14px;
    }

    .meals-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .meal-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 10px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        gap: 10px;
    }

    .meal-cal {
        display: inline-block;
        margin-top: 4px;
        font-size: 12px;
        color: #555;
    }

    .delete-meal-btn {
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 16px;
        color: #b00020;
    }

    .right-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .top-bar {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        font-size: 20px;
        color: #3b3bbf;
    }

    .calendar {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .calendar-grid {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .calendar-grid span {
        padding: 8px 12px;
        border-radius: 8px;
        background: #f3f3f3;
        cursor: pointer;
    }

    .calendar-grid .active {
        background: #3b3bbf;
        color: #fff;
    }

    .report {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .report-item {
        padding: 8px 0;
        font-size: 14px;
    }

    .save-btn {
        align-self: flex-end;
        border: none;
        border-radius: 8px;
        background: #5b2dfc;
        color: #fff;
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .save-btn:hover {
        background: #4720c8;
    }
</style>
