@page "/userdashboard"
@attribute [Authorize]

@using System.Security.Claims
@using Model
@using Microsoft.AspNetCore.Authorization

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IDService DService
@inject NavigationManager Navigation

@if (isLoading)
{
    <p>Loading your dashboard...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentDoctor is null && currentUser is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    <div class="user-dashboard">
        <div class="left-panel">
            <h2>
                @if (currentDoctor is not null)
                {
                    @($"Hello, Dr. {currentDoctor.Name}")
                }
                else
                {
                    @($"Hello, {currentUser!.Name}")
                }
            </h2>

            <p class="subtitle">
                Let's start living healthy from now on
            </p>

            <div class="chart-section">
                <img src="https://toneopeats-strapi-prod.s3.ap-south-1.amazonaws.com/chart_of_a_healthy_diet_02_b7a3be54bb.jpg"
                     alt="Healthy diet chart" style="width:300px; height:auto;" />
            </div>

            <h3>Meals today</h3>
            <div class="meals-grid">
                <div class="meal-card">
                    <img src="https://cdn-icons-png.flaticon.com/512/8775/8775285.png" alt="Carrot Juice" />
                    <div>
                        <h4>Carrot juice</h4>
                        <p>41kcal · 100g</p>
                    </div>
                </div>

                <div class="meal-card">
                    <img src="https://img.freepik.com/premium-vector/paratha-food-vector-traditional_578838-41.jpg" alt="Biryani" />
                    <div>
                        <h4>Biryani</h4>
                        <p>180kcal · 200g</p>
                    </div>
                </div>

                <div class="meal-card">
                    <img src="https://img.freepik.com/premium-vector/paratha-food-vector-traditional_578838-41.jpg" alt="Pharata" />
                    <div>
                        <h4>Pharata</h4>
                        <p>63kcal · 300g</p>
                    </div>
                </div>

                <div class="meal-card">
                    <img src="https://cdn-icons-png.flaticon.com/512/3595/3595455.png" alt="Pizza" />
                    <div>
                        <h4>Pizza</h4>
                        <p>17kcal · 100g</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="right-panel">
            <header class="top-bar">
                <button @onclick="Logout">Logout</button>
                <i class="fas fa-bell"></i>
                <i class="fas fa-envelope"></i>
                <i class="fas fa-cog"></i>
            </header>

            <div class="calendar">
                <h3>@DateTime.Now.ToString("MMMM yyyy")</h3>
                <div class="calendar-grid">
                    <span>@(DateTime.Now.Day - 3)</span>
                    <span>@(DateTime.Now.Day - 2)</span>
                    <span>@(DateTime.Now.Day - 1)</span>
                    <span class="active">@DateTime.Now.Day</span>
                    <span>@(DateTime.Now.Day + 1)</span>
                    <span>@(DateTime.Now.Day + 2)</span>
                    <span>@(DateTime.Now.Day + 3)</span>
                </div>
            </div>

            <div class="report">
                <h3>Today report</h3>

                @if (currentDoctor is not null)
                {
                    <div class="report-item">
                        <b>Specialization:</b> @currentDoctor.Specialization
                    </div>
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Gender:</b> @currentDoctor.Gender
                    </div>
                }
                else if (currentUser is not null)
                {
                    <div class="report-item">
                        <b>Email:</b> @clientEmail
                    </div>
                    <div class="report-item">
                        <b>Phone:</b> @currentUser.Phone
                    </div>
                    <div class="report-item">
                        <b>Reason:</b> @currentUser.Reason
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? clientEmail;

    private Client? currentClient;
    private Doctor? currentDoctor;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!(principal.Identity?.IsAuthenticated ?? false))
            {
                Navigation.NavigateTo("/login-google", true);
                return;
            }

            clientEmail = principal.FindFirst(ClaimTypes.Email)?.Value
                          ?? principal.FindFirst("email")?.Value;

            if (string.IsNullOrWhiteSpace(clientEmail))
            {
                errorMessage = "No email found in your Google account.";
                return;
            }

            // 1) get client (common table)
            currentClient = await CService.GetClientByEmailAsync(clientEmail);

            if (currentClient is null)
            {
                errorMessage = "No client profile found for this email. Please register first.";
                return;
            }

            var role = currentClient.Role?.ToLowerInvariant();

            // 2) then role-specific profile
            if (role == "doctor")
            {
                currentDoctor = await DService.GetDoctorByClientIdAsync(currentClient.Id);
                if (currentDoctor is null)
                    errorMessage = "Doctor profile not found. Please complete doctor registration.";
            }
            else
            {
                currentUser = await UService.GetUserByClientIdAsync(currentClient.Id);
                if (currentUser is null)
                    errorMessage = "Patient profile not found. Please complete registration.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Logout()
    {
        // hit the /logout endpoint we mapped in Program.cs
        Navigation.NavigateTo("/logout", true);
    }
}

<style>
    .user-dashboard {
        display: flex;
        gap: 30px;
        padding: 20px;
        font-family: Arial, sans-serif;
    }

    .left-panel {
        flex: 2;
    }

    .subtitle {
        color: #777;
        margin-bottom: 20px;
    }

    .chart-section {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        height: 250px;
        margin-bottom: 20px;
    }

    .meals-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .meal-card {
        display: flex;
        align-items: center;
        background: #fff;
        padding: 10px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        gap: 10px;
    }

    .meal-card img {
        width: 40px;
        height: 40px;
    }

    .right-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .top-bar {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        font-size: 20px;
        color: #3b3bbf;
    }

    .calendar {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .calendar-grid {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .calendar-grid span {
        padding: 8px 12px;
        border-radius: 8px;
        background: #f3f3f3;
        cursor: pointer;
    }

    .calendar-grid .active {
        background: #3b3bbf;
        color: #fff;
    }

    .report {
        background: #fff;
        padding: 15px;
        border-radius: 12px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    .report-item {
        padding: 8px 0;
        font-size: 14px;
    }

    .breakfast { color: #ff9800; }
    .lunch { color: #e64a19; }
    .dinner { color: #9c27b0; }
</style>
