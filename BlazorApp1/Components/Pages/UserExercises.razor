@page "/userexercises"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using System.Linq
@using Model
@using BlazorApp1.Components.Layout
@using BlazorApp1.Service

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IMealService MealService
@inject IExerciseService ExerciseService
@inject IHydrationService HydrationService

@layout UserDashboardLayout

<h2>Exercise & Hydration</h2>

<p class="subtitle">
    Log your daily exercise and water intake. Net calories = food calories - exercise calories.
</p>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentClient is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    <div class="summary-card card">
        <h3>Today's Energy Summary (@selectedDate.ToString("dd MMM yyyy"))</h3>
        <p>
            Ate: <strong>@totalCaloriesEaten</strong> kcal ·
            Burned: <strong>@totalCaloriesBurned</strong> kcal ·
            Net: <strong>@netCalories</strong> kcal
        </p>
        <p class="small-text">
            Net calories = food calories - exercise calories.
        </p>
    </div>

    <div class="dashboard-grid">
        <!-- LEFT: Exercises -->
        <div class="card">
            <h3>Today's Exercises</h3>

            <!-- Simple form, we handle submit ourselves -->
            <EditForm Model="exerciseForm" OnSubmit="AddExerciseAsync">
                <!-- 🔍 Search box + button -->
                <div class="form-group">
                    <label>Search exercise</label>
                    <div style="display:flex; gap:0.5rem;">
                        <input class="form-control"
                               style="flex:1"
                               value="@exerciseSearch"
                               @oninput="e => exerciseSearch = e.Value?.ToString() ?? string.Empty" />
                        <button type="button"
                                class="btn-secondary"
                                @onclick="SearchExercisesAsync">
                            Search
                        </button>
                    </div>
                    <p class="small-text">Type at least 2 letters and press Search.</p>
                </div>

                <!-- ⬇ Dropdown with suggestions -->
                @if (exerciseSuggestions.Any())
                {
                    <div class="form-group">
                        <label>Suggestions</label>
                        <select class="form-control"
                                value="@selectedSuggestionIndexString"
                                @onchange="OnSuggestionChanged">
                            <option value="">-- choose an exercise --</option>
                            @for (var i = 0; i < exerciseSuggestions.Count; i++)
                            {
                                var s = exerciseSuggestions[i];
                                <option value="@i">
                                    @s.Name (@s.CaloriesPerMinute.ToString("0.00") kcal/min)
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label>Selected exercise</label>
                    <input class="form-control"
                           value="@exerciseForm.Name"
                           readonly />
                </div>

                <div class="form-group">
                    <label>Type</label>
                    <InputSelect @bind-Value="exerciseForm.Type" class="form-control">
                        <option value="Cardio">Cardio</option>
                        <option value="Strength">Strength</option>
                        <option value="Flexibility">Flexibility</option>
                        <option value="Yoga">Yoga</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>Duration (minutes)</label>
                    <InputNumber TValue="int"
                                 Value="exerciseForm.DurationMinutes"
                                 ValueChanged="OnDurationChanged"
                                 ValueExpression="() => exerciseForm.DurationMinutes"
                                 class="form-control" />
                </div>

                <div class="form-group">
                    <label>Intensity</label>
                    <InputSelect @bind-Value="exerciseForm.Intensity" class="form-control">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </InputSelect>
                </div>

                <p class="small-text">
                    @if (selectedSuggestion is null)
                    {
                        <span>Select an exercise to see calories burned.</span>
                    }
                    else
                    {
                        <span>
                            Per minute:
                            <strong>@selectedSuggestion.CaloriesPerMinute.ToString("0.00")</strong> kcal ·
                            This session:
                            <strong>@calculatedCaloriesBurned.ToString("0")</strong> kcal
                        </span>
                    }
                </p>

                <button type="submit"
                        class="btn-primary"
                        disabled="@isSavingExercise || selectedSuggestion is null || exerciseForm.DurationMinutes <= 0">
                    @(isSavingExercise ? "Saving..." : "Add Exercise")
                </button>
            </EditForm>

            <h4 class="mt-3">Today’s Logged Exercises</h4>

            @if (!exerciseLogs.Any())
            {
                <p>No exercise logged for today yet.</p>
            }
            else
            {
                <p class="small-text">
                    Total: <strong>@totalMinutes</strong> minutes ·
                    Burned: <strong>@totalCaloriesBurned</strong> kcal
                </p>

                <ul class="simple-list">
                    @foreach (var ex in exerciseLogs)
                    {
                        <li class="list-item">
                            <div>
                                <strong>@ex.Name</strong>
                                <span class="badge">@ex.Type</span>
                                <span class="badge">@ex.Intensity</span>
                                <span class="muted">@ex.DurationMinutes min</span>
                                @if (ex.CaloriesBurned.HasValue)
                                {
                                    <span class="muted">· @ex.CaloriesBurned.Value kcal</span>
                                }
                            </div>
                            <button class="btn-link danger" @onclick="() => DeleteExerciseAsync(ex.Id)">
                                remove
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- RIGHT: Hydration -->
        <div class="card">
            <h3>Hydration Tracker (@selectedDate.ToString("dd MMM yyyy"))</h3>

            @if (hydrationLog is null)
            {
                <p>No water logged yet today.</p>
            }
            else
            {
                <div class="hydration-progress">
                    <div class="bar">
                        <div class="fill" style="width:@hydrationPercent%"></div>
                    </div>
                    <p class="small-text">
                        @hydrationLog.TotalMl ml / @hydrationLog.TargetMl ml (@hydrationPercent%)
                    </p>
                </div>
            }

            <div class="quick-buttons">
                <button class="btn-secondary" @onclick="() => AddWaterAsync(250)">+250 ml</button>
                <button class="btn-secondary" @onclick="() => AddWaterAsync(500)">+500 ml</button>
            </div>

            <div class="form-group mt-3">
                <label>Daily target (ml)</label>
                <InputNumber @bind-Value="targetMl" class="form-control" />
                <button class="btn-primary mt-2" @onclick="UpdateTargetAsync" disabled="@isSavingHydration">
                    @(isSavingHydration ? "Saving..." : "Update target")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Client? currentClient;
    private User? currentUser;

    private bool isLoading = true;
    private bool isSavingExercise = false;
    private bool isSavingHydration = false;
    private string? errorMessage;

    private DateTime selectedDate = DateTime.UtcNow.Date;

    private List<Meal> mealsToday = new();
    private List<ExerciseLog> exerciseLogs = new();
    private HydrationLog? hydrationLog;

    private int totalMinutes => exerciseLogs.Sum(x => x.DurationMinutes);
    private int totalCaloriesEaten => mealsToday.Sum(m => m.Calories ?? 0);
    private int totalCaloriesBurned => exerciseLogs.Sum(x => x.CaloriesBurned ?? 0);
    private int netCalories => totalCaloriesEaten - totalCaloriesBurned;

    private int hydrationPercent =>
        hydrationLog is null || hydrationLog.TargetMl <= 0
            ? 0
            : Math.Min(100, hydrationLog.TotalMl * 100 / hydrationLog.TargetMl);

    private int targetMl = 2000;

    // exercise search state
    private string exerciseSearch = string.Empty;
    private List<ExerciseSuggestion> exerciseSuggestions = new();
    private ExerciseSuggestion? selectedSuggestion;
    private int selectedSuggestionIndex = -1;
    private string selectedSuggestionIndexString => selectedSuggestionIndex >= 0 ? selectedSuggestionIndex.ToString() : string.Empty;
    private double calculatedCaloriesBurned = 0;

    private ExerciseLog exerciseForm = new ExerciseLog
    {
        Type = "Cardio",
        Intensity = "Medium",
        DurationMinutes = 30
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var principal = authState.User;

            if (!principal.Identity?.IsAuthenticated ?? true)
            {
                errorMessage = "You are not logged in.";
                return;
            }

            var email = principal.FindFirst(ClaimTypes.Email)?.Value
                        ?? principal.FindFirst("email")?.Value;

            if (string.IsNullOrEmpty(email))
            {
                errorMessage = "Email not found in token.";
                return;
            }

            currentClient = await CService.GetClientByEmailAsync(email);
            if (currentClient != null)
            {
                currentUser = await UService.GetUserByClientIdAsync(currentClient.Id!);
            }

            if (currentClient == null)
            {
                errorMessage = "Client profile not found.";
                return;
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        if (currentClient == null) return;

        mealsToday   = await MealService.GetTodayMealsAsync(currentClient.Id!);
        exerciseLogs = await ExerciseService.GetTodayAsync(currentClient.Id!);
        hydrationLog = await HydrationService.GetTodayAsync(currentClient.Id!);

        if (hydrationLog != null)
        {
            targetMl = hydrationLog.TargetMl;
        }
    }

    // 🔍 Triggered when user clicks Search
    private async Task SearchExercisesAsync()
    {
        selectedSuggestion = null;
        selectedSuggestionIndex = -1;
        exerciseForm.Name = string.Empty;
        calculatedCaloriesBurned = 0;

        if (string.IsNullOrWhiteSpace(exerciseSearch) || exerciseSearch.Length < 2)
        {
            exerciseSuggestions.Clear();
            return;
        }

        try
        {
            exerciseSuggestions =
                await ExerciseService.SearchExercisesAsync(exerciseSearch);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not search exercises: {ex.Message}";
        }
    }

    // 🔽 When user picks option from dropdown
    private void OnSuggestionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;

        if (!int.TryParse(value, out var index) ||
            index < 0 || index >= exerciseSuggestions.Count)
        {
            selectedSuggestionIndex = -1;
            selectedSuggestion = null;
            exerciseForm.Name = string.Empty;
            calculatedCaloriesBurned = 0;
            return;
        }

        selectedSuggestionIndex = index;
        selectedSuggestion = exerciseSuggestions[index];

        exerciseForm.Name = selectedSuggestion.Name;
        RecalculateCalories();
    }

    // 🔢 Duration change
    private void OnDurationChanged(int value)
    {
        exerciseForm.DurationMinutes = value;
        RecalculateCalories();
    }

    private void RecalculateCalories()
    {
        if (selectedSuggestion == null || exerciseForm.DurationMinutes <= 0)
        {
            calculatedCaloriesBurned = 0;
            return;
        }

        calculatedCaloriesBurned =
            selectedSuggestion.CaloriesPerMinute * exerciseForm.DurationMinutes;
    }

    // 💾 Add exercise (OnSubmit handler)
    private async Task AddExerciseAsync(EditContext _)
    {
        if (currentClient == null || selectedSuggestion == null) return;
        if (string.IsNullOrWhiteSpace(exerciseForm.Name)) return;
        if (exerciseForm.DurationMinutes <= 0) return;

        try
        {
            isSavingExercise = true;

            var log = new ExerciseLog
            {
                ClientId         = currentClient.Id!,
                Name             = exerciseForm.Name.Trim(),
                Type             = exerciseForm.Type,
                DurationMinutes  = exerciseForm.DurationMinutes,
                Intensity        = exerciseForm.Intensity,
                Date             = selectedDate,
                CreatedAt        = DateTime.UtcNow,
                CaloriesBurned   = (int)Math.Round(calculatedCaloriesBurned)
            };

            await ExerciseService.AddAsync(log);

            // reset search + form
            exerciseSearch = string.Empty;
            exerciseForm.Name = string.Empty;
            selectedSuggestion = null;
            selectedSuggestionIndex = -1;
            exerciseSuggestions.Clear();
            calculatedCaloriesBurned = 0;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not save exercise: {ex.Message}";
        }
        finally
        {
            isSavingExercise = false;
        }
    }

    private async Task DeleteExerciseAsync(string? id)
    {
        if (string.IsNullOrEmpty(id)) return;

        try
        {
            await ExerciseService.DeleteAsync(id);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete exercise: {ex.Message}";
        }
    }

    private async Task AddWaterAsync(int amountMl)
    {
        if (currentClient == null) return;

        try
        {
            isSavingHydration = true;
            await HydrationService.AddWaterAsync(currentClient.Id!, amountMl);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not add water: {ex.Message}";
        }
        finally
        {
            isSavingHydration = false;
        }
    }

    private async Task UpdateTargetAsync()
    {
        if (currentClient == null || targetMl <= 0) return;

        try
        {
            isSavingHydration = true;
            await HydrationService.UpdateTargetAsync(currentClient.Id!, targetMl);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not update target: {ex.Message}";
        }
        finally
        {
            isSavingHydration = false;
        }
    }
}
