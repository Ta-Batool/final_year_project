@page "/userexercises"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using System.Linq
@using Model
@using BlazorApp1.Components.Layout
@using BlazorApp1.Service

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IMealService MealService
@inject IExerciseService ExerciseService
@inject IHydrationService HydrationService

// 🔥 Priority-C services
@inject MetabolismApiService MetabolismService
@inject IExercisePlanService ExercisePlanService

@layout UserDashboardLayout

<h2>Exercise & Hydration</h2>

<p class="subtitle">
    Log your daily exercise and water intake. Net calories = food calories − exercise calories.
</p>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentClient is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    <!-- 🔥 METABOLISM SUMMARY -->
    @if (metabolism != null)
    {
        <div class="summary-card card">
            <h3>🔥 Metabolism Overview</h3>

            <p>
                BMR:
                <strong>@metabolism.Bmr</strong> kcal ·
                Maintenance:
                <strong>@metabolism.MaintenanceCalories</strong> kcal
            </p>

            <p class="small-text">
                @if (netCalories < -200)
                {
                    <span style="color:#16a34a;font-weight:600;">
                        You are in a calorie deficit
                    </span>
                }
                else if (netCalories > 200)
                {
                    <span style="color:#dc2626;font-weight:600;">
                        You are in a calorie surplus
                    </span>
                }
                else
                {
                    <span style="color:#64748b;">
                        You are around maintenance calories
                    </span>
                }
            </p>
        </div>
    }

    <!-- 🔢 ENERGY SUMMARY (YOUR ORIGINAL CARD) -->
    <div class="summary-card card">
        <h3>Today's Energy Summary (@selectedDate.ToString("dd MMM yyyy"))</h3>
        <p>
            Ate: <strong>@totalCaloriesEaten</strong> kcal ·
            Burned: <strong>@totalCaloriesBurned</strong> kcal ·
            Net: <strong>@netCalories</strong> kcal
        </p>
        <p class="small-text">
            Net calories = food calories − exercise calories.
        </p>
    </div>

    <div class="dashboard-grid">

        <!-- 🏋️ EXERCISE PLAN (Priority-C) -->
        @if (exercisePlan != null)
        {
            <div class="card">
                <h3>🏋️ Today’s Exercise Plan</h3>

                @if (exercisePlan.Items == null || !exercisePlan.Items.Any())
                {
                    <p class="muted">No planned exercises for today.</p>
                }
                else
                {
                    <ul class="simple-list">
                        @foreach (var item in exercisePlan.Items)
                        {
                            <li>
                                <strong>@item.Name</strong>
                                <span class="muted">
                                    (@item.DurationMinutes min · @item.Type)
                                </span>
                            </li>
                        }
                    </ul>
                }

                <p class="small-text">
                    Target burn:
                    <strong>@exercisePlan.TargetCalories</strong> kcal
                </p>
            </div>
        }

        <!-- 🏃 LEFT: EXERCISES (UNCHANGED CORE LOGIC) -->
        <div class="card">
            <h3>Today's Exercises</h3>

            <div class="form-group">
                <label>Search exercise</label>
                <div style="display:flex; gap:0.5rem;">
                    <input class="form-control"
                           style="flex:1"
                           value="@exerciseSearch"
                           @oninput="e => exerciseSearch = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn-secondary" @onclick="SearchExercisesAsync">
                        Search
                    </button>
                </div>
                <p class="small-text">Type at least 2 letters and press Search.</p>
            </div>

            @if (exerciseSuggestions.Any())
            {
                <div class="form-group">
                    <label>Suggestions</label>
                    <select class="form-control"
                            value="@selectedSuggestionIndexString"
                            @onchange="OnSuggestionChanged">
                        <option value="">-- choose an exercise --</option>
                        @for (int i = 0; i < exerciseSuggestions.Count; i++)
                        {
                            var s = exerciseSuggestions[i];
                            <option value="@i">
                                @s.Name (@s.CaloriesPerMinute.ToString("0.00") kcal/min)
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="form-group">
                <label>Selected exercise</label>
                <input class="form-control" value="@exerciseForm.Name" readonly />
            </div>

            <div class="form-group">
                <label>Type</label>
                <select class="form-control" @bind="exerciseForm.Type">
                    <option>Cardio</option>
                    <option>Strength</option>
                    <option>Flexibility</option>
                    <option>Yoga</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="form-group">
                <label>Duration (minutes)</label>
                <input class="form-control" @bind="durationText" />
            </div>

            <div class="form-group">
                <label>Intensity</label>
                <select class="form-control" @bind="exerciseForm.Intensity">
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                </select>
            </div>

            <p class="small-text">
                @if (selectedSuggestion != null)
                {
                    <span>
                        Session burn:
                        <strong>@calculatedCaloriesBurned.ToString("0")</strong> kcal
                    </span>
                }
            </p>

            <button class="btn-primary" @onclick="AddExerciseAsync">
                @(isSavingExercise ? "Saving..." : "Add Exercise")
            </button>

            <h4 class="mt-3">Today’s Logged Exercises</h4>

            @if (!exerciseLogs.Any())
            {
                <p>No exercise logged yet.</p>
            }
            else
            {
                <ul class="simple-list">
                    @foreach (var ex in exerciseLogs)
                    {
                        <li class="list-item">
                            <div>
                                <strong>@ex.Name</strong>
                                <span class="badge">@ex.Type</span>
                                <span class="badge">@ex.Intensity</span>
                                <span class="muted">
                                    @ex.DurationMinutes min · @ex.CaloriesBurned kcal
                                </span>
                            </div>
                            <button class="btn-link danger"
                                    @onclick="() => DeleteExerciseAsync(ex.Id)">
                                remove
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- 💧 RIGHT: HYDRATION -->
        <div class="card">
            <h3>Hydration Tracker (@selectedDate.ToString("dd MMM yyyy"))</h3>

            @if (hydrationLog != null)
            {
                <div class="hydration-progress">
                    <div class="bar">
                        <div class="fill" style="width:@hydrationPercent%"></div>
                    </div>
                    <p class="small-text">
                        @hydrationLog.TotalMl ml /
                        @hydrationLog.TargetMl ml
                        (@hydrationPercent%)
                    </p>
                </div>
            }
            else
            {
                <p>No water logged yet today.</p>
            }

            <div class="quick-buttons">
                <button class="btn-secondary" @onclick="() => AddWaterAsync(250)">+250 ml</button>
                <button class="btn-secondary" @onclick="() => AddWaterAsync(500)">+500 ml</button>
            </div>

            <div class="form-group mt-3">
                <label>Daily target (ml)</label>
                <input class="form-control" type="number" @bind="targetMl" />
                <button class="btn-primary mt-2"
                        @onclick="UpdateTargetAsync"
                        disabled="@isSavingHydration">
                    @(isSavingHydration ? "Saving..." : "Update target")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Client? currentClient;
    private User? currentUser;

    private bool isLoading = true;
    private bool isSavingExercise;
    private bool isSavingHydration;
    private string? errorMessage;

    private DateTime selectedDate = DateTime.UtcNow.Date;

    private List<Meal> mealsToday = new();
    private List<ExerciseLog> exerciseLogs = new();
    private HydrationLog? hydrationLog;

    // 🔥 Priority-C state
    private MetabolismSummary? metabolism;
    private ExercisePlan? exercisePlan;

    private int totalCaloriesEaten  => mealsToday.Sum(m => m.Calories ?? 0);
    private int totalCaloriesBurned => exerciseLogs.Sum(x => x.CaloriesBurned ?? 0);
    private int netCalories         => totalCaloriesEaten - totalCaloriesBurned;

    private int hydrationPercent =>
        hydrationLog == null || hydrationLog.TargetMl <= 0
            ? 0
            : Math.Min(100, hydrationLog.TotalMl * 100 / hydrationLog.TargetMl);

    private int targetMl = 2000;

    private string exerciseSearch = "";
    private List<ExerciseSuggestion> exerciseSuggestions = new();
    private ExerciseSuggestion? selectedSuggestion;
    private int selectedSuggestionIndex = -1;
    private string selectedSuggestionIndexString =>
        selectedSuggestionIndex >= 0 ? selectedSuggestionIndex.ToString() : "";

    private double calculatedCaloriesBurned;
    private string durationText = "30";

    private ExerciseLog exerciseForm = new()
    {
        Type = "Cardio",
        Intensity = "Medium",
        DurationMinutes = 30
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var email = auth.User.FindFirst(ClaimTypes.Email)?.Value;

        currentClient = await CService.GetClientByEmailAsync(email!);
        currentUser = await UService.GetUserByClientIdAsync(currentClient!.Id!);

        await LoadDataAsync();
        isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        mealsToday   = await MealService.GetTodayMealsAsync(currentClient!.Id!);
        exerciseLogs = await ExerciseService.GetTodayAsync(currentClient.Id!);
        hydrationLog = await HydrationService.GetTodayAsync(currentClient.Id!);

        metabolism   = await MetabolismService.GetSummaryAsync(currentClient.Id!);
        exercisePlan = await ExercisePlanService.GetTodayPlanAsync(currentClient.Id!);

        if (hydrationLog != null)
            targetMl = hydrationLog.TargetMl;
    }

    private async Task SearchExercisesAsync()
        => exerciseSuggestions = await ExerciseService.SearchExercisesAsync(exerciseSearch);

    private void OnSuggestionChanged(ChangeEventArgs e)
    {
        selectedSuggestionIndex = int.Parse(e.Value!.ToString()!);
        selectedSuggestion = exerciseSuggestions[selectedSuggestionIndex];
        exerciseForm.Name = selectedSuggestion.Name;
        calculatedCaloriesBurned =
            selectedSuggestion.CaloriesPerMinute * int.Parse(durationText);
    }

    private async Task AddExerciseAsync()
    {
        if (selectedSuggestion == null) return;

        isSavingExercise = true;

        await ExerciseService.AddAsync(new ExerciseLog
        {
            ClientId = currentClient!.Id!,
            Name = exerciseForm.Name,
            Type = exerciseForm.Type,
            Intensity = exerciseForm.Intensity,
            DurationMinutes = int.Parse(durationText),
            CaloriesBurned =
                (int)(selectedSuggestion.CaloriesPerMinute * int.Parse(durationText)),
            Date = selectedDate,
            CreatedAt = DateTime.UtcNow
        });

        await LoadDataAsync();
        isSavingExercise = false;
    }

    private async Task DeleteExerciseAsync(string id)
    {
        await ExerciseService.DeleteAsync(id);
        await LoadDataAsync();
    }

    private async Task AddWaterAsync(int ml)
    {
        await HydrationService.AddWaterAsync(currentClient!.Id!, ml);
        await LoadDataAsync();
    }

    private async Task UpdateTargetAsync()
    {
        await HydrationService.UpdateTargetAsync(currentClient!.Id!, targetMl);
        await LoadDataAsync();
    }
}
