@page "/userexercises"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Claims
@using System.Linq
@using System.Net.Http.Json
@using Model
@using BlazorApp1.Components.Layout
@using BlazorApp1.Service

@inject AuthenticationStateProvider AuthStateProvider
@inject ICService CService
@inject IUService UService
@inject IMealService MealService
@inject IExerciseService ExerciseService
@inject IHydrationService HydrationService

@* 🔥 Priority-C services *@
@inject MetabolismApiService MetabolismService

@* ✅ FIX: You DO have this in frontend (ExercisePlanService : IExercisePlanService) *@
@inject IExercisePlanService ExercisePlanService

@* ✅ NEW: HttpClient for Workout Routines API *@
@inject HttpClient Http

@layout UserDashboardLayout

<h2>Exercise & Hydration</h2>

<p class="subtitle">
    Log your daily exercise and water intake. Net calories = food calories − exercise calories.
</p>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (currentClient is null)
{
    <p>No profile found. Please complete your registration.</p>
}
else
{
    @* 🔥 METABOLISM SUMMARY *@
    @if (metabolism != null)
    {
        <div class="summary-card card">
            <h3>🔥 Metabolism Overview</h3>

            <p>
                BMR:
                <strong>@metabolism.Bmr</strong> kcal ·
                Maintenance:
                <strong>@metabolism.MaintenanceCalories</strong> kcal
            </p>

            <p class="small-text">
                @if (netCalories < -200)
                {
                    <span style="color:#16a34a;font-weight:600;">
                        You are in a calorie deficit
                    </span>
                }
                else if (netCalories > 200)
                {
                    <span style="color:#dc2626;font-weight:600;">
                        You are in a calorie surplus
                    </span>
                }
                else
                {
                    <span style="color:#64748b;">
                        You are around maintenance calories
                    </span>
                }
            </p>
        </div>
    }

    @* 🔢 ENERGY SUMMARY *@
    <div class="summary-card card">
        <h3>Today's Energy Summary (@selectedDate.ToString("dd MMM yyyy"))</h3>
        <p>
            Ate: <strong>@totalCaloriesEaten</strong> kcal ·
            Burned: <strong>@totalCaloriesBurned</strong> kcal ·
            Net: <strong>@netCalories</strong> kcal
        </p>
        <p class="small-text">
            Net calories = food calories − exercise calories.
        </p>
    </div>

    <div class="dashboard-grid">

        @* 🏋️ EXERCISE PLAN (Priority-C) *@
        @if (exercisePlan != null)
        {
            <div class="card">
                <h3>🏋️ Today’s Exercise Plan</h3>

                @if (exercisePlan.Items == null || !exercisePlan.Items.Any())
                {
                    <p class="muted">No planned exercises for today.</p>
                }
                else
                {
                    <ul class="simple-list">
                        @foreach (var item in exercisePlan.Items)
                        {
                            <li>
                                <strong>@item.Example</strong>
                                <span class="muted">
                                    (@item.Minutes min · @item.Type · @item.Intensity)
                                </span>
                                <span class="muted">
                                    · ~@item.EstimatedCaloriesBurned kcal
                                </span>
                            </li>
                        }
                    </ul>
                }

                <p class="small-text">
                    Target burn:
                    <strong>@exercisePlan.TargetCaloriesToBurn</strong> kcal
                </p>

                @if (!string.IsNullOrWhiteSpace(exercisePlan.Notes))
                {
                    <p class="small-text">@exercisePlan.Notes</p>
                }
            </div>
        }

        @* 🏃 LEFT: EXERCISES *@
        <div class="card">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;">
                <h3 style="margin:0;">Today's Exercises</h3>

                @* ✅ NEW: Workout routines popup trigger *@
                <button class="btn-secondary" @onclick="OpenWorkoutRoutinesAsync" title="See admin-added workout routines">
                    Workout Routines
                </button>
            </div>

            <div class="form-group mt-2">
                <label>Search exercise</label>
                <div style="display:flex; gap:0.5rem;">
                    <input class="form-control"
                           style="flex:1"
                           value="@exerciseSearch"
                           @oninput="e => exerciseSearch = e.Value?.ToString() ?? string.Empty" />
                    <button class="btn-secondary" @onclick="SearchExercisesAsync">
                        Search
                    </button>
                </div>
                <p class="small-text">Type at least 2 letters and press Search.</p>
            </div>

            @if (exerciseSuggestions.Any())
            {
                <div class="form-group">
                    <label>Suggestions</label>
                    <select class="form-control"
                            value="@selectedSuggestionIndexString"
                            @onchange="OnSuggestionChanged">
                        <option value="">-- choose an exercise --</option>
                        @for (int i = 0; i < exerciseSuggestions.Count; i++)
                        {
                            var s = exerciseSuggestions[i];
                            <option value="@i">
                                @s.Name (@s.CaloriesPerMinute.ToString("0.00") kcal/min)
                            </option>
                        }
                    </select>
                </div>
            }

            <div class="form-group">
                <label>Selected exercise</label>
                <input class="form-control" value="@exerciseForm.Name" readonly />
            </div>

            <div class="form-group">
                <label>Type</label>
                <select class="form-control" @bind="exerciseForm.Type">
                    <option>Cardio</option>
                    <option>Strength</option>
                    <option>Flexibility</option>
                    <option>Yoga</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="form-group">
                <label>Duration (minutes)</label>
                <input class="form-control" @bind="durationText" />
            </div>

            <div class="form-group">
                <label>Intensity</label>
                <select class="form-control" @bind="exerciseForm.Intensity">
                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>
                </select>
            </div>

            <p class="small-text">
                @if (selectedSuggestion != null)
                {
                    <span>
                        Session burn:
                        <strong>@calculatedCaloriesBurned.ToString("0")</strong> kcal
                    </span>
                }
            </p>

            <button class="btn-primary" @onclick="AddExerciseAsync">
                @(isSavingExercise ? "Saving..." : "Add Exercise")
            </button>

            <h4 class="mt-3">Today’s Logged Exercises</h4>

            @if (!exerciseLogs.Any())
            {
                <p>No exercise logged yet.</p>
            }
            else
            {
                <ul class="simple-list">
                    @foreach (var ex in exerciseLogs)
                    {
                        <li class="list-item">
                            <div>
                                <strong>@ex.Name</strong>
                                <span class="badge">@ex.Type</span>
                                <span class="badge">@ex.Intensity</span>
                                <span class="muted">
                                    @ex.DurationMinutes min · @ex.CaloriesBurned kcal
                                </span>
                            </div>
                            <button class="btn-link danger"
                                    @onclick="() => DeleteExerciseAsync(ex.Id!)">
                                remove
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        @* 💧 RIGHT: HYDRATION *@
        <div class="card">
            <h3>Hydration Tracker (@selectedDate.ToString("dd MMM yyyy"))</h3>

            @if (hydrationLog != null)
            {
                <div class="hydration-progress">
                    <div class="bar">
                        <div class="fill" style="width:@hydrationPercent%"></div>
                    </div>
                    <p class="small-text">
                        @hydrationLog.TotalMl ml /
                        @hydrationLog.TargetMl ml
                        (@hydrationPercent%)
                    </p>
                </div>
            }
            else
            {
                <p>No water logged yet today.</p>
            }

            <div class="quick-buttons">
                <button class="btn-secondary" @onclick="() => AddWaterAsync(250)">+250 ml</button>
                <button class="btn-secondary" @onclick="() => AddWaterAsync(500)">+500 ml</button>
            </div>

            <div class="form-group mt-3">
                <label>Daily target (ml)</label>
                <input class="form-control" type="number" @bind="targetMl" />
                <button class="btn-primary mt-2"
                        @onclick="UpdateTargetAsync"
                        disabled="@isSavingHydration">
                    @(isSavingHydration ? "Saving..." : "Update target")
                </button>
            </div>
        </div>
    </div>

    @* ✅ NEW: Workout routines modal *@
    @if (showWorkoutModal)
    {
        <div style="position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999;" @onclick="CloseWorkoutModal">
            <div style="background:#fff; max-width:850px; margin:6% auto; padding:16px; border-radius:12px;"
                 @onclick:stopPropagation="true">

                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <h3 style="margin:0;">Workout Routines</h3>
                    <button class="btn-secondary" @onclick="CloseWorkoutModal">Close</button>
                </div>

                @if (workoutLoading)
                {
                    <p class="mt-2">Loading routines...</p>
                }
                else if (!string.IsNullOrEmpty(workoutError))
                {
                    <div class="alert alert-danger mt-2">@workoutError</div>
                }
                else if (workoutRoutines.Count == 0)
                {
                    <p class="mt-2 muted">No routines added by admin yet.</p>
                }
                else
                {
                    <div class="row mt-2">
                        <div class="col-md-5">
                            <p class="small-text">Select a routine:</p>
                            <div class="list-group" style="max-height:360px; overflow:auto;">
                                @foreach (var r in workoutRoutines)
                                {
                                    <button class="list-group-item list-group-item-action @(selectedRoutine?.Id == r.Id ? "active" : "")"
                                            @onclick="() => SelectRoutine(r)">
                                        <div style="display:flex;flex-direction:column;">
                                            <strong>@r.Name</strong>
                                            <span class="small-text">@r.Level · @r.Goal</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="col-md-7">
                            @if (selectedRoutine is null)
                            {
                                <p class="muted mt-4">Choose a routine to view details.</p>
                            }
                            else
                            {
                                <h4 class="mt-1">@selectedRoutine.Name</h4>
                                <p class="small-text">
                                    <b>Level:</b> @selectedRoutine.Level ·
                                    <b>Goal:</b> @selectedRoutine.Goal
                                </p>

                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Exercise</th>
                                            <th style="width:120px;">Sets</th>
                                            <th style="width:120px;">Reps</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var it in selectedRoutine.Items)
                                        {
                                            <tr>
                                                <td>@it.ExerciseName</td>
                                                <td>@it.Sets</td>
                                                <td>@it.Reps</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                <p class="small-text muted">
                                    Tip: Start light and focus on form. Increase gradually week by week.
                                </p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private Client? currentClient;
    private User? currentUser;

    private bool isLoading = true;
    private bool isSavingExercise;
    private bool isSavingHydration;
    private string? errorMessage;

    private DateTime selectedDate = DateTime.UtcNow.Date;

    private List<Meal> mealsToday = new();
    private List<ExerciseLog> exerciseLogs = new();
    private HydrationLog? hydrationLog;

    // 🔥 Priority-C state
    private MetabolismSummary? metabolism;
    private ExercisePlanResult? exercisePlan;

    private int totalCaloriesEaten  => mealsToday.Sum(m => m.Calories ?? 0);
    private int totalCaloriesBurned => exerciseLogs.Sum(x => x.CaloriesBurned ?? 0);
    private int netCalories         => totalCaloriesEaten - totalCaloriesBurned;

    private int hydrationPercent =>
        hydrationLog == null || hydrationLog.TargetMl <= 0
            ? 0
            : Math.Min(100, hydrationLog.TotalMl * 100 / hydrationLog.TargetMl);

    private int targetMl = 2000;

    private string exerciseSearch = "";
    private List<ExerciseSuggestion> exerciseSuggestions = new();
    private ExerciseSuggestion? selectedSuggestion;
    private int selectedSuggestionIndex = -1;
    private string selectedSuggestionIndexString =>
        selectedSuggestionIndex >= 0 ? selectedSuggestionIndex.ToString() : "";

    private double calculatedCaloriesBurned;
    private string durationText = "30";

    private ExerciseLog exerciseForm = new()
    {
        Type = "Cardio",
        Intensity = "Medium",
        DurationMinutes = 30
    };

    // ✅ NEW: workout routines modal state
    private bool showWorkoutModal = false;
    private bool workoutLoading = false;
    private string workoutError = "";
    private List<WorkoutRoutineDto> workoutRoutines = new();
    private WorkoutRoutineDto? selectedRoutine;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var email = auth.User.FindFirst(ClaimTypes.Email)?.Value
                        ?? auth.User.FindFirst("email")?.Value;

            if (string.IsNullOrWhiteSpace(email))
            {
                errorMessage = "Email not found. Please login again.";
                return;
            }

            currentClient = await CService.GetClientByEmailAsync(email);
            if (currentClient == null || string.IsNullOrWhiteSpace(currentClient.Id))
            {
                errorMessage = "Client profile not found.";
                return;
            }

            currentUser = await UService.GetUserByClientIdAsync(currentClient.Id);

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        mealsToday   = await MealService.GetTodayMealsAsync(currentClient!.Id!) ?? new();
        exerciseLogs = await ExerciseService.GetTodayAsync(currentClient.Id!) ?? new();
        hydrationLog = await HydrationService.GetTodayAsync(currentClient.Id!);

        // ✅ Priority-C
        metabolism = await MetabolismService.GetSummaryAsync(currentClient.Id!);

        // ✅ use your existing frontend-only ExercisePlanService
        if (metabolism != null)
            exercisePlan = await ExercisePlanService.BuildPlanAsync(metabolism);
        else
            exercisePlan = null;

        if (hydrationLog != null)
            targetMl = hydrationLog.TargetMl;
    }

    private async Task SearchExercisesAsync()
    {
        if (string.IsNullOrWhiteSpace(exerciseSearch) || exerciseSearch.Trim().Length < 2)
        {
            exerciseSuggestions.Clear();
            return;
        }

        exerciseSuggestions = await ExerciseService.SearchExercisesAsync(exerciseSearch.Trim()) ?? new();
    }

    private void OnSuggestionChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        if (!int.TryParse(raw, out var idx) || idx < 0 || idx >= exerciseSuggestions.Count)
        {
            selectedSuggestionIndex = -1;
            selectedSuggestion = null;
            exerciseForm.Name = "";
            calculatedCaloriesBurned = 0;
            return;
        }

        selectedSuggestionIndex = idx;
        selectedSuggestion = exerciseSuggestions[idx];
        exerciseForm.Name = selectedSuggestion.Name;

        if (!int.TryParse(durationText?.Trim(), out var mins) || mins <= 0)
        {
            calculatedCaloriesBurned = 0;
            return;
        }

        calculatedCaloriesBurned = selectedSuggestion.CaloriesPerMinute * mins;
    }

    private async Task AddExerciseAsync()
    {
        if (selectedSuggestion == null) return;

        if (!int.TryParse(durationText?.Trim(), out var mins) || mins <= 0)
        {
            errorMessage = "Please enter a valid duration in minutes.";
            return;
        }

        isSavingExercise = true;

        await ExerciseService.AddAsync(new ExerciseLog
        {
            ClientId = currentClient!.Id!,
            Name = exerciseForm.Name,
            Type = exerciseForm.Type,
            Intensity = exerciseForm.Intensity,
            DurationMinutes = mins,
            CaloriesBurned = (int)Math.Round(selectedSuggestion.CaloriesPerMinute * mins),
            Date = selectedDate,
            CreatedAt = DateTime.UtcNow
        });

        await LoadDataAsync();
        isSavingExercise = false;
    }

    private async Task DeleteExerciseAsync(string id)
    {
        await ExerciseService.DeleteAsync(id);
        await LoadDataAsync();
    }

    private async Task AddWaterAsync(int ml)
    {
        await HydrationService.AddWaterAsync(currentClient!.Id!, ml);
        await LoadDataAsync();
    }

    private async Task UpdateTargetAsync()
    {
        isSavingHydration = true;
        await HydrationService.UpdateTargetAsync(currentClient!.Id!, targetMl);
        await LoadDataAsync();
        isSavingHydration = false;
    }

    // ============================================================
    // ✅ NEW: Workout routines integration (admin-added)
    // ============================================================

    private async Task OpenWorkoutRoutinesAsync()
    {
        showWorkoutModal = true;
        workoutError = "";
        selectedRoutine = null;

        // load only once per open to keep it fast
        workoutLoading = true;
        try
        {
            workoutRoutines = await Http.GetFromJsonAsync<List<WorkoutRoutineDto>>("api/Workout/routines") ?? new();
        }
        catch (Exception ex)
        {
            workoutError = "Failed to load workouts: " + ex.Message;
            workoutRoutines = new();
        }
        finally
        {
            workoutLoading = false;
        }
    }

    private void CloseWorkoutModal()
    {
        showWorkoutModal = false;
        selectedRoutine = null;
    }

    private void SelectRoutine(WorkoutRoutineDto r)
    {
        selectedRoutine = r;
    }

    private class WorkoutRoutineItemDto
    {
        public string ExerciseId { get; set; } = "";
        public string ExerciseName { get; set; } = "";
        public int Sets { get; set; }
        public int Reps { get; set; }
    }

    private class WorkoutRoutineDto
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Level { get; set; } = "";
        public string Goal { get; set; } = "";
        public List<WorkoutRoutineItemDto> Items { get; set; } = new();
    }
}
