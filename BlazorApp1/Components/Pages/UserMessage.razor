@page "/usermessages"
@layout UserDashboardLayout

@using BlazorApp1.Components.Layout
@using Model
@using BlazorApp1.Service
@inject MessageClientService MessageService
@inject IDService DoctorService
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="chat-page">
    <h2>💬 Your Conversations</h2>

    @if (isLoading)
    {
        <p>Loading conversations...</p>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <p class="error">Error loading conversations: @loadError</p>
    }
    else if (string.IsNullOrWhiteSpace(currentUserClientId))
    {
        <div class="empty-state">
            <p>Could not detect your User ClientId.</p>
            <p class="hint">Make sure a valid user is logged in, or set <code>localStorage['userId']</code>.</p>
        </div>
    }
    else if (conversations.Count == 0)
    {
        <div class="empty-state">
            <p>No messages yet.</p>
            <button class="start-chat-btn" @onclick="GoToDoctorList">
                Start Chat
            </button>
        </div>
    }
    else
    {
        <div class="conversation-list">
            @foreach (var convo in conversations)
            {
                <div class="conversation-card">
                    <div class="info">
                        <h3>@convo.DoctorName</h3>
                        <p><strong>Doctor ClientId:</strong> @convo.DoctorClientId</p>
                    </div>
                    <button class="open-btn"
                            @onclick="() => OpenChat(convo.DoctorClientId)">
                        Open Chat
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private class ConversationDoctor
    {
        public string DoctorClientId { get; set; } = "";
        public string DoctorName { get; set; } = "";
    }

    private List<ConversationDoctor> conversations = new();
    private string? currentUserClientId;
    private bool isLoading = true;
    private string? loadError;
    private bool _loadedFromJs = false;

    // 👉 JS + API calls must be here, NOT in OnInitializedAsync
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loadedFromJs)
            return;

        _loadedFromJs = true;

        try
        {
            // 🔹 Read userId from localStorage using JS interop
            currentUserClientId = await JS.InvokeAsync<string>("localStorage.getItem", "userId");

            if (!string.IsNullOrWhiteSpace(currentUserClientId))
            {
                // 🔹 Ask API: which doctors this user has talked to
                var doctorIds = await MessageService.GetDoctorsForUserAsync(currentUserClientId);
                var uniqueDoctorIds = new HashSet<string>(doctorIds ?? new List<string>());

                foreach (var docClientId in uniqueDoctorIds)
                {
                    if (string.IsNullOrWhiteSpace(docClientId)) continue;

                    var doc = await DoctorService.GetDoctorByClientIdAsync(docClientId);
                    var name = (doc != null && !string.IsNullOrWhiteSpace(doc.Name))
                        ? doc.Name
                        : "(Unknown Doctor)";

                    conversations.Add(new ConversationDoctor
                    {
                        DoctorClientId = docClientId,
                        DoctorName = name
                    });
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();   // ✅ Force UI refresh after JS + API work
        }
    }

    private void OpenChat(string doctorClientId)
    {
        if (string.IsNullOrWhiteSpace(currentUserClientId))
            return;

        Nav.NavigateTo($"/user-chat/{doctorClientId}/{currentUserClientId}");
    }


    private void GoToDoctorList()
    {
        Nav.NavigateTo("/selectdoctor/chat");
    }
}

<style>
    .chat-page {
        padding: 20px;
    }

    .conversation-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .conversation-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .info h3 {
        margin: 0;
        font-size: 18px;
    }

    .info p {
        margin: 4px 0 0;
        font-size: 13px;
        color: #666;
    }

    .open-btn {
        background: #3b3bbf;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 12px;
        cursor: pointer;
    }

    .open-btn:hover {
        opacity: 0.9;
    }

    .empty-state {
        margin-top: 20px;
        padding: 20px;
        border-radius: 8px;
        background: #f5f6ff;
        text-align: center;
    }

    .start-chat-btn {
        margin-top: 10px;
        background: #27ae60;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        cursor: pointer;
        font-weight: 600;
    }

    .start-chat-btn:hover {
        background: #219150;
    }

    .error {
        color: #b00020;
    }

    .hint {
        font-size: 12px;
        color: #777;
    }
</style>
